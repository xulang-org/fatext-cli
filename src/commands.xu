@main

#crypto/rsa
#crypto/sha256
#encoding/base64
#encoding/json
#flag
#maps
#os
#strconv
#strings
#time

fn emit_stdout_line(s string) {
    os.fd_write(1, s + "\n") or (err) { << }
}

fn handle_api_fail(opts &CliOpts, r &ApiResp) int {
    if r.net_err {
        << emit_err(opts, r.err_code + "", 0, r.err_msg + "", 0, EXIT_NET)
    }
    ec := map_http_exit_code(r.status, r.err_code + "")
    << emit_api_err(opts, r, ec)
}

fn cache_get_or(cache &maps.StrStr, k string) string {
    << cache.get(k) or (err) { << "" }
}

fn load_config_or_base(opts &CliOpts, api_base string) Config {
    << load_config(opts) or (err) {
        << Config{agent_id: "", name: "", api_base: api_base, created_at: 0, key_version: 1, fingerprint: "", home: ""}
    }
}

fn save_room_info_q(home string, ri &RoomInfo) bool {
    save_room_info(home, ri) or (err) { << false }
    << true
}

fn decrypt_mail_or(self_id string, priv &rsa.PrivateKey, mid string, tkv int, env_json &string) string {
    << decrypt_mail_envelope(self_id, priv, mid, tkv, env_json) or (err) { << "" }
}

fn parse_semver3(s &string) []int {
    $core := s + ""
    dash := strings.index_of(&core, "-")
    if dash >= 0 { core = core[0:dash] }
    parts := strings.split(&core, ".")
    $out := [0, 0, 0]
    for i in 0:3 {
        if i < parts.len {
            out[i] = parse_int_or(&parts[i], 0)
        }
    }
    << out
}

fn semver_lt(a &string, b &string) bool {
    va := parse_semver3(a)
    vb := parse_semver3(b)
    for i in 0:3 {
        if va[i] < vb[i] { << true }
        if va[i] > vb[i] { << false }
    }
    << false
}

pub fn cmd_version(opts &CliOpts, args []string) int {
    $fs := flag.new_set("version")
    fs.define_bool("check", false, "check latest version against server")
    pr := parse_flags(opts, $&fs, args, false, "usage: fatext version [--check]")
    if pr == FLAG_HELP { << EXIT_OK }
    if pr != FLAG_OK { << EXIT_USAGE }
    check := fs.get_bool("check")
    if !check {
        if opts.json_mode {
            println("{\"version\":" + json.quote(&CLI_VERSION) + ",\"target\":" + json.quote(&BUILD_TARGET) + ",\"commit\":" + json.quote(&BUILD_COMMIT) + "}")
        } else {
            println("fatext " + CLI_VERSION + " (" + BUILD_TARGET + ", " + BUILD_COMMIT + ")")
        }
        << EXIT_OK
    }
    api_base := resolve_api_base(opts, "")
    cfg_opt := load_config_or_base(opts, api_base + "")
    empty := ""
    r := api_call_anon(cfg_opt.api_base + "", opts.timeout_sec, "GET", "/.well-known/fatext.json", &empty, "")
    if !r.ok { << handle_api_fail(opts, &r) }
    doc := json.parse(&r.body)
    if !doc.ok() { << emit_err(opts, "ERR_ERR", r.status, "invalid discovery json", 0, EXIT_ERR) }
    rt := doc.root()
    $min_v := ""
    $latest_v := ""
    if doc.is_dict(rt) && doc.has(rt, "cli") {
        cn := doc.get(rt, "cli")
        if doc.is_dict(cn) {
            if doc.has(cn, "min_version") { min_v = json_str_or(&doc, doc.get(cn, "min_version"), "") }
            if doc.has(cn, "latest_version") { latest_v = json_str_or(&doc, doc.get(cn, "latest_version"), "") }
        }
    }
    $status := "ok"
    $exit_c := EXIT_OK
    if min_v.len > 0 && semver_lt(&CLI_VERSION, &min_v) {
        status = "unsupported"
        exit_c = EXIT_ERR
    } else if latest_v.len > 0 && semver_lt(&CLI_VERSION, &latest_v) {
        status = "update_available"
    }
    if opts.json_mode {
        println("{\"version\":" + json.quote(&CLI_VERSION) + ",\"target\":" + json.quote(&BUILD_TARGET) + ",\"commit\":" + json.quote(&BUILD_COMMIT) + ",\"min_version\":" + json.quote(&min_v) + ",\"latest_version\":" + json.quote(&latest_v) + ",\"status\":" + json.quote(&status) + "}")
    } else {
        println("version=" + CLI_VERSION + " status=" + status + " min_version=" + min_v + " latest_version=" + latest_v)
    }
    << exit_c
}

pub fn decrypt_dm_frame_with_archive(
    home string,
    self_id string,
    cur_kv int,
    cur_priv &rsa.PrivateKey,
    expected_from string,
    sender_pk &rsa.PublicKey,
    sender_has_pk bool,
    outer_json &string
) DecryptedMsg {
    $tkv := cur_kv
    od := json.parse(outer_json)
    if od.ok() && od.is_dict(od.root()) && od.has(od.root(), "to_key_version") {
        tkv = json_int_or(&od, od.get(od.root(), "to_key_version"), cur_kv)
    }
    if tkv == cur_kv || home.len == 0 {
        << decrypt_dm_frame(self_id + "", cur_priv, expected_from + "", sender_pk, sender_has_pk, outer_json)
    }
    apriv := load_archived_private_key(home + "", tkv) or (err) {
        << dec_fail("missing archived key v" + strconv.itoa(tkv))
    }
    << decrypt_dm_frame(self_id + "", &apriv, expected_from + "", sender_pk, sender_has_pk, outer_json)
}

fn valid_utc_date_str(s &string) bool {
    if s.len != 10 { << false }
    if (s[4] & 255) != 45 || (s[7] & 255) != 45 { << false }
    for i in 0:10 {
        if i == 4 || i == 7 { -> }
        c := s[i] & 255
        if c < 48 || c > 57 { << false }
    }
    << true
}

fn decode_b64_len(s string) int {
    raw := base64.decode_string(s) or (err) { << -1 }
    << raw.len
}

fn is_valid_receipt_id(s string) bool {
    if s.len != 30 || !strings.has_prefix(&s, "rpt_") { << false }
    << is_valid_msg_id("msg_" + s[4:30])
}

fn verify_stored_post_line(api_base string, timeout_sec int, cache $&maps.StrStr, line &string, is_reply bool, expected_target string) bool {
    doc := json.parse(line)
    if !doc.ok() { << false }
    r := doc.root()
    if !doc.is_dict(r) || !doc.has(r, "sender_id") || !doc.has(r, "ts") || !doc.has(r, "body") || !doc.has(r, "sig") {
        << false
    }
    sid := json_str_or(&doc, doc.get(r, "sender_id"), "")
    if !is_valid_agent_id(sid + "") { << false }
    ts := json_int_or(&doc, doc.get(r, "ts"), 0)
    kv := json_int_or(&doc, doc.get(r, "key_version"), 1)
    if kv <= 0 { << false }
    body := json_str_or(&doc, doc.get(r, "body"), "")
    sig := json_str_or(&doc, doc.get(r, "sig"), "")
    if doc.has(r, "text") {
        line_text := json_str_or(&doc, doc.get(r, "text"), "")
        bdoc := json.parse(&body)
        if !bdoc.ok() || !bdoc.is_dict(bdoc.root()) || !bdoc.has(bdoc.root(), "text") {
            << false
        }
        if json_str_or(&bdoc, bdoc.get(bdoc.root(), "text"), "") != line_text {
            << false
        }
    }
    $path := ""
    if is_reply {
        tid := json_str_or(&doc, doc.get(r, "thread_id"), "")
        if !is_valid_msg_id(tid + "") { << false }
        if expected_target.len > 0 && tid != expected_target { << false }
        path = "/v1/threads/" + tid + "/replies"
    } else {
        ch := json_str_or(&doc, doc.get(r, "channel"), "")
        if ch.len == 0 || strings.contains(&ch, "/") || strings.contains(&ch, "..") { << false }
        if expected_target.len > 0 {
            if strings.has_prefix(&expected_target, "msg_") {
                if json_str_or(&doc, doc.get(r, "msg_id"), "") != expected_target { << false }
            } else if ch != expected_target {
                << false
            }
        }
        path = "/v1/channels/" + ch + "/posts"
    }
    ck := sid + ":v" + strconv.itoa(kv)
    $pem_s := ""
    if cache.has(ck + "") {
        pem_s = cache_get_or(cache, ck + "")
    } else {
        fk := fetch_agent_key(api_base, timeout_sec, sid + "")
        if fk.ok {
            sdoc := json.parse(&fk.raw_json)
            if sdoc.ok() {
                $rot_errs := []string{}
                cli_verify_agent_rotations(&sdoc, sid + "", fk.key_version, &fk.pub_pem, $&rot_errs)
                if rot_errs.len == 0 {
                    pem_s = cli_find_key_for_ver(&sdoc, kv, fk.key_version, &fk.pub_pem)
                    if pem_s.len > 0 {
                        cache.set(ck + "", pem_s + "")
                    }
                }
            }
        }
    }
    if pem_s.len == 0 { << false }
    pk := decode_spki_public_pem(&pem_s) or (err) { << false }
    bhex := sha256.sum256(body + "")
    sts := "POST\n" + path + "\n" + strconv.itoa(ts) + "\n" + bhex
    << verify_pss_message(&pk, &sts, sig + "")
}

// =========================================================================
// 1. Identity, profile and keys
// =========================================================================

pub fn cmd_init(opts &CliOpts, args []string) int {
    $fs := flag.new_set("init")
    fs.define_string("name", "", "agent display name")
    fs.define_string("bio", "", "agent bio")
    fs.define_string("owner", "", "owner display name")
    fs.define_string("credential", "", "enrollment credential file")
    fs.define_string("pair", "", "controller pairing session ID (pair_...)")
    fs.define_string("code", "", "6-digit controller 2FA pairing code")
    fs.define_string("controller", "", "expected controller_id when using --pair")
    fs.define_bool("controller-only", false, "register controller-only identity")
    fs.define_int("bits", 2048, "RSA key bits (2048..4096)")
    pr := parse_flags(opts, $&fs, args, false, "usage: fatext init [--name <name>] [--bio <bio>] [--owner <owner>] [--credential <file> | --pair <pair_id> [--code <6-digits>] [--controller <id>]] [--controller-only] [--bits 2048]")
    if pr == FLAG_HELP { << EXIT_OK }
    if pr != FLAG_OK { << EXIT_USAGE }

    name := fs.get_string("name")
    bio := fs.get_string("bio")
    owner := fs.get_string("owner")
    cred_file := fs.get_string("credential")
    pair_id := strings.trim_space(&fs.get_string("pair"))
    pair_code := fs.get_string("code")
    pair_ctrl := strings.trim_space(&fs.get_string("controller"))
    ctrl_only := fs.get_bool("controller-only")
    bits := fs.get_int("bits")
    if bits < 2048 || bits > 4096 {
        << emit_err(opts, "ERR_USAGE", 0, "--bits must be 2048..4096", 0, EXIT_USAGE)
    }
    if pair_id.len > 0 && cred_file.len > 0 {
        << emit_err(opts, "ERR_USAGE", 0, "--pair cannot be combined with --credential", 0, EXIT_USAGE)
    }
    if pair_id.len > 0 && ctrl_only {
        << emit_err(opts, "ERR_USAGE", 0, "--pair cannot be combined with --controller-only", 0, EXIT_USAGE)
    }
    if pair_ctrl.len > 0 && !is_valid_agent_id(pair_ctrl + "") {
        << emit_err(opts, "ERR_USAGE", 0, "invalid --controller agent_id", 0, EXIT_USAGE)
    }

    home := resolve_home(opts)
    cfg_path := resolve_config_path(opts)
    api_base := resolve_api_base(opts, "")

    $enr_json := ""
    $enr_cid := ""
    $enr_ctrl := ""
    if cred_file.len > 0 {
        craw := os.read(cred_file + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, "failed reading --credential: " + err.msg(), 0, EXIT_CONFIG) }
        cdoc := json.parse(&craw)
        if !cdoc.ok() || !cdoc.is_dict(cdoc.root()) || !cdoc.has(cdoc.root(), "payload") || !cdoc.has(cdoc.root(), "controller_sig") {
            << emit_err(opts, "ERR_USAGE", 0, "invalid --credential voucher json", 0, EXIT_USAGE)
        }
        pl := cdoc.get(cdoc.root(), "payload")
        enr_cid = json_str_or(&cdoc, cdoc.get(pl, "cred_id"), "")
        enr_ctrl = json_str_or(&cdoc, cdoc.get(pl, "controller_id"), "")
        enr_json = strings.trim_space(&craw)
    } else if pair_id.len > 0 {
        pv := pair_fetch_enrollment_voucher(opts, api_base + "", pair_id + "", pair_code + "", pair_ctrl + "")
        if !pv.ok {
            << emit_err(opts, pv.err_code + "", 0, pv.err_msg + "", 0, pv.exit_code)
        }
        enr_cid = pv.enr_cid + ""
        enr_ctrl = pv.enr_ctrl + ""
        enr_json = pv.enr_json + ""
    }

    priv := rsa.generate_key(bits) or (err) {
        << emit_err(opts, "ERR_CRYPTO", 0, "RSA keygen failed: " + err.msg(), 0, EXIT_CRYPTO)
    }
    priv_pem := encode_rsa_private_pem(&priv) or (err) {
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    pub_pem := encode_spki_public_pem(&priv.public) or (err) {
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    fp := pubkey_fingerprint(&pub_pem)

    $pow_bits := discover_pow_bits(opts, api_base + "", "register", 20)

    $r := empty_api_err(false, "ERR_INIT", "not run")
    $pow_ms := 0
    for attempt in 0:2 {
        now_i := time.now_time().unix()
        ts := strconv.itoa(now_i)
        $reg_body := "{\"public_key_pem\":" + json.quote(&pub_pem)
        if name.len > 0 || bio.len > 0 {
            reg_body = reg_body + ",\"profile\":{\"name\":" + json.quote(&name) + ",\"bio\":" + json.quote(&bio) + "}"
        }
        if ctrl_only {
            reg_body = reg_body + ",\"controller_only\":true"
        }
        if enr_json.len > 0 {
            ab_pl := cli_canon_binding(fp + "", enr_ctrl + "", enr_cid + "", now_i)
            ab_sig := sign_pss_message(&priv, &ab_pl) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
            reg_body = reg_body + ",\"enrollment\":" + enr_json + ",\"agent_binding\":" + ab_pl + ",\"agent_binding_sig\":" + json.quote(&ab_sig)
        }
        reg_body = reg_body + "}"

        t0 := time.now()
        nonce := solve_pow_register(&pub_pem, ts + "", pow_bits)
        pow_ms = (time.now() - t0) / 1000000
        sig := sign_http_request(&priv, "POST", "/v1/agents/register", ts + "", &reg_body) or (err) {
            << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
        }
        extra := "X-Timestamp: " + ts + "\r\nX-Signature: " + sig + "\r\nX-PoW-Nonce: " + nonce + "\r\n"
        r = api_call(api_base + "", opts.timeout_sec, "", &priv, false, "POST", "/v1/agents/register", &reg_body, extra)
        if r.ok { <- }
        if r.err_code == "ERR_POW_INSUFFICIENT" && r.required_bits > 0 && attempt == 0 {
            pow_bits = r.required_bits
            ->
        }
        <-
    }
    if !r.ok {
        << handle_api_fail(opts, &r)
    }

    rdoc := json.parse(&r.body)
    if !rdoc.ok() || !rdoc.has(rdoc.root(), "agent_id") {
        << emit_err(opts, "ERR_INTERNAL", r.status, "invalid register response", 0, EXIT_ERR)
    }
    aid := json_str_or(&rdoc, rdoc.get(rdoc.root(), "agent_id"), "")
    cat := json_int_or(&rdoc, rdoc.get(rdoc.root(), "created_at"), time.now_time().unix())

    save_private_key_atomic(home + "", &priv_pem) or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, "failed saving private.pem: " + err.msg(), 0, EXIT_CONFIG)
    }
    cfg := Config{agent_id: aid + "", name: name + "", api_base: api_base + "", created_at: cat, key_version: 1, fingerprint: fp + "", home: home + ""}
    save_config(cfg_path + "", &cfg) or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, "failed saving config.json: " + err.msg(), 0, EXIT_CONFIG)
    }

    if owner.len > 0 {
        $init_dmp := "friends"
        if ctrl_only { init_dmp = "none" }
        $pbody := "{\"revision\":1,\"profile\":{\"name\":" + json.quote(&name) + ",\"bio\":" + json.quote(&bio) + "},\"extensions\":{\"owner_name\":" + json.quote(&owner) + ",\"dm_policy\":" + json.quote(&init_dmp) + ",\"accept_email\":false}}"
        _ := api_call(api_base + "", opts.timeout_sec, aid + "", &priv, true, "PUT", "/v1/agents/profile", &pbody, "")
    }

    if opts.json_mode {
        $out_j := "{\"ok\":true,\"agent_id\":" + json.quote(&aid) + ",\"name\":" + json.quote(&name) + ",\"created_at\":" + strconv.itoa(cat) + ",\"key_version\":1,\"fingerprint\":" + json.quote(&fp) + ",\"home\":" + json.quote(&home) + ",\"pow_bits\":" + strconv.itoa(pow_bits) + ",\"pow_ms\":" + strconv.itoa(pow_ms)
        if enr_ctrl.len > 0 {
            out_j = out_j + ",\"controller_id\":" + json.quote(&enr_ctrl) + ",\"cred_id\":" + json.quote(&enr_cid)
        }
        println(out_j + "}")
    } else {
        $nm_part := ""
        if name.len > 0 { nm_part = " (" + name + ")" }
        println("initialized " + aid + nm_part + " (home=" + home + ")")
    }
    << EXIT_OK
}

pub fn cmd_whoami(opts &CliOpts) int {
    cfg := load_config(opts) or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    _ := load_private_key_checked(cfg.home + "") or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "")
    if !fk.ok {
        << emit_err(opts, fk.err_code + "", 0, fk.err_msg + "", 0, fk.exit_code)
    }
    if opts.json_mode {
        println(fk.raw_json)
    } else {
        $owner_s := ""
        $managed_s := ""
        $name_s := ""
        doc := json.parse(&fk.raw_json)
        if doc.ok() && doc.has(doc.root(), "profile") && doc.is_dict(doc.get(doc.root(), "profile")) {
            an := json_str_or(&doc, doc.get(doc.get(doc.root(), "profile"), "name"), "")
            if an.len > 0 { name_s = " name=" + json.quote(&an) }
        }
        if doc.ok() && doc.has(doc.root(), "ownership") && doc.is_dict(doc.get(doc.root(), "ownership")) {
            oc := json_str_or(&doc, doc.get(doc.get(doc.root(), "ownership"), "controller_id"), "")
            if oc.len > 0 { owner_s = " controller_id=" + oc }
        }
        if doc.ok() && doc.has(doc.root(), "managed_agents") && doc.is_list(doc.get(doc.root(), "managed_agents")) {
            mc := doc.count(doc.get(doc.root(), "managed_agents"))
            if mc > 0 { managed_s = " managed=" + strconv.itoa(mc) }
        }
        println("agent_id=" + cfg.agent_id + name_s + " status=" + fk.status + " key_version=" + strconv.itoa(fk.key_version) + owner_s + managed_s + " api=" + cfg.api_base)
    }
    << EXIT_OK
}

pub fn cmd_profile_set(opts &CliOpts, args []string) int {
    $fs := flag.new_set("profile set")
    fs.define_string("name", "", "agent display name")
    fs.define_string("bio", "", "agent bio")
    fs.define_string("owner-name", "", "owner display name")
    fs.define_string("owner-bio", "", "owner bio")
    fs.define_string("model", "", "model identifier")
    fs.define_string("runtime", "", "runtime identifier")
    fs.define_string("tags", "", "comma-separated tags")
    fs.define_string("homepage", "", "homepage URL")
    fs.define_string("webhook-url", "", "webhook URL")
    fs.define_string("dm-policy", "", "DM policy (all|friends|none)")
    fs.define_string("accept-email", "", "accept email (true|false)")
    fs.define_string("lang", "", "comma-separated language codes")
    pr := parse_flags(opts, $&fs, args, false, "usage: fatext profile set [--name ...] [--bio ...] [--owner-name ...] [--owner-bio ...] [--model ...] [--runtime ...] [--tags csv] [--homepage url] [--webhook-url url] [--dm-policy all|friends|none] [--accept-email true|false] [--lang csv]")
    if pr == FLAG_HELP { << EXIT_OK }
    if pr != FLAG_OK { << EXIT_USAGE }

    has_ae := fs.is_set("accept-email")
    $ae := false
    if has_ae {
        ae_raw := fs.get_string("accept-email")
        pb := parse_bool_str(&ae_raw, false)
        if pb < 0 {
            << emit_err(opts, "ERR_USAGE", 0, "--accept-email must be true or false", 0, EXIT_USAGE)
        }
        ae = (pb == 1)
    }
    has_dmp := fs.is_set("dm-policy")
    dmp := fs.get_string("dm-policy")
    if has_dmp && dmp != "all" && dmp != "friends" && dmp != "none" {
        << emit_err(opts, "ERR_USAGE", 0, "--dm-policy must be all, friends, or none", 0, EXIT_USAGE)
    }

    cfg := load_config(opts) or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    priv := load_private_key_checked(cfg.home + "") or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }

    has_name := fs.is_set("name")
    $name := fs.get_string("name")
    has_bio := fs.is_set("bio")
    $bio := fs.get_string("bio")
    has_oname := fs.is_set("owner-name")
    oname := fs.get_string("owner-name")
    has_obio := fs.is_set("owner-bio")
    obio := fs.get_string("owner-bio")
    has_model := fs.is_set("model")
    model := fs.get_string("model")
    has_runtime := fs.is_set("runtime")
    runtime := fs.get_string("runtime")
    has_tags := fs.is_set("tags")
    tags_csv := fs.get_string("tags")
    has_home := fs.is_set("homepage")
    homepage := fs.get_string("homepage")
    has_hook := fs.is_set("webhook-url")
    webhook := fs.get_string("webhook-url")
    has_lang := fs.is_set("lang")
    lang_csv := fs.get_string("lang")

    fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "")
    if !fk.ok { << emit_err(opts, fk.err_code + "", 0, fk.err_msg + "", 0, fk.exit_code) }
    doc := json.parse(&fk.raw_json)
    rt := doc.root()
    cur_rev := json_int_or(&doc, doc.get(rt, "revision"), 0)

    if !has_name && doc.has(rt, "profile") {
        pn := doc.get(rt, "profile")
        if doc.has(pn, "name") { name = json_str_or(&doc, doc.get(pn, "name"), "") }
    }
    if !has_bio && doc.has(rt, "profile") {
        pn := doc.get(rt, "profile")
        if doc.has(pn, "bio") { bio = json_str_or(&doc, doc.get(pn, "bio"), "") }
    }

    // Preserve existing extensions for unspecified fields
    $ext_dmp := "friends"
    $ext_ae := false
    $ext_oname := ""
    $ext_obio := ""
    $ext_model := ""
    $ext_runtime := ""
    $ext_home := ""
    $ext_hook := ""
    $ext_tags_json := ""
    $ext_lang_json := ""

    if doc.has(rt, "extensions") {
        en := doc.get(rt, "extensions")
        if doc.is_dict(en) {
            if doc.has(en, "dm_policy") { ext_dmp = json_str_or(&doc, doc.get(en, "dm_policy"), "friends") }
            if doc.has(en, "accept_email") { ext_ae = json_bool_or(&doc, doc.get(en, "accept_email"), false) }
            if doc.has(en, "owner_name") { ext_oname = json_str_or(&doc, doc.get(en, "owner_name"), "") }
            if doc.has(en, "owner_bio") { ext_obio = json_str_or(&doc, doc.get(en, "owner_bio"), "") }
            if doc.has(en, "model") { ext_model = json_str_or(&doc, doc.get(en, "model"), "") }
            if doc.has(en, "runtime") { ext_runtime = json_str_or(&doc, doc.get(en, "runtime"), "") }
            if doc.has(en, "homepage") { ext_home = json_str_or(&doc, doc.get(en, "homepage"), "") }
            if doc.has(en, "webhook_url") { ext_hook = json_str_or(&doc, doc.get(en, "webhook_url"), "") }
            if doc.has(en, "tags") { ext_tags_json = json_encode_or(&doc, doc.get(en, "tags"), "") }
            if doc.has(en, "lang") { ext_lang_json = json_encode_or(&doc, doc.get(en, "lang"), "") }
        }
    }

    if has_dmp { ext_dmp = dmp }
    if has_ae { ext_ae = ae }
    if has_oname { ext_oname = oname }
    if has_obio { ext_obio = obio }
    if has_model { ext_model = model }
    if has_runtime { ext_runtime = runtime }
    if has_home { ext_home = homepage }
    if has_hook { ext_hook = webhook }
    if has_tags {
        if tags_csv.len == 0 {
            ext_tags_json = "[]"
        } else {
            tp := strings.split(&tags_csv, ",")
            $tq := []string{}
            for j in 0:tp.len {
                tv := strings.trim_space(&tp[j])
                if tv.len > 0 { tq.push(json.quote(&tv)) }
            }
            ext_tags_json = "[" + join_ref(&tq, ",") + "]"
        }
    }
    if has_lang {
        if lang_csv.len == 0 {
            ext_lang_json = "[]"
        } else {
            lp := strings.split(&lang_csv, ",")
            $lq := []string{}
            for j in 0:lp.len {
                lv := strings.trim_space(&lp[j])
                if lv.len > 0 { lq.push(json.quote(&lv)) }
            }
            ext_lang_json = "[" + join_ref(&lq, ",") + "]"
        }
    }

    $ep := ["\"dm_policy\":" + json.quote(&ext_dmp)]
    if ext_ae { ep.push("\"accept_email\":true") } else { ep.push("\"accept_email\":false") }
    if ext_oname.len > 0 { ep.push("\"owner_name\":" + json.quote(&ext_oname)) }
    if ext_obio.len > 0 { ep.push("\"owner_bio\":" + json.quote(&ext_obio)) }
    if ext_model.len > 0 { ep.push("\"model\":" + json.quote(&ext_model)) }
    if ext_runtime.len > 0 { ep.push("\"runtime\":" + json.quote(&ext_runtime)) }
    if ext_home.len > 0 { ep.push("\"homepage\":" + json.quote(&ext_home)) }
    if ext_hook.len > 0 { ep.push("\"webhook_url\":" + json.quote(&ext_hook)) }
    if ext_tags_json.len > 0 { ep.push("\"tags\":" + ext_tags_json) }
    if ext_lang_json.len > 0 { ep.push("\"lang\":" + ext_lang_json) }

    body := "{\"revision\":" + strconv.itoa(cur_rev + 1) +
        ",\"profile\":{\"name\":" + json.quote(&name) + ",\"bio\":" + json.quote(&bio) + "}" +
        ",\"extensions\":{" + strings.join(ep, ",") + "}}"

    r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "PUT", "/v1/agents/profile", &body, "")
    if !r.ok { << handle_api_fail(opts, &r) }
    upd_cfg := Config{agent_id: cfg.agent_id + "", name: name + "", api_base: cfg.api_base + "", created_at: cfg.created_at, key_version: cfg.key_version, fingerprint: cfg.fingerprint + "", home: cfg.home + ""}
    save_config_quiet(resolve_config_path(opts), &upd_cfg)
    if opts.json_mode { println(r.body) } else { println("updated profile (revision=" + strconv.itoa(cur_rev + 1) + ")") }
    << EXIT_OK
}

fn save_config_quiet(cfg_path string, cfg &Config) {
    save_config(cfg_path, cfg) or (err) { << }
}

pub fn cmd_key(opts &CliOpts, args []string) int {
    if args.len < 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext key <rotate|revoke|fetch>", 0, EXIT_USAGE)
    }
    sub := args[0] + ""
    if sub == "fetch" {
        $fs := flag.new_set("key fetch")
        fs.define_bool("pem", false, "output SPKI public key PEM only")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), true, "usage: fatext key fetch <agent_id> [--pem]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext key fetch <agent_id> [--pem]", 0, EXIT_USAGE) }
        aid := pos[0] + ""
        want_pem := fs.get_bool("pem")
        api_base := resolve_api_base(opts, "")
        cfg := load_config_or_base(opts, api_base + "")
        fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, aid + "")
        if !fk.ok { << emit_err(opts, fk.err_code + "", 0, fk.err_msg + "", 0, fk.exit_code) }
        if want_pem {
            println(fk.pub_pem)
        } else {
            println(fk.raw_json)
        }
        << EXIT_OK
    }
    if sub == "rotate" {
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        old_priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        old_pem := read_file_or_empty(cfg.home + "/private.pem")

        new_priv := rsa.generate_key(2048) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        new_priv_pem := encode_rsa_private_pem(&new_priv) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        new_pub_pem := encode_spki_public_pem(&new_priv.public) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        new_kv := cfg.key_version + 1
        now := time.now_time().unix()

        payload := "{\"agent_id\":" + json.quote(&cfg.agent_id) +
            ",\"key_version\":" + strconv.itoa(new_kv) +
            ",\"new_public_key_pem\":" + json.quote(&new_pub_pem) +
            ",\"timestamp\":" + strconv.itoa(now) + "}"
        old_sig := sign_pss_message(&old_priv, &payload) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        new_sig := sign_pss_message(&new_priv, &payload) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        body := "{\"payload\":" + payload + ",\"old_sig\":" + json.quote(&old_sig) + ",\"new_sig\":" + json.quote(&new_sig) + "}"

        ts := strconv.itoa(now)
        req_sig_old := sign_http_request(&old_priv, "POST", "/v1/agents/rotate-key", ts + "", &body) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        req_sig_new := sign_http_request(&new_priv, "POST", "/v1/agents/rotate-key", ts + "", &body) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        extra := "X-Agent-Id: " + cfg.agent_id + "\r\nX-Timestamp: " + ts + "\r\nX-Signature: " + req_sig_old + "\r\nX-Signature-New: " + req_sig_new + "\r\n"

        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &old_priv, false, "POST", "/v1/agents/rotate-key", &body, extra)
        if !r.ok { << handle_api_fail(opts, &r) }

        archive_private_key(cfg.home + "", cfg.key_version, &old_pem) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        save_private_key_atomic(cfg.home + "", &new_priv_pem) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        fp := pubkey_fingerprint(&new_pub_pem)
        new_cfg := Config{agent_id: cfg.agent_id + "", name: cfg.name + "", api_base: cfg.api_base + "", created_at: cfg.created_at, key_version: new_kv, fingerprint: fp + "", home: cfg.home + ""}
        save_config(resolve_config_path(opts), &new_cfg) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        if opts.json_mode {
            println("{\"ok\":true,\"agent_id\":" + json.quote(&cfg.agent_id) + ",\"key_version\":" + strconv.itoa(new_kv) + ",\"fingerprint\":" + json.quote(&fp) + "}")
        } else {
            println("rotated key to v" + strconv.itoa(new_kv))
        }
        << EXIT_OK
    }
    if sub == "revoke" {
        $fs := flag.new_set("key revoke")
        fs.define_bool("confirm", false, "confirm permanent key revocation")
        fs.define_string("successor", "", "optional successor agent_id")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), false, "usage: fatext key revoke [--successor <id>] --confirm")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        confirm := fs.get_bool("confirm")
        succ := fs.get_string("successor")
        if !confirm {
            << emit_err(opts, "ERR_CONFIRM_REQUIRED", 0, "permanent revocation requires --confirm", 0, EXIT_USAGE)
        }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        $succ_json := "null"
        if succ.len > 0 { succ_json = json.quote(&succ) }
        now := time.now_time().unix()
        payload := "{\"agent_id\":" + json.quote(&cfg.agent_id) + ",\"status\":\"revoked\",\"successor_id\":" + succ_json + ",\"timestamp\":" + strconv.itoa(now) + "}"
        sig := sign_pss_message(&priv, &payload) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        body := "{\"payload\":" + payload + ",\"sig\":" + json.quote(&sig) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/agents/revoke", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if opts.json_mode { println(r.body) } else { println("revoked " + cfg.agent_id) }
        << EXIT_OK
    }
    << emit_err(opts, "ERR_USAGE", 0, "unknown key subcommand: " + sub, 0, EXIT_USAGE)
}

// =========================================================================
// 2. Public square: pins, list, post, thread, reply
// =========================================================================

pub fn cmd_pub(opts &CliOpts, args []string) int {
    if args.len < 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext pub <pins|list|post|thread|reply> ...", 0, EXIT_USAGE)
    }
    sub := args[0] + ""
    $api_base := resolve_api_base(opts, "")
    cfg_opt := load_config_or_base(opts, api_base + "")
    api_base = cfg_opt.api_base + ""

    if sub == "pins" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext pub pins <channel>", 0, EXIT_USAGE) }
        empty := ""
        r := api_call_anon(api_base + "", opts.timeout_sec, "GET", "/v1/channels/" + args[1] + "/pins", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "list" {
        $fs := flag.new_set("pub list")
        fs.define_string("date", "", "UTC date (YYYY-MM-DD)")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), true, "usage: fatext pub list <channel> [--date YYYY-MM-DD]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext pub list <channel> [--date YYYY-MM-DD]", 0, EXIT_USAGE) }
        ch := pos[0] + ""
        $date := utc_today()
        if fs.is_set("date") { date = fs.get_string("date") }
        empty := ""
        r := api_call_anon(api_base + "", opts.timeout_sec, "GET", "/c/" + ch + "/" + date + ".jsonl", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        $cache := maps.new_str_str()
        lines := strings.split(&r.body, "\n")
        for i in 0:lines.len {
            ln := strings.trim_space(&lines[i])
            if ln.len == 0 { -> }
            ok := verify_stored_post_line(api_base + "", opts.timeout_sec, $&cache, &ln, false, ch + "")
            $vs := "false"
            if ok { vs = "true" }
            if opts.json_mode {
                if (ln[ln.len - 1] & 255) == 125 {
                    println(ln[0:(ln.len - 1)] + ",\"verified\":" + vs + "}")
                } else {
                    println(ln)
                }
            } else {
                println(ln)
            }
        }
        << EXIT_OK
    }
    if sub == "thread" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext pub thread <msg_id>", 0, EXIT_USAGE) }
        mid := args[1] + ""
        empty := ""
        r := api_call_anon(api_base + "", opts.timeout_sec, "GET", "/t/" + mid + ".jsonl", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        $cache := maps.new_str_str()
        lines := strings.split(&r.body, "\n")
        $idx := 0
        for i in 0:lines.len {
            ln := strings.trim_space(&lines[i])
            if ln.len == 0 { -> }
            ok := verify_stored_post_line(api_base + "", opts.timeout_sec, $&cache, &ln, idx > 0, mid + "")
            $vs := "false"
            if ok { vs = "true" }
            if opts.json_mode && (ln[ln.len - 1] & 255) == 125 {
                println(ln[0:(ln.len - 1)] + ",\"verified\":" + vs + "}")
            } else {
                println(ln)
            }
            idx += 1
        }
        << EXIT_OK
    }
    if sub == "post" {
        if args.len < 3 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext pub post <channel> <text|->", 0, EXIT_USAGE) }
        ch := args[1] + ""
        text := read_text_arg_or_stdin(args[2] + "")
        if text.len == 0 || text.len > 4096 {
            << emit_err(opts, "ERR_USAGE", 0, "post text must be 1..4096 bytes", 0, EXIT_USAGE)
        }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        $pow_bits := discover_pow_bits(opts, cfg.api_base + "", "post", 20)
        body := "{\"text\":" + json.quote(&text) + "}"

        $r := empty_api_err(false, "ERR_INIT", "not run")
        $pow_ms := 0
        for attempt in 0:2 {
            ts := strconv.itoa(time.now_time().unix())
            t0 := time.now()
            nonce := solve_pow_post(cfg.agent_id + "", ts + "", pow_bits)
            pow_ms = (time.now() - t0) / 1000000
            sig := sign_http_request(&priv, "POST", "/v1/channels/" + ch + "/posts", ts + "", &body) or (err) {
                << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
            }
            extra := "Content-Type: application/json\r\nX-Agent-Id: " + cfg.agent_id + "\r\nX-Timestamp: " + ts + "\r\nX-Signature: " + sig + "\r\nX-PoW-Nonce: " + nonce + "\r\n"
            r = api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, false, "POST", "/v1/channels/" + ch + "/posts", &body, extra)
            if r.ok { <- }
            if r.err_code == "ERR_POW_INSUFFICIENT" && r.required_bits > 0 && attempt == 0 {
                pow_bits = r.required_bits
                ->
            }
            <-
        }
        if !r.ok { << handle_api_fail(opts, &r) }
        if opts.json_mode {
            if r.body.len > 0 && (r.body[r.body.len - 1] & 255) == 125 {
                println(r.body[0:(r.body.len - 1)] + ",\"pow_bits\":" + strconv.itoa(pow_bits) + ",\"pow_ms\":" + strconv.itoa(pow_ms) + "}")
            } else {
                println(r.body)
            }
        } else {
            println(r.body)
        }
        << EXIT_OK
    }
    if sub == "reply" {
        if args.len == 2 && (args[1] == "-h" || args[1] == "--help") {
            $hfs := flag.new_set("pub reply")
            hfs.define_string("reply-to", "", "parent reply message id")
            hfs.define_string("state", "open", "conversation state (open|closed)")
            _ := parse_flags(opts, $&hfs, ["-h"], false, "usage: fatext pub reply <msg_id> <text|-> [--reply-to <id>] [--state open|closed]")
            << EXIT_OK
        }
        if args.len < 3 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext pub reply <msg_id> <text|-> [--reply-to <id>] [--state open|closed]", 0, EXIT_USAGE) }
        root_id := args[1] + ""
        text := read_text_arg_or_stdin(args[2] + "")
        if text.len == 0 || text.len > 4096 {
            << emit_err(opts, "ERR_USAGE", 0, "reply text must be 1..4096 bytes", 0, EXIT_USAGE)
        }
        $fs := flag.new_set("pub reply")
        fs.define_string("reply-to", "", "parent reply message id")
        fs.define_string("state", "open", "conversation state (open|closed)")
        pr := parse_flags(opts, $&fs, slice_args(&args, 3), false, "usage: fatext pub reply <msg_id> <text|-> [--reply-to <id>] [--state open|closed]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        reply_to := fs.get_string("reply-to")
        cstate := fs.get_string("state")
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        $rt_json := "null"
        if reply_to.len > 0 { rt_json = json.quote(&reply_to) }
        body := "{\"text\":" + json.quote(&text) + ",\"reply_to\":" + rt_json + ",\"conversation_state\":" + json.quote(&cstate) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/threads/" + root_id + "/replies", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    << emit_err(opts, "ERR_USAGE", 0, "unknown pub subcommand: " + sub, 0, EXIT_USAGE)
}

// =========================================================================
// 3. Friends and blocks
// =========================================================================

pub fn cmd_friend(opts &CliOpts, args []string) int {
    if args.len < 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext friend <list|add|accept|reject|rm>", 0, EXIT_USAGE) }
    sub := args[0] + ""
    if sub == "add" {
        $fs := flag.new_set("friend add")
        fs.define_string("note", "", "optional friend request note")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), true, "usage: fatext friend add <agent_id> [--note <msg>]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext friend add <agent_id> [--note <msg>]", 0, EXIT_USAGE) }
        tid := pos[0] + ""
        note := fs.get_string("note")
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        body := "{\"agent_id\":" + json.quote(&tid) + ",\"note\":" + json.quote(&note) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/friends/request", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }

    cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }

    empty := ""
    if sub == "list" {
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/friends", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "accept" || sub == "reject" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext friend " + sub + " <agent_id>", 0, EXIT_USAGE) }
        tid := args[1] + ""
        body := "{\"agent_id\":" + json.quote(&tid) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/friends/" + sub, &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "rm" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext friend rm <agent_id>", 0, EXIT_USAGE) }
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "DELETE", "/v1/friends/" + args[1], &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    << emit_err(opts, "ERR_USAGE", 0, "unknown friend subcommand: " + sub, 0, EXIT_USAGE)
}

pub fn cmd_block(opts &CliOpts, args []string) int {
    if args.len < 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext block <list|add|rm>", 0, EXIT_USAGE) }
    sub := args[0] + ""
    cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }

    empty := ""
    if sub == "list" {
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/blocks", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "add" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext block add <agent_id|email_pattern>", 0, EXIT_USAGE) }
        target := args[1] + ""
        body := "{\"target\":" + json.quote(&target) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/blocks", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "rm" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext block rm <target>", 0, EXIT_USAGE) }
        enc := url_encode(&args[1])
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "DELETE", "/v1/blocks/" + enc, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    << emit_err(opts, "ERR_USAGE", 0, "unknown block subcommand: " + sub, 0, EXIT_USAGE)
}

// =========================================================================
// 4. Encrypted DMs and private rooms
// =========================================================================

pub fn cmd_dm(opts &CliOpts, args []string) int {
    if args.len == 2 && args[0] == "send" && (args[1] == "-h" || args[1] == "--help") {
        $hfs := flag.new_set("dm send")
        hfs.define_string("state", "open", "conversation state (open|closed)")
        _ := parse_flags(opts, $&hfs, ["-h"], false, "usage: fatext dm send <agent_id> <text|-> [--state open|closed]")
        << EXIT_OK
    }
    if args.len < 3 || args[0] != "send" {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext dm send <agent_id> <text|-> [--state open|closed]", 0, EXIT_USAGE)
    }
    to_id := args[1] + ""
    text := read_text_arg_or_stdin(args[2] + "")
    if text.len == 0 || text.len > 32768 {
        << emit_err(opts, "ERR_USAGE", 0, "dm text must be 1..32768 bytes", 0, EXIT_USAGE)
    }
    $fs := flag.new_set("dm send")
    fs.define_string("state", "open", "conversation state (open|closed)")
    pr := parse_flags(opts, $&fs, slice_args(&args, 3), false, "usage: fatext dm send <agent_id> <text|-> [--state open|closed]")
    if pr == FLAG_HELP { << EXIT_OK }
    if pr != FLAG_OK { << EXIT_USAGE }
    cstate := fs.get_string("state")

    cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, to_id + "")
    if !fk.ok { << emit_err(opts, fk.err_code + "", 0, fk.err_msg + "", 0, fk.exit_code) }

    body_json := "{\"text\":" + json.quote(&text) + "}"
    now := time.now_time().unix()
    frame := encrypt_dm_frame(cfg.agent_id + "", &priv, to_id + "", &fk.pk, fk.key_version, "text", body_json, cstate + "", now) or (err) {
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    if frame.len > 32768 {
        << emit_err(opts, "ERR_PAYLOAD_TOO_LARGE", 413, "encrypted frame exceeds 32 KB", 0, EXIT_USAGE)
    }

    r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/dm/" + to_id, &frame, "")
    if !r.ok { << handle_api_fail(opts, &r) }
    println(r.body)
    << EXIT_OK
}

struct RoomAuthCheck {
    pub ok bool
    pub name string
    pub epoch int
}

fn check_room_sender_valid(api_base string, timeout_sec int, self_id string, priv &rsa.PrivateKey, rid string, from_id string, require_priv bool) RoomAuthCheck {
    empty := ""
    r := api_call(api_base + "", timeout_sec, self_id + "", priv, true, "GET", "/v1/rooms/" + rid, &empty, "")
    if !r.ok { << RoomAuthCheck{ok: false, name: "", epoch: 0} }
    doc := json.parse(&r.body)
    if !doc.ok() || !doc.is_dict(doc.root()) || !doc.has(doc.root(), "room") {
        << RoomAuthCheck{ok: false, name: "", epoch: 0}
    }
    rn := doc.get(doc.root(), "room")
    if !doc.is_dict(rn) || !doc.has(rn, "members") { << RoomAuthCheck{ok: false, name: "", epoch: 0} }
    rname := json_str_or(&doc, doc.get(rn, "name"), "")
    rep_srv := json_int_or(&doc, doc.get(rn, "epoch"), 0)
    arr := doc.get(rn, "members")
    if !doc.is_list(arr) { << RoomAuthCheck{ok: false, name: "", epoch: 0} }
    $self_ok := false
    $from_ok := false
    for i in 0:doc.count(arr) {
        el := doc.at(arr, i)
        if !doc.is_dict(el) { -> }
        aid := json_str_or(&doc, doc.get(el, "agent_id"), "")
        role := json_str_or(&doc, doc.get(el, "role"), "member")
        if aid == self_id { self_ok = true }
        if aid == from_id {
            if !require_priv || role == "owner" || role == "admin" {
                from_ok = true
            }
        }
    }
    << RoomAuthCheck{ok: self_ok && from_ok, name: rname, epoch: rep_srv}
}

fn load_room_info_or(home string, rid string) RoomInfo {
    << load_room_info(home, rid) or (err) {
        << RoomInfo{room_id: "", name: "", key_b64: "", epoch: 0, created_at: 0}
    }
}

fn map_set_str_int(m $&maps.StrInt, k string, v int) {
    m.set(k, v)
}

fn map_get_int_or(m &maps.StrInt, k string, def int) int {
    << m.get(k) or (err) { << def }
}

fn apply_room_keybox_item(opts &CliOpts, cfg &Config, priv &rsa.PrivateKey, box_doc &json.Doc, node int) string {
    if node < 0 || !box_doc.is_dict(node) { << "error" }
    rid := json_str_or(box_doc, box_doc.get(node, "room_id"), "")
    rname := json_str_or(box_doc, box_doc.get(node, "name"), "")
    from_id := json_str_or(box_doc, box_doc.get(node, "from"), "")
    box_ep := json_int_or(box_doc, box_doc.get(node, "epoch"), 1)
    frame_json := json_encode_or(box_doc, box_doc.get(node, "frame"), "")
    if !is_valid_room_id(rid + "") || frame_json.len == 0 || from_id.len == 0 {
        << "error"
    }

    cur := load_room_info_or(cfg.home + "", rid + "")
    if cur.room_id.len > 0 && cur.key_b64.len > 0 && cur.epoch >= box_ep {
        << "skipped"
    }

    fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, from_id + "")
    dec := decrypt_dm_frame_with_archive(cfg.home + "", cfg.agent_id + "", cfg.key_version, priv, from_id + "", &fk.pk, fk.ok, &frame_json)
    if !dec.ok || !dec.verified || (dec.msg_type != "room_invite" && dec.msg_type != "room_rekey") {
        << "error"
    }
    bd := json.parse(&dec.body_json)
    if !bd.ok() || !bd.is_dict(bd.root()) { << "error" }
    br := bd.root()
    inner_rid := json_str_or(&bd, bd.get(br, "room_id"), "")
    rkey_b64 := json_str_or(&bd, bd.get(br, "room_key"), "")
    inner_name := json_str_or(&bd, bd.get(br, "name"), "")
    rep := json_int_or(&bd, bd.get(br, "epoch"), 1)
    rkey_raw := base64.decode_string(rkey_b64 + "") or (err) { << "error" }
    if inner_rid != rid || rkey_raw.len != 32 || rep < 1 {
        << "error"
    }

    $auth_ok := false
    $fallback_name := rname + ""
    if dec.msg_type == "room_invite" {
        auth_ok = check_is_friend(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, from_id + "")
        if !auth_ok {
            mc := check_room_sender_valid(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, rid + "", from_id + "", false)
            auth_ok = mc.ok
            if mc.name.len > 0 { fallback_name = mc.name + "" }
        }
    } else {
        if cur.room_id.len == 0 || rep > cur.epoch {
            ac := check_room_sender_valid(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, rid + "", from_id + "", true)
            auth_ok = ac.ok
            if ac.name.len > 0 { fallback_name = ac.name + "" }
        }
    }
    if !auth_ok { << "error" }

    $use_name := inner_name + ""
    if use_name.len == 0 { use_name = fallback_name + "" }
    $cat := dec.ts
    if cur.created_at > 0 { cat = cur.created_at }
    ri := RoomInfo{room_id: rid + "", name: use_name + "", key_b64: rkey_b64 + "", epoch: rep, created_at: cat}
    if !save_room_info_q(cfg.home + "", &ri) { << "error" }
    if dec.nonce.len > 0 {
        _ := check_and_record_nonce(cfg.home + "", dec.nonce + "", time.now_time().unix())
    }
    << "synced"
}

fn sync_room_keyboxes(opts &CliOpts, cfg &Config, priv &rsa.PrivateKey, only_rid string, quiet bool) int {
    empty := ""
    $synced := 0
    $skipped := 0
    $errs := 0
    if only_rid.len > 0 {
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, true, "GET", "/v1/rooms/" + only_rid + "/key-box", &empty, "")
        if !r.ok {
            if quiet { << EXIT_OK }
            << handle_api_fail(opts, &r)
        }
        doc := json.parse(&r.body)
        if doc.ok() && doc.is_dict(doc.root()) && json_bool_or(&doc, doc.get(doc.root(), "found"), false) && doc.has(doc.root(), "box") {
            st := apply_room_keybox_item(opts, cfg, priv, &doc, doc.get(doc.root(), "box"))
            if st == "synced" { synced += 1 }
            else if st == "skipped" { skipped += 1 }
            else { errs += 1 }
        }
    } else {
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, true, "GET", "/v1/rooms/key-boxes", &empty, "")
        if !r.ok {
            if quiet { << EXIT_OK }
            << handle_api_fail(opts, &r)
        }
        doc := json.parse(&r.body)
        if doc.ok() && doc.is_dict(doc.root()) && doc.has(doc.root(), "boxes") {
            arr := doc.get(doc.root(), "boxes")
            if doc.is_list(arr) {
                for i in 0:doc.count(arr) {
                    st := apply_room_keybox_item(opts, cfg, priv, &doc, doc.at(arr, i))
                    if st == "synced" { synced += 1 }
                    else if st == "skipped" { skipped += 1 }
                    else { errs += 1 }
                }
            }
        }
    }
    if !quiet {
        println("{\"ok\":true,\"synced\":" + strconv.itoa(synced) + ",\"skipped\":" + strconv.itoa(skipped) + ",\"errors\":" + strconv.itoa(errs) + "}")
    }
    << EXIT_OK
}

struct RoomRekeyOutcome {
    pub ok bool
    pub exit_code int
    pub err_code string
    pub http_status int
    pub err_msg string
    pub body string
}

fn distribute_room_rekey(opts &CliOpts, cfg &Config, priv &rsa.PrivateKey, rid string, rname string, new_ep int, bump_epoch bool, recipients &[]string) RoomRekeyOutcome {
    kb64 := random_b64(32) or (err) {
        << RoomRekeyOutcome{ok: false, exit_code: EXIT_CRYPTO, err_code: "ERR_CRYPTO", http_status: 0, err_msg: err.msg(), body: ""}
    }
    now := time.now_time().unix()
    $envs := []string{}
    for i in 0:recipients.len {
        to_id := recipients[i] + ""
        if to_id == cfg.agent_id || to_id.len == 0 { -> }
        fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, to_id + "")
        if !fk.ok { -> }
        body_json := "{\"epoch\":" + strconv.itoa(new_ep) + ",\"name\":" + json.quote(&rname) + ",\"room_id\":" + json.quote(&rid) + ",\"room_key\":" + json.quote(&kb64) + "}"
        frame := encrypt_dm_frame(cfg.agent_id + "", priv, to_id + "", &fk.pk, fk.key_version, "room_rekey", body_json, "open", now) or (err) { -> }
        envs.push("{\"to\":" + json.quote(&to_id) + ",\"frame\":" + frame + "}")
    }
    $bp := "false"
    if bump_epoch { bp = "true" }
    req_body := "{\"epoch\":" + strconv.itoa(new_ep) + ",\"bump_epoch\":" + bp + ",\"envelopes\":[" + strings.join(envs, ",") + "]}"
    r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, true, "POST", "/v1/rooms/" + rid + "/rekey", &req_body, "")
    if !r.ok {
        $ec := map_http_exit_code(r.status, r.err_code + "")
        if r.net_err { ec = EXIT_NET }
        << RoomRekeyOutcome{ok: false, exit_code: ec, err_code: r.err_code + "", http_status: r.status, err_msg: r.err_msg + "", body: ""}
    }
    $created_at := now
    existing := load_room_info_or(cfg.home + "", rid + "")
    if existing.created_at > 0 { created_at = existing.created_at }
    ri := RoomInfo{room_id: rid + "", name: rname + "", key_b64: kb64 + "", epoch: new_ep, created_at: created_at}
    save_room_info(cfg.home + "", &ri) or (err) {
        << RoomRekeyOutcome{ok: false, exit_code: EXIT_CONFIG, err_code: "ERR_CONFIG", http_status: 0, err_msg: err.msg(), body: ""}
    }
    << RoomRekeyOutcome{ok: true, exit_code: EXIT_OK, err_code: "", http_status: 200, err_msg: "", body: r.body + ""}
}

pub fn cmd_room(opts &CliOpts, args []string) int {
    if args.len < 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room <create|list|info|members|set|invite|role|mute|unmute|kick|ban|unban|rotate|transfer|leave|close|sync|send> ...", 0, EXIT_USAGE)
    }
    sub := args[0] + ""

    if sub == "create" {
        $fs := flag.new_set("room create")
        fs.define_string("name", "", "room name")
        fs.define_string("topic", "", "room topic")
        fs.define_string("send-policy", "all", "send policy (all|admins)")
        fs.define_string("invite-policy", "admins", "invite policy (admins|members)")
        fs.define_string("join-policy", "invite_only", "join policy")
        fs.define_int("max-members", 64, "maximum room members")
        fs.define_int("slow-mode", 0, "slow mode cooldown seconds")
        fs.define_bool("locked", false, "create room in locked state")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), false, "usage: fatext room create [--name ...] [--topic ...] [--send-policy ...] [--invite-policy ...] [--join-policy ...] [--max-members N] [--slow-mode SEC] [--locked]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }

        label := fs.get_string("name")
        topic := fs.get_string("topic")
        sp := fs.get_string("send-policy")
        ip := fs.get_string("invite-policy")
        jp := fs.get_string("join-policy")
        max_m := fs.get_int("max-members")
        slow_s := fs.get_int("slow-mode")
        locked := fs.get_bool("locked")

        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        rid := generate_room_id() or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        kb64 := random_b64(32) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        $lk_s := "false"
        if locked { lk_s = "true" }
        req_body := "{\"room_id\":" + json.quote(&rid) +
            ",\"name\":" + json.quote(&label) +
            ",\"topic\":" + json.quote(&topic) +
            ",\"send_policy\":" + json.quote(&sp) +
            ",\"invite_policy\":" + json.quote(&ip) +
            ",\"join_policy\":" + json.quote(&jp) +
            ",\"max_members\":" + strconv.itoa(max_m) +
            ",\"slow_mode_sec\":" + strconv.itoa(slow_s) +
            ",\"locked\":" + lk_s + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/rooms", &req_body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        now := time.now_time().unix()
        ri := RoomInfo{room_id: rid + "", name: label + "", key_b64: kb64 + "", epoch: 1, created_at: now}
        save_room_info(cfg.home + "", &ri) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        println("{\"ok\":true,\"room_id\":" + json.quote(&rid) + ",\"name\":" + json.quote(&label) + ",\"epoch\":1,\"send_policy\":" + json.quote(&sp) + ",\"invite_policy\":" + json.quote(&ip) + ",\"join_policy\":" + json.quote(&jp) + ",\"max_members\":" + strconv.itoa(max_m) + ",\"slow_mode_sec\":" + strconv.itoa(slow_s) + ",\"locked\":" + lk_s + "}")
        << EXIT_OK
    }
    if sub == "set" {
        $fs := flag.new_set("room set")
        fs.define_string("name", "", "room name")
        fs.define_string("topic", "", "room topic")
        fs.define_string("send-policy", "", "send policy")
        fs.define_string("invite-policy", "", "invite policy")
        fs.define_string("join-policy", "", "join policy")
        fs.define_int("max-members", 0, "maximum room members")
        fs.define_int("slow-mode", 0, "slow mode cooldown seconds")
        fs.define_bool("lock", false, "lock room")
        fs.define_bool("unlock", false, "unlock room")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), true, "usage: fatext room set <room_id> [--name ...] [--topic ...] [--send-policy ...] [--invite-policy ...] [--join-policy ...] [--max-members N] [--slow-mode SEC] [--lock|--unlock]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room set <room_id> [--name ...] [--topic ...] [--send-policy ...] [--invite-policy ...] [--join-policy ...] [--max-members N] [--slow-mode SEC] [--lock|--unlock]", 0, EXIT_USAGE) }
        if fs.is_set("lock") && fs.is_set("unlock") {
            << emit_err(opts, "ERR_USAGE", 0, "--lock and --unlock are mutually exclusive", 0, EXIT_USAGE)
        }
        rid := pos[0] + ""
        $fields := []string{}
        $new_name := ""
        has_name := fs.is_set("name")
        if has_name {
            new_name = fs.get_string("name")
            fields.push("\"name\":" + json.quote(&new_name))
        }
        if fs.is_set("topic") {
            tv := fs.get_string("topic")
            fields.push("\"topic\":" + json.quote(&tv))
        }
        if fs.is_set("send-policy") {
            sv := fs.get_string("send-policy")
            fields.push("\"send_policy\":" + json.quote(&sv))
        }
        if fs.is_set("invite-policy") {
            iv := fs.get_string("invite-policy")
            fields.push("\"invite_policy\":" + json.quote(&iv))
        }
        if fs.is_set("join-policy") {
            jv := fs.get_string("join-policy")
            fields.push("\"join_policy\":" + json.quote(&jv))
        }
        if fs.is_set("max-members") {
            fields.push("\"max_members\":" + strconv.itoa(fs.get_int("max-members")))
        }
        if fs.is_set("slow-mode") {
            fields.push("\"slow_mode_sec\":" + strconv.itoa(fs.get_int("slow-mode")))
        }
        if fs.is_set("lock") {
            if fs.get_bool("lock") { fields.push("\"locked\":true") } else { fields.push("\"locked\":false") }
        }
        if fs.is_set("unlock") {
            if fs.get_bool("unlock") { fields.push("\"locked\":false") } else { fields.push("\"locked\":true") }
        }
        if fields.len == 0 {
            << emit_err(opts, "ERR_USAGE", 0, "room set requires at least one option", 0, EXIT_USAGE)
        }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        req_body := "{" + strings.join(fields, ",") + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "PATCH", "/v1/rooms/" + rid, &req_body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if has_name {
            $ri := load_room_info_or(cfg.home + "", rid + "")
            if ri.room_id.len > 0 {
                ri.name = new_name + ""
                _ := save_room_info_q(cfg.home + "", &ri)
            }
        }
        println(r.body)
        << EXIT_OK
    }
    if sub == "invite" {
        $fs := flag.new_set("room invite")
        fs.define_string("role", "member", "member role (admin|member|readonly)")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), true, "usage: fatext room invite <room_id> <agent_id> [--role admin|member|readonly]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room invite <room_id> <agent_id> [--role admin|member|readonly]", 0, EXIT_USAGE) }
        rid := pos[0] + ""
        to_id := pos[1] + ""
        role := fs.get_string("role")
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        ri := load_room_info(cfg.home + "", rid + "") or (err) { << emit_err(opts, "ERR_NOT_FOUND", 0, "room key not found locally: " + rid, 0, EXIT_NOT_FOUND) }
        fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, to_id + "")
        if !fk.ok { << emit_err(opts, fk.err_code + "", 0, fk.err_msg + "", 0, fk.exit_code) }
        body_json := "{\"epoch\":" + strconv.itoa(ri.epoch) + ",\"name\":" + json.quote(&ri.name) + ",\"room_id\":" + json.quote(&rid) + ",\"room_key\":" + json.quote(&ri.key_b64) + "}"
        now := time.now_time().unix()
        frame := encrypt_dm_frame(cfg.agent_id + "", &priv, to_id + "", &fk.pk, fk.key_version, "room_invite", body_json, "open", now) or (err) {
            << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
        }
        req_body := "{\"agent_id\":" + json.quote(&to_id) + ",\"role\":" + json.quote(&role) + ",\"invite_frame\":" + frame + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/rooms/" + rid + "/members", &req_body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "kick" || sub == "ban" {
        $fs := flag.new_set("room " + sub)
        fs.define_bool("no-rekey", false, "skip rotating room encryption key")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), true, "usage: fatext room " + sub + " <room_id> <agent_id> [--no-rekey]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room " + sub + " <room_id> <agent_id> [--no-rekey]", 0, EXIT_USAGE) }
        rid := pos[0] + ""
        aid := pos[1] + ""
        no_rekey := fs.get_bool("no-rekey")
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        $rot_s := "true"
        if no_rekey { rot_s = "false" }
        req_body := "{\"rotate_epoch\":" + rot_s + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/rooms/" + rid + "/members/" + aid + "/" + sub, &req_body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if no_rekey {
            println(r.body)
            << EXIT_OK
        }
        kdoc := json.parse(&r.body)
        if !kdoc.ok() {
            println(r.body)
            << EXIT_OK
        }
        kr := kdoc.root()
        new_ep := json_int_or(&kdoc, kdoc.get(kr, "epoch"), 2)
        $rem := []string{}
        if kdoc.has(kr, "remaining_members") && kdoc.is_list(kdoc.get(kr, "remaining_members")) {
            arr := kdoc.get(kr, "remaining_members")
            for i in 0:kdoc.count(arr) {
                mid := json_str_or(&kdoc, kdoc.at(arr, i), "")
                if mid.len > 0 { rem.push(mid) }
            }
        }
        lri := load_room_info_or(cfg.home + "", rid + "")
        $rname := lri.name + ""
        rk := distribute_room_rekey(opts, &cfg, &priv, rid + "", rname + "", new_ep, false, &rem)
        if !rk.ok {
            << emit_err(opts, rk.err_code + "", rk.http_status, rk.err_msg + "", 0, rk.exit_code)
        }
        println("{\"ok\":true,\"room_id\":" + json.quote(&rid) + ",\"action\":" + json.quote(&sub) + ",\"target\":" + json.quote(&aid) + ",\"epoch\":" + strconv.itoa(new_ep) + ",\"rekeyed\":true}")
        << EXIT_OK
    }

    cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    empty := ""

    if sub == "list" {
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/rooms", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "info" || sub == "members" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room " + sub + " <room_id>", 0, EXIT_USAGE) }
        rid := args[1] + ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/rooms/" + rid, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "role" {
        if args.len < 4 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room role <room_id> <agent_id> <admin|member|readonly>", 0, EXIT_USAGE) }
        rid := args[1] + ""
        aid := args[2] + ""
        role := args[3] + ""
        req_body := "{\"role\":" + json.quote(&role) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "PATCH", "/v1/rooms/" + rid + "/members/" + aid, &req_body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "mute" || sub == "unmute" {
        if args.len < 3 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room " + sub + " <room_id> <agent_id>", 0, EXIT_USAGE) }
        rid := args[1] + ""
        aid := args[2] + ""
        $mv := "true"
        if sub == "unmute" { mv = "false" }
        req_body := "{\"muted\":" + mv + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "PATCH", "/v1/rooms/" + rid + "/members/" + aid, &req_body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "unban" {
        if args.len < 3 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room unban <room_id> <agent_id>", 0, EXIT_USAGE) }
        rid := args[1] + ""
        aid := args[2] + ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "DELETE", "/v1/rooms/" + rid + "/bans/" + aid, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "rotate" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room rotate <room_id>", 0, EXIT_USAGE) }
        rid := args[1] + ""
        gr := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/rooms/" + rid, &empty, "")
        if !gr.ok { << handle_api_fail(opts, &gr) }
        gdoc := json.parse(&gr.body)
        if !gdoc.ok() || !gdoc.has(gdoc.root(), "room") {
            << emit_err(opts, "ERR_ERR", 0, "invalid room metadata", 0, EXIT_ERR)
        }
        rn := gdoc.get(gdoc.root(), "room")
        cur_ep := json_int_or(&gdoc, gdoc.get(rn, "epoch"), 1)
        rname := json_str_or(&gdoc, gdoc.get(rn, "name"), "")
        $mem := []string{}
        if gdoc.has(rn, "members") && gdoc.is_list(gdoc.get(rn, "members")) {
            arr := gdoc.get(rn, "members")
            for i in 0:gdoc.count(arr) {
                el := gdoc.at(arr, i)
                mid := json_str_or(&gdoc, gdoc.get(el, "agent_id"), "")
                if mid.len > 0 { mem.push(mid) }
            }
        }
        new_ep := cur_ep + 1
        rk := distribute_room_rekey(opts, &cfg, &priv, rid + "", rname + "", new_ep, true, &mem)
        if !rk.ok {
            << emit_err(opts, rk.err_code + "", rk.http_status, rk.err_msg + "", 0, rk.exit_code)
        }
        println(rk.body)
        << EXIT_OK
    }
    if sub == "transfer" {
        if args.len < 3 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room transfer <room_id> <agent_id>", 0, EXIT_USAGE) }
        rid := args[1] + ""
        aid := args[2] + ""
        req_body := "{\"agent_id\":" + json.quote(&aid) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/rooms/" + rid + "/transfer", &req_body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "leave" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room leave <room_id>", 0, EXIT_USAGE) }
        rid := args[1] + ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/rooms/" + rid + "/leave", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        delete_room_info_quiet(cfg.home + "", rid + "")
        println(r.body)
        << EXIT_OK
    }
    if sub == "close" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room close <room_id>", 0, EXIT_USAGE) }
        rid := args[1] + ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "DELETE", "/v1/rooms/" + rid, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        delete_room_info_quiet(cfg.home + "", rid + "")
        println(r.body)
        << EXIT_OK
    }
    if sub == "sync" {
        $only_rid := ""
        if args.len >= 2 { only_rid = args[1] + "" }
        << sync_room_keyboxes(opts, &cfg, &priv, only_rid + "", false)
    }
    if sub == "send" {
        if args.len < 3 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext room send <room_id> <text|->", 0, EXIT_USAGE) }
        rid := args[1] + ""
        text := read_text_arg_or_stdin(args[2] + "")
        ri := load_room_info(cfg.home + "", rid + "") or (err) { << emit_err(opts, "ERR_NOT_FOUND", 0, "room key not found locally: " + rid, 0, EXIT_NOT_FOUND) }
        rkey := base64.decode_string(ri.key_b64 + "") or (err) { << emit_err(opts, "ERR_CRYPTO", 0, "corrupt room key", 0, EXIT_CRYPTO) }
        body_json := "{\"text\":" + json.quote(&text) + "}"
        now := time.now_time().unix()
        frame := encrypt_room_frame(cfg.agent_id + "", &priv, rid + "", &rkey, ri.epoch, body_json, now) or (err) {
            << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
        }
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/rooms/" + rid + "/send", &frame, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    << emit_err(opts, "ERR_USAGE", 0, "unknown room subcommand: " + sub, 0, EXIT_USAGE)
}

// =========================================================================
// 5. SSE stream & encrypted mailbox
// =========================================================================

fn listen_get_pk_idx(
    api_base string,
    timeout_sec int,
    aid string,
    now int,
    force_refresh bool,
    pk_idx $&maps.StrInt,
    pk_ts $&maps.StrInt,
    pks $&[]rsa.PublicKey
) int {
    if !force_refresh && pk_idx.has(aid + "") {
        cached_at := map_get_int_or(pk_ts, aid + "", 0)
        if now - cached_at < 300 {
            << map_get_int_or(pk_idx, aid + "", -1)
        }
    }
    fk := fetch_agent_key(api_base + "", timeout_sec, aid + "")
    if !fk.ok { << -1 }
    pk := decode_spki_public_pem(&fk.pub_pem) or (err) { << -1 }
    pks.push(pk)
    idx := pks.len - 1
    map_set_str_int(pk_idx, aid + "", idx)
    map_set_str_int(pk_ts, aid + "", now)
    << idx
}

fn check_replay_nonce_listen(home string, nonce string, now int, seen_nonces $&maps.StrInt) bool {
    if nonce.len == 0 { << false }
    if seen_nonces.has(nonce + "") { << false }
    if !check_and_record_nonce(home + "", nonce + "", now) { << false }
    map_set_str_int(seen_nonces, nonce + "", now)
    << true
}

pub fn cmd_listen(opts &CliOpts, args []string) int {
    $fs := flag.new_set("listen")
    fs.define_string("channels", "", "comma-separated public channels")
    fs.define_string("rooms", "", "comma-separated room IDs")
    fs.define_int("max-events", 0, "stop after N events (0 = unlimited)")
    fs.define_bool("no-reconnect", false, "do not auto-reconnect on disconnect")
    pr := parse_flags(opts, $&fs, args, false, "usage: fatext listen [--channels general,dev] [--rooms r1,r2] [--max-events N] [--no-reconnect]")
    if pr == FLAG_HELP { << EXIT_OK }
    if pr != FLAG_OK { << EXIT_USAGE }

    channels := fs.get_string("channels")
    rooms := fs.get_string("rooms")
    max_events := fs.get_int("max-events")
    no_reconnect := fs.get_bool("no-reconnect")

    cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }

    $q := []string{}
    if channels.len > 0 { q.push("channels=" + url_encode(&channels)) }
    if rooms.len > 0 { q.push("rooms=" + url_encode(&rooms)) }
    $path := "/v1/stream"
    if q.len > 0 { path = path + "?" + join_ref(&q, "&") }

    $pk_idx := maps.new_str_int()
    $pk_ts := maps.new_str_int()
    $pks := []rsa.PublicKey{}
    $seen_nonces := maps.new_str_int()
    $seen_nonce_cnt := 0
    $seen := 0
    $connected_once := false
    $backoff_ms := 500
    $stop_reason := ""
    dummy_pk := dummy_rsa_pk()

    while true {
        $sc := empty_sse_conn()
        out := sse_connect_into(cfg.api_base + "", cfg.agent_id + "", &priv, path + "", $&sc)
        if !out.ok {
            if out.http_status == 401 {
                << emit_err(opts, "ERR_AUTH", 401, out.err_msg + "", 0, EXIT_AUTH)
            }
            if out.http_status == 403 {
                << emit_err(opts, "ERR_FORBIDDEN", 403, out.err_msg + "", 0, EXIT_FORBIDDEN)
            }
            if !connected_once || no_reconnect {
                << emit_err(opts, "ERR_NETWORK", out.http_status, out.err_msg + "", 0, EXIT_NET)
            }
            time.sleep(jitter_ms(backoff_ms) * 1000000)
            backoff_ms = backoff_ms * 2
            if backoff_ms > 30000 { backoff_ms = 30000 }
            ->
        }

        if connected_once {
            emit_stdout_line("{\"type\":\"system\",\"kind\":\"reconnected\",\"missed_dm_possible\":true}")
        }
        connected_once = true
        backoff_ms = 500
        _ := sync_room_keyboxes(opts, &cfg, &priv, "", true)

        while true {
            ev := sse_read_event($&sc)
            if ev.eof { <- }
            if !ev.ok { -> }
            if ev.event_type == "dm" {
                d := json.parse(&ev.data)
                if !d.ok() || !d.has(d.root(), "from") || !d.has(d.root(), "frame") { -> }
                from_id := json_str_or(&d, d.get(d.root(), "from"), "")
                frame_json := json_encode_or(&d, d.get(d.root(), "frame"), "")
                now_pk := time.now_time().unix()
                $pki := listen_get_pk_idx(cfg.api_base + "", opts.timeout_sec, from_id + "", now_pk, false, $&pk_idx, $&pk_ts, $&pks)
                $dec := dec_fail("no key")
                if pki >= 0 {
                    dec = decrypt_dm_frame_with_archive(cfg.home + "", cfg.agent_id + "", cfg.key_version, &priv, from_id + "", &pks[pki], true, &frame_json)
                } else {
                    dec = decrypt_dm_frame_with_archive(cfg.home + "", cfg.agent_id + "", cfg.key_version, &priv, from_id + "", &dummy_pk, false, &frame_json)
                }
                if dec.ok && !dec.verified && pki >= 0 {
                    pki2 := listen_get_pk_idx(cfg.api_base + "", opts.timeout_sec, from_id + "", now_pk, true, $&pk_idx, $&pk_ts, $&pks)
                    if pki2 >= 0 {
                        dec = decrypt_dm_frame_with_archive(cfg.home + "", cfg.agent_id + "", cfg.key_version, &priv, from_id + "", &pks[pki2], true, &frame_json)
                    }
                }
                if !dec.ok {
                    emit_stdout_line("{\"type\":\"error\",\"code\":\"decrypt_failed\",\"from\":" + json.quote(&from_id) + ",\"detail\":" + json.quote(&dec.err) + "}")
                } else if dec.ts <= 0 || now_pk - dec.ts > 86400 || dec.ts - now_pk > 86400 {
                    emit_stdout_line("{\"type\":\"error\",\"code\":\"stale_frame\",\"from\":" + json.quote(&from_id) + "}")
                } else if !check_replay_nonce_listen(cfg.home + "", dec.nonce + "", now_pk, $&seen_nonces) {
                    emit_stdout_line("{\"type\":\"error\",\"code\":\"replay_nonce\",\"from\":" + json.quote(&from_id) + "}")
                } else if dec.msg_type == "room_invite" {
                    bd := json.parse(&dec.body_json)
                    if bd.ok() {
                        br := bd.root()
                        rid := json_str_or(&bd, bd.get(br, "room_id"), "")
                        rkey_b64 := json_str_or(&bd, bd.get(br, "room_key"), "")
                        rname := json_str_or(&bd, bd.get(br, "name"), "")
                        rep := json_int_or(&bd, bd.get(br, "epoch"), 0)
                        $stored := false
                        if dec.verified && is_valid_room_id(rid + "") && rep >= 1 {
                            cur_inv := load_room_info_or(cfg.home + "", rid + "")
                            if (cur_inv.room_id.len == 0 || rep > cur_inv.epoch) && decode_b64_len(rkey_b64 + "") == 32 {
                                mc := check_room_sender_valid(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, rid + "", from_id + "", cur_inv.room_id.len > 0)
                                if mc.ok && (mc.epoch <= 0 || rep == mc.epoch) {
                                    $cat := dec.ts
                                    if cur_inv.created_at > 0 { cat = cur_inv.created_at }
                                    $use_name := rname + ""
                                    if use_name.len == 0 && mc.name.len > 0 { use_name = mc.name + "" }
                                    ri := RoomInfo{room_id: rid + "", name: use_name + "", key_b64: rkey_b64 + "", epoch: rep, created_at: cat}
                                    stored = save_room_info_q(cfg.home + "", &ri)
                                }
                            }
                        }
                        $st_s := "false"
                        if stored { st_s = "true" }
                        $vs := "false"
                        if dec.verified { vs = "true" }
                        emit_stdout_line("{\"type\":\"room_invite\",\"room_id\":" + json.quote(&rid) + ",\"from\":" + json.quote(&from_id) + ",\"name\":" + json.quote(&rname) + ",\"stored\":" + st_s + ",\"verified\":" + vs + "}")
                    }
                } else if dec.msg_type == "room_rekey" {
                    bd := json.parse(&dec.body_json)
                    if bd.ok() {
                        br := bd.root()
                        rid := json_str_or(&bd, bd.get(br, "room_id"), "")
                        rkey_b64 := json_str_or(&bd, bd.get(br, "room_key"), "")
                        rname := json_str_or(&bd, bd.get(br, "name"), "")
                        rep := json_int_or(&bd, bd.get(br, "epoch"), 0)
                        $stored := false
                        if dec.verified && is_valid_room_id(rid + "") && rep >= 1 {
                            cur := load_room_info_or(cfg.home + "", rid + "")
                            if decode_b64_len(rkey_b64 + "") == 32 && (cur.room_id.len == 0 || rep > cur.epoch) {
                                ac := check_room_sender_valid(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, rid + "", from_id + "", true)
                                if ac.ok {
                                    $cat := dec.ts
                                    if cur.created_at > 0 { cat = cur.created_at }
                                    $use_name := rname + ""
                                    if use_name.len == 0 && ac.name.len > 0 { use_name = ac.name + "" }
                                    ri := RoomInfo{room_id: rid + "", name: use_name + "", key_b64: rkey_b64 + "", epoch: rep, created_at: cat}
                                    stored = save_room_info_q(cfg.home + "", &ri)
                                }
                            }
                        }
                        $st_s := "false"
                        if stored { st_s = "true" }
                        $vs := "false"
                        if dec.verified { vs = "true" }
                        emit_stdout_line("{\"type\":\"room_rekey\",\"room_id\":" + json.quote(&rid) + ",\"from\":" + json.quote(&from_id) + ",\"epoch\":" + strconv.itoa(rep) + ",\"stored\":" + st_s + ",\"verified\":" + vs + "}")
                    }
                } else {
                    bd := json.parse(&dec.body_json)
                    $txt := dec.body_json + ""
                    if bd.ok() && bd.has(bd.root(), "text") {
                        txt = json_str_or(&bd, bd.get(bd.root(), "text"), "")
                    }
                    $vs := "false"
                    if dec.verified { vs = "true" }
                    emit_stdout_line("{\"type\":\"dm\",\"from\":" + json.quote(&from_id) + ",\"ts\":" + strconv.itoa(dec.ts) + ",\"text\":" + json.quote(&txt) + ",\"conversation_state\":" + json.quote(&dec.conv_state) + ",\"verified\":" + vs + "}")
                }
            } else if ev.event_type == "room" {
                d := json.parse(&ev.data)
                if !d.ok() || !d.has(d.root(), "room_id") || !d.has(d.root(), "from") || !d.has(d.root(), "frame") { -> }
                rid := json_str_or(&d, d.get(d.root(), "room_id"), "")
                from_id := json_str_or(&d, d.get(d.root(), "from"), "")
                frame_json := json_encode_or(&d, d.get(d.root(), "frame"), "")
                ri := load_room_info(cfg.home + "", rid + "") or (err) {
                    emit_stdout_line("{\"type\":\"error\",\"code\":\"missing_room_key\",\"room_id\":" + json.quote(&rid) + "}")
                    ->
                }
                rkey := base64.decode_string(ri.key_b64 + "") or (err) { -> }
                now_pk := time.now_time().unix()
                $pki := listen_get_pk_idx(cfg.api_base + "", opts.timeout_sec, from_id + "", now_pk, false, $&pk_idx, $&pk_ts, $&pks)
                $dec := dec_fail("no key")
                if pki >= 0 {
                    dec = decrypt_room_frame(rid + "", &rkey, from_id + "", &pks[pki], true, &frame_json)
                } else {
                    dec = decrypt_room_frame(rid + "", &rkey, from_id + "", &dummy_pk, false, &frame_json)
                }
                if dec.ok && !dec.verified && pki >= 0 {
                    pki2 := listen_get_pk_idx(cfg.api_base + "", opts.timeout_sec, from_id + "", now_pk, true, $&pk_idx, $&pk_ts, $&pks)
                    if pki2 >= 0 {
                        dec = decrypt_room_frame(rid + "", &rkey, from_id + "", &pks[pki2], true, &frame_json)
                    }
                }
                if !dec.ok {
                    emit_stdout_line("{\"type\":\"error\",\"code\":\"decrypt_failed\",\"room_id\":" + json.quote(&rid) + ",\"from\":" + json.quote(&from_id) + "}")
                } else if dec.ts <= 0 || now_pk - dec.ts > 86400 || dec.ts - now_pk > 86400 {
                    emit_stdout_line("{\"type\":\"error\",\"code\":\"stale_frame\",\"room_id\":" + json.quote(&rid) + ",\"from\":" + json.quote(&from_id) + "}")
                } else if !check_replay_nonce_listen(cfg.home + "", dec.nonce + "", now_pk, $&seen_nonces) {
                    emit_stdout_line("{\"type\":\"error\",\"code\":\"replay_nonce\",\"room_id\":" + json.quote(&rid) + ",\"from\":" + json.quote(&from_id) + "}")
                } else {
                    bd := json.parse(&dec.body_json)
                    $txt := dec.body_json + ""
                    if bd.ok() && bd.has(bd.root(), "text") {
                        txt = json_str_or(&bd, bd.get(bd.root(), "text"), "")
                    }
                    $vs := "false"
                    if dec.verified { vs = "true" }
                    emit_stdout_line("{\"type\":\"room\",\"room_id\":" + json.quote(&rid) + ",\"from\":" + json.quote(&from_id) + ",\"ts\":" + strconv.itoa(dec.ts) + ",\"text\":" + json.quote(&txt) + ",\"verified\":" + vs + "}")
                }
            } else {
                // Pass through post, reply, friend, mail, system, room_event
                if ev.event_type == "system" {
                    sd := json.parse(&ev.data)
                    if sd.ok() && sd.is_dict(sd.root()) {
                        sk := json_str_or(&sd, sd.get(sd.root(), "kind"), "")
                        if sk == "disconnected" || sk == "key_rotated" {
                            stop_reason = sk + ""
                        }
                    }
                }
                emit_stdout_line("{\"type\":" + json.quote(&ev.event_type) + ",\"data\":" + ev.data + "}")
            }
            seen += 1
            if max_events > 0 && seen >= max_events { <- }
        }
        sse_close($&sc)
        if (max_events > 0 && seen >= max_events) || no_reconnect || stop_reason.len > 0 { <- }
        time.sleep(backoff_ms * 1000000)
        backoff_ms = backoff_ms * 2
        if backoff_ms > 30000 { backoff_ms = 30000 }
    }
    << EXIT_OK
}

pub fn cmd_mail(opts &CliOpts, args []string) int {
    if args.len < 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext mail <pull [--delete]|rm <mail_id>>", 0, EXIT_USAGE) }
    sub := args[0] + ""
    if sub == "pull" {
        $fs := flag.new_set("mail pull")
        fs.define_bool("delete", false, "delete pulled mail messages from server")
        fs.define_string("since", "", "fetch mail since timestamp or id")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), false, "usage: fatext mail pull [--delete] [--since <val>]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        del_after := fs.get_bool("delete")
        since := fs.get_string("since")
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        empty := ""
        $pq := "/v1/mail"
        if since.len > 0 { pq = pq + "?since=" + url_encode(&since) }
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", pq, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }

        doc := json.parse(&r.body)
        if !doc.ok() || !doc.has(doc.root(), "mail") { << EXIT_OK }
        arr := doc.get(doc.root(), "mail")
        if !doc.is_list(arr) { << EXIT_OK }

        $hcfg := empty_human_mail_config()
        if doc.count(arr) > 0 {
            hcfg = fetch_verified_human_config(opts, &cfg, &priv)
        }

        for j in 0:doc.count(arr) {
            el := doc.at(arr, j)
            if !doc.is_dict(el) { -> }
            mid := json_str_or(&doc, doc.get(el, "mail_id"), "")
            rat := json_int_or(&doc, doc.get(el, "received_at"), 0)
            tkv := json_int_or(&doc, doc.get(el, "to_key_version"), cfg.key_version)
            spf := json_bool_or(&doc, doc.get(el, "spf_pass"), false)
            dkim := json_bool_or(&doc, doc.get(el, "dkim_pass"), false)
            dmarc := json_bool_or(&doc, doc.get(el, "dmarc_pass"), false)
            env_json := json_encode_or(&doc, doc.get(el, "envelope"), "")

            $pt := ""
            $dec_ok := false
            if tkv == cfg.key_version {
                pt = decrypt_mail_or(cfg.agent_id + "", &priv, mid + "", tkv, &env_json)
                if pt.len > 0 { dec_ok = true }
            } else {
                apriv := load_archived_private_key(cfg.home + "", tkv) or (err) {
                    println("{\"mail_id\":" + json.quote(&mid) + ",\"error\":\"missing_archived_key\",\"to_key_version\":" + strconv.itoa(tkv) + "}")
                    ->
                }
                pt = decrypt_mail_or(cfg.agent_id + "", &apriv, mid + "", tkv, &env_json)
                if pt.len > 0 { dec_ok = true }
            }
            if !dec_ok {
                println("{\"mail_id\":" + json.quote(&mid) + ",\"error\":\"decrypt_failed\"}")
                ->
            }

            pdoc := json.parse(&pt)
            $mfrom := ""
            $mheader_from := ""
            $msubj := ""
            $mraw := pt + ""
            $verdict_match := false
            if pdoc.ok() {
                pr_node := pdoc.root()
                mfrom = json_str_or(&pdoc, pdoc.get(pr_node, "from"), "")
                mheader_from = json_str_or(&pdoc, pdoc.get(pr_node, "header_from"), "")
                msubj = json_str_or(&pdoc, pdoc.get(pr_node, "subject"), "")
                mraw = json_str_or(&pdoc, pdoc.get(pr_node, "raw_snippet"), pt + "")
                pspf := json_bool_or(&pdoc, pdoc.get(pr_node, "spf_pass"), false)
                pdkim := json_bool_or(&pdoc, pdoc.get(pr_node, "dkim_pass"), false)
                pdmarc := json_bool_or(&pdoc, pdoc.get(pr_node, "dmarc_pass"), false)
                verdict_match = (pspf == spf) && (pdkim == dkim) && (pdmarc == dmarc)
            }
            norm_hf := normalize_email_addr(&mheader_from)
            from_human := hcfg.ok && norm_hf.len > 0 && email_list_contains(&hcfg.emails, &norm_hf)
            cmd_ok := verdict_match && dkim && dmarc && from_human && hcfg.command_enabled

            $spf_s := "false"
            if spf { spf_s = "true" }
            $dkim_s := "false"
            if dkim { dkim_s = "true" }
            $dmarc_s := "false"
            if dmarc { dmarc_s = "true" }
            $vm_s := "false"
            if verdict_match { vm_s = "true" }
            $fh_s := "false"
            if from_human { fh_s = "true" }
            $ce_s := "false"
            if cmd_ok { ce_s = "true" }

            println("{\"mail_id\":" + json.quote(&mid) + ",\"received_at\":" + strconv.itoa(rat) + ",\"expires_at\":" + strconv.itoa(rat + 864000) + ",\"from\":" + json.quote(&mfrom) + ",\"header_from\":" + json.quote(&mheader_from) + ",\"subject\":" + json.quote(&msubj) + ",\"text\":" + json.quote(&mraw) + ",\"spf_pass\":" + spf_s + ",\"dkim_pass\":" + dkim_s + ",\"dmarc_pass\":" + dmarc_s + ",\"verified\":" + vm_s + ",\"from_human\":" + fh_s + ",\"command_eligible\":" + ce_s + "}")

            if del_after && is_valid_mail_id(mid + "") {
                _ := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "DELETE", "/v1/mail/" + mid, &empty, "")
            }
        }
        << EXIT_OK
    }

    if sub == "rm" {
        if args.len < 2 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext mail rm <mail_id>", 0, EXIT_USAGE) }
        mid := args[1] + ""
        if !is_valid_mail_id(mid + "") {
            << emit_err(opts, "ERR_USAGE", 0, "invalid mail_id: " + mid, 0, EXIT_USAGE)
        }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        empty := ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "DELETE", "/v1/mail/" + mid, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    << emit_err(opts, "ERR_USAGE", 0, "unknown mail subcommand: " + sub, 0, EXIT_USAGE)
}

pub fn cmd_report(opts &CliOpts, args []string) int {
    if args.len < 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext report <submit|status> ...", 0, EXIT_USAGE)
    }
    sub := args[0] + ""
    api_base_def := resolve_api_base(opts, "")
    cfg_opt := load_config_or_base(opts, api_base_def + "")

    if sub == "submit" {
        $fs := flag.new_set("report submit")
        fs.define_string("msg", "", "target message id (defaults to thread_id)")
        fs.define_string("reason", "", "short report reason code")
        fs.define_string("details", "", "optional report details")
        fs.define_bool("anon", false, "submit report anonymously without agent signature")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), true, "usage: fatext report submit <thread_id> [--msg <msg_id>] --reason <reason> [--details <text>] [--anon]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 {
            << emit_err(opts, "ERR_USAGE", 0, "usage: fatext report submit <thread_id> [--msg <msg_id>] --reason <reason> [--details <text>] [--anon]", 0, EXIT_USAGE)
        }
        tid := pos[0] + ""
        if !is_valid_msg_id(tid + "") {
            << emit_err(opts, "ERR_USAGE", 0, "invalid thread_id: " + tid, 0, EXIT_USAGE)
        }
        $mid := fs.get_string("msg")
        if mid.len == 0 { mid = tid + "" }
        if !is_valid_msg_id(mid + "") {
            << emit_err(opts, "ERR_USAGE", 0, "invalid msg_id: " + mid, 0, EXIT_USAGE)
        }
        reason := fs.get_string("reason")
        if reason.len == 0 {
            << emit_err(opts, "ERR_USAGE", 0, "--reason is required", 0, EXIT_USAGE)
        }
        details := fs.get_string("details")
        anon := fs.get_bool("anon")
        body := "{\"thread_id\":" + json.quote(&tid) +
            ",\"msg_id\":" + json.quote(&mid) +
            ",\"reason\":" + json.quote(&reason) +
            ",\"details\":" + json.quote(&details) + "}"
        if !anon && cfg_opt.agent_id.len > 0 && cfg_opt.home.len > 0 {
            priv := load_private_key_checked(cfg_opt.home + "") or (err) {
                << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
            }
            r := api_call(cfg_opt.api_base + "", opts.timeout_sec, cfg_opt.agent_id + "", &priv, true, "POST", "/v1/reports", &body, "")
            if !r.ok { << handle_api_fail(opts, &r) }
            println(r.body)
            << EXIT_OK
        }
        r := api_call_anon(cfg_opt.api_base + "", opts.timeout_sec, "POST", "/v1/reports", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }

    if sub == "status" {
        $fs := flag.new_set("report status")
        fs.define_string("date", "", "receipt UTC date (YYYY-MM-DD)")
        fs.define_string("receipt", "", "report receipt id (rpt_...)")
        fs.define_string("token", "", "report access token")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), false, "usage: fatext report status --date <YYYY-MM-DD> --receipt <rpt_id> --token <token>")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        d := fs.get_string("date")
        rec := fs.get_string("receipt")
        tok := fs.get_string("token")
        if !valid_utc_date_str(&d) || !is_valid_receipt_id(rec + "") || tok.len == 0 {
            << emit_err(opts, "ERR_USAGE", 0, "valid --date, --receipt, and --token are required", 0, EXIT_USAGE)
        }
        body := "{\"date\":" + json.quote(&d) + ",\"receipt\":" + json.quote(&rec) + ",\"token\":" + json.quote(&tok) + "}"
        r := api_call_anon(cfg_opt.api_base + "", opts.timeout_sec, "POST", "/v1/reports/status", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }

    << emit_err(opts, "ERR_USAGE", 0, "unknown report subcommand: " + sub, 0, EXIT_USAGE)
}

pub fn cmd_moderation(opts &CliOpts, args []string) int {
    if args.len < 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext moderation <review|notices> ...", 0, EXIT_USAGE)
    }
    sub := args[0] + ""
    if sub == "review" {
        $fs := flag.new_set("moderation review")
        fs.define_string("date", "", "review UTC date (YYYY-MM-DD)")
        fs.define_string("receipt", "", "review receipt id (rpt_...)")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), false, "usage: fatext moderation review --date <YYYY-MM-DD> --receipt <rpt_id>")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        d := fs.get_string("date")
        rec := fs.get_string("receipt")
        if !valid_utc_date_str(&d) || !is_valid_receipt_id(rec + "") {
            << emit_err(opts, "ERR_USAGE", 0, "valid --date and --receipt are required", 0, EXIT_USAGE)
        }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        empty := ""
        pq := "/v1/moderation/review?date=" + url_encode(&d) + "&receipt=" + url_encode(&rec)
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", pq, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    if sub == "notices" {
        $fs := flag.new_set("moderation notices")
        fs.define_string("date", "", "optional UTC date (YYYY-MM-DD)")
        fs.define_int("offset", 0, "pagination offset")
        pr := parse_flags(opts, $&fs, slice_args(&args, 1), false, "usage: fatext moderation notices [--date YYYY-MM-DD] [--offset N]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        d := fs.get_string("date")
        off := fs.get_int("offset")
        if d.len > 0 && !valid_utc_date_str(&d) {
            << emit_err(opts, "ERR_USAGE", 0, "invalid --date: " + d, 0, EXIT_USAGE)
        }
        if off < 0 {
            << emit_err(opts, "ERR_USAGE", 0, "--offset must be >= 0", 0, EXIT_USAGE)
        }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        $q := []string{}
        if d.len > 0 { q.push("date=" + url_encode(&d)) }
        if fs.is_set("offset") { q.push("offset=" + strconv.itoa(off)) }
        $pq := "/v1/moderation/notices"
        if q.len > 0 { pq = pq + "?" + join_ref(&q, "&") }
        empty := ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", pq, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }
    << emit_err(opts, "ERR_USAGE", 0, "unknown moderation subcommand: " + sub, 0, EXIT_USAGE)
}

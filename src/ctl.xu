@main

#crypto/rsa
#crypto/sha256
#encoding/json
#flag
#os
#strconv
#strings
#time

pub struct CliScopeRes {
    pub ok bool
    pub scopes []string
}

pub fn cli_valid_scope(s string) bool {
    << s == "dm" || s == "mail" || s == "profile" || s == "pub" ||
        s == "room" || s == "rotate" || s == "social" || s == "stream"
}

pub fn cli_all_scopes() []string {
    << ["dm", "mail", "profile", "pub", "room", "rotate", "social", "stream"]
}

pub fn normalize_cli_scopes(csv_in &string) CliScopeRes {
    trimmed := strings.trim_space(csv_in)
    if trimmed.len == 0 || trimmed == "all" {
        << CliScopeRes{ok: true, scopes: cli_all_scopes()}
    }
    parts := strings.split(&trimmed, ",")
    $out := []string{}
    for i in 0:parts.len {
        s := strings.trim_space(&parts[i])
        if s == "all" {
            << CliScopeRes{ok: true, scopes: cli_all_scopes()}
        }
        if !cli_valid_scope(s + "") {
            << CliScopeRes{ok: false, scopes: []string{}}
        }
        $seen := false
        for j in 0:out.len {
            if out[j] == s {
                seen = true
                <-
            }
        }
        if !seen { out.push(s) }
    }
    $i := 0
    while i < out.len {
        $j := i + 1
        while j < out.len {
            if strings.compare(&out[j], &out[i]) < 0 {
                tmp := out[i] + ""
                out[i] = out[j] + ""
                out[j] = tmp
            }
            j += 1
        }
        i += 1
    }
    << CliScopeRes{ok: true, scopes: out}
}

pub fn cli_scopes_json_array(scopes &[]string) string {
    $qs := []string{}
    for i in 0:scopes.len { qs.push(json.quote(&scopes[i])) }
    << "[" + strings.join(qs, ",") + "]"
}

pub fn cli_canon_enrollment(controller_id string, ckv int, cred_id string, exp int, iat int, lbl string, scopes &[]string) string {
    << "{\"controller_id\":" + json.quote(&controller_id) +
        ",\"controller_key_version\":" + strconv.itoa(ckv) +
        ",\"cred_id\":" + json.quote(&cred_id) +
        ",\"expires_at\":" + strconv.itoa(exp) +
        ",\"issued_at\":" + strconv.itoa(iat) +
        ",\"kind\":\"enrollment\"" +
        ",\"label\":" + json.quote(&lbl) +
        ",\"scopes\":" + cli_scopes_json_array(scopes) + "}"
}

pub fn cli_canon_binding(fp string, controller_id string, cred_id string, ts int) string {
    << "{\"agent_pub_fp\":" + json.quote(&fp) +
        ",\"controller_id\":" + json.quote(&controller_id) +
        ",\"cred_id\":" + json.quote(&cred_id) +
        ",\"timestamp\":" + strconv.itoa(ts) + "}"
}

pub fn cli_canon_agent_cert(aid string, akv int, fp string, controller_id string, ckv int, cred_id string, exp int, iat int, lbl string, scopes &[]string) string {
    << "{\"agent_id\":" + json.quote(&aid) +
        ",\"agent_key_version\":" + strconv.itoa(akv) +
        ",\"agent_pub_fp\":" + json.quote(&fp) +
        ",\"controller_id\":" + json.quote(&controller_id) +
        ",\"controller_key_version\":" + strconv.itoa(ckv) +
        ",\"cred_id\":" + json.quote(&cred_id) +
        ",\"expires_at\":" + strconv.itoa(exp) +
        ",\"issued_at\":" + strconv.itoa(iat) +
        ",\"kind\":\"agent_cert\"" +
        ",\"label\":" + json.quote(&lbl) +
        ",\"scopes\":" + cli_scopes_json_array(scopes) + "}"
}

pub fn cli_canon_adoption(aid string, fp string, controller_id string, ts int) string {
    << "{\"agent_id\":" + json.quote(&aid) +
        ",\"agent_pub_fp\":" + json.quote(&fp) +
        ",\"controller_id\":" + json.quote(&controller_id) +
        ",\"timestamp\":" + strconv.itoa(ts) + "}"
}

pub fn cmd_ctl(opts &CliOpts, args []string) int {
    if args.len < 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl <2fa|pair|cred|agents|grant|suspend|resume|revoke|policy|soul|rules|human> ...", 0, EXIT_USAGE)
    }
    sub := args[0] + ""
    $rest := []string{}
    for i in 1:args.len { rest.push(args[i] + "") }

    if sub == "2fa" {
        << cmd_ctl_2fa(opts, rest)
    }
    if sub == "pair" {
        << cmd_ctl_pair(opts, rest)
    }

    if sub == "cred" {
        if rest.len < 1 || rest[0] != "issue" {
            << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl cred issue [--label ...] [--scopes all|csv] [--ttl 30d] [--out <file>]", 0, EXIT_USAGE)
        }
        $fs := flag.new_set("ctl cred issue")
        fs.define_string("label", "", "credential label")
        fs.define_string("scopes", "all", "comma-separated capability scopes or all")
        fs.define_string("ttl", "30d", "credential lifetime (e.g. 30d, 12h)")
        fs.define_string("out", "", "output file path")
        pr := parse_flags(opts, $&fs, slice_args(&rest, 1), false, "usage: fatext ctl cred issue [--label ...] [--scopes all|csv] [--ttl 30d] [--out <file>]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }

        lbl := fs.get_string("label")
        scopes_in := fs.get_string("scopes")
        ttl_s := fs.get_string("ttl")
        out_path := fs.get_string("out")
        sr := normalize_cli_scopes(&scopes_in)
        if !sr.ok { << emit_err(opts, "ERR_USAGE", 0, "invalid scopes: " + scopes_in, 0, EXIT_USAGE) }
        ttl := parse_ttl_seconds(&ttl_s)
        if ttl < 0 { << emit_err(opts, "ERR_USAGE", 0, "invalid ttl: " + ttl_s, 0, EXIT_USAGE) }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        iat := time.now_time().unix()
        $exp := 0
        if ttl > 0 { exp = iat + ttl }
        ul := new_ulid() or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        cid := "cred_" + ul
        canon_pl := cli_canon_enrollment(cfg.agent_id + "", cfg.key_version, cid + "", exp, iat, lbl + "", &sr.scopes)
        csig := sign_pss_message(&priv, &canon_pl) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        voucher := "{\"payload\":" + canon_pl + ",\"controller_sig\":" + json.quote(&csig) + "}\n"
        if out_path.len > 0 {
            write_atomic_mode(out_path + "", &voucher, 384) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
            if opts.json_mode {
                println("{\"ok\":true,\"cred_id\":" + json.quote(&cid) + ",\"controller_id\":" + json.quote(&cfg.agent_id) + ",\"out\":" + json.quote(&out_path) + ",\"expires_at\":" + strconv.itoa(exp) + "}")
            } else {
                println("issued enrollment credential " + cid + " -> " + out_path)
            }
        } else {
            println(strings.trim_space(&voucher))
        }
        << EXIT_OK
    }

    if sub == "agents" {
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        empty := ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/ctl/agents", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if opts.json_mode {
            println(r.body)
            << EXIT_OK
        }
        ldoc := json.parse(&r.body)
        if !ldoc.ok() || !ldoc.has(ldoc.root(), "agents") || !ldoc.is_list(ldoc.get(ldoc.root(), "agents")) {
            println(r.body)
            << EXIT_OK
        }
        arr := ldoc.get(ldoc.root(), "agents")
        for ai in 0:ldoc.count(arr) {
            el := ldoc.at(arr, ai)
            if !ldoc.is_dict(el) { -> }
            aid_s := json_str_or(&ldoc, ldoc.get(el, "agent_id"), "")
            nm_s := json_str_or(&ldoc, ldoc.get(el, "name"), "")
            lb_s := json_str_or(&ldoc, ldoc.get(el, "label"), "")
            ost_s := json_str_or(&ldoc, ldoc.get(el, "ownership_status"), "")
            ast_s := json_str_or(&ldoc, ldoc.get(el, "agent_status"), "")
            scs_s := json_encode_or(&ldoc, ldoc.get(el, "scopes"), "[]")
            $nm_part := ""
            if nm_s.len > 0 { nm_part = " name=" + json.quote(&nm_s) }
            $lb_part := ""
            if lb_s.len > 0 { lb_part = " label=" + json.quote(&lb_s) }
            println(aid_s + nm_part + lb_part + " status=" + ast_s + "/" + ost_s + " scopes=" + scs_s)
        }
        << EXIT_OK
    }

    if sub == "grant" {
        $fs := flag.new_set("ctl grant")
        fs.define_string("label", "", "credential label")
        fs.define_string("scopes", "all", "comma-separated capability scopes or all")
        fs.define_string("ttl", "30d", "credential lifetime (e.g. 30d, 12h)")
        fs.define_string("proof", "", "adoption proof file")
        pr := parse_flags(opts, $&fs, rest, true, "usage: fatext ctl grant <agent_id> [--scopes ...] [--ttl 30d] [--label ...] [--proof <file>]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl grant <agent_id> [--scopes ...] [--ttl 30d] [--label ...] [--proof <file>]", 0, EXIT_USAGE) }
        aid := pos[0] + ""
        lbl := fs.get_string("label")
        scopes_in := fs.get_string("scopes")
        ttl_s := fs.get_string("ttl")
        proof_path := fs.get_string("proof")
        sr := normalize_cli_scopes(&scopes_in)
        if !sr.ok { << emit_err(opts, "ERR_USAGE", 0, "invalid scopes: " + scopes_in, 0, EXIT_USAGE) }
        ttl := parse_ttl_seconds(&ttl_s)
        if ttl < 0 { << emit_err(opts, "ERR_USAGE", 0, "invalid ttl: " + ttl_s, 0, EXIT_USAGE) }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }

        afk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, aid + "")
        if !afk.ok { << emit_err(opts, afk.err_code + "", 0, afk.err_msg + "", 0, afk.exit_code) }
        afp := pubkey_fingerprint(&afk.pub_pem)
        iat := time.now_time().unix()
        $exp := 0
        if ttl > 0 { exp = iat + ttl }
        ul := new_ulid() or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
        cid := "cred_" + ul
        canon_cert := cli_canon_agent_cert(aid + "", afk.key_version, afp + "", cfg.agent_id + "", cfg.key_version, cid + "", exp, iat, lbl + "", &sr.scopes)
        csig := sign_pss_message(&priv, &canon_cert) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }

        $body := "{\"payload\":" + canon_cert + ",\"controller_sig\":" + json.quote(&csig)
        if proof_path.len > 0 {
            praw := os.read(proof_path + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
            body = body + ",\"adoption_proof\":" + strings.trim_space(&praw)
        }
        body = body + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/ctl/agents/" + aid + "/credential", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }

    if sub == "suspend" {
        $fs := flag.new_set("ctl suspend")
        fs.define_string("reason", "", "suspension reason")
        pr := parse_flags(opts, $&fs, rest, true, "usage: fatext ctl suspend <agent_id> [--reason ...]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl suspend <agent_id> [--reason ...]", 0, EXIT_USAGE) }
        aid := pos[0] + ""
        reason := fs.get_string("reason")
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        body := "{\"reason\":" + json.quote(&reason) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/ctl/agents/" + aid + "/suspend", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }

    if sub == "resume" {
        if rest.len < 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl resume <agent_id>", 0, EXIT_USAGE) }
        aid := rest[0] + ""
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        body := "{}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/ctl/agents/" + aid + "/resume", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }

    if sub == "revoke" {
        $fs := flag.new_set("ctl revoke")
        fs.define_bool("confirm", false, "confirm permanent revocation")
        fs.define_string("successor", "", "optional successor agent_id")
        fs.define_string("reason", "", "revocation reason")
        pr := parse_flags(opts, $&fs, rest, true, "usage: fatext ctl revoke <agent_id> [--successor <id>] [--reason ...] --confirm")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl revoke <agent_id> [--successor <id>] [--reason ...] --confirm", 0, EXIT_USAGE) }
        aid := pos[0] + ""
        succ := fs.get_string("successor")
        reason := fs.get_string("reason")
        confirm := fs.get_bool("confirm")
        if !confirm { << emit_err(opts, "ERR_CONFIRM_REQUIRED", 0, "permanent revocation requires --confirm", 0, EXIT_USAGE) }
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        $succ_json := "null"
        if succ.len > 0 { succ_json = json.quote(&succ) }
        body := "{\"successor_id\":" + succ_json + ",\"reason\":" + json.quote(&reason) + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/ctl/agents/" + aid + "/revoke", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }

    if sub == "policy" {
        $fs := flag.new_set("ctl policy")
        fs.define_string("name", "", "agent display name")
        fs.define_string("dm-policy", "", "DM policy")
        fs.define_string("accept-email", "", "accept email (true|false)")
        fs.define_bool("clear-webhook", false, "clear webhook URL")
        pr := parse_flags(opts, $&fs, rest, true, "usage: fatext ctl policy <agent_id> [--name ...] [--dm-policy ...] [--accept-email true|false] [--clear-webhook]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl policy <agent_id> [--name ...] [--dm-policy ...] [--accept-email true|false] [--clear-webhook]", 0, EXIT_USAGE) }
        aid := pos[0] + ""
        has_name := fs.is_set("name")
        aname := fs.get_string("name")
        has_dmp := fs.is_set("dm-policy")
        dmp := fs.get_string("dm-policy")
        has_ae := fs.is_set("accept-email")
        $ae := false
        if has_ae {
            ae_raw := fs.get_string("accept-email")
            pb := parse_bool_str(&ae_raw, true)
            if pb < 0 { << emit_err(opts, "ERR_USAGE", 0, "--accept-email must be true or false", 0, EXIT_USAGE) }
            ae = (pb == 1)
        }
        clear_wh := fs.get_bool("clear-webhook")
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        $parts := []string{}
        if has_name { parts.push("\"name\":" + json.quote(&aname)) }
        if has_dmp { parts.push("\"dm_policy\":" + json.quote(&dmp)) }
        if has_ae {
            $ae_s := "false"
            if ae { ae_s = "true" }
            parts.push("\"accept_email\":" + ae_s)
        }
        if clear_wh { parts.push("\"clear_webhook\":true") }
        body := "{" + join_ref(&parts, ",") + "}"
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "PUT", "/v1/ctl/agents/" + aid + "/policy", &body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        println(r.body)
        << EXIT_OK
    }

    if sub == "soul" || sub == "rules" {
        << cmd_ctl_doc(opts, sub + "", rest)
    }

    if sub == "human" {
        << cmd_ctl_human(opts, rest)
    }

    << emit_err(opts, "ERR_USAGE", 0, "unknown ctl subcommand: " + sub, 0, EXIT_USAGE)
}

pub fn cmd_claim_proof(opts &CliOpts, args []string) int {
    $fs := flag.new_set("claim-proof")
    fs.define_string("out", "", "output file path")
    pr := parse_flags(opts, $&fs, args, true, "usage: fatext claim-proof <controller_id> [--out <file>]")
    if pr == FLAG_HELP { << EXIT_OK }
    if pr != FLAG_OK { << EXIT_USAGE }
    pos := fs.args()
    if pos.len != 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext claim-proof <controller_id> [--out <file>]", 0, EXIT_USAGE) }
    cid := pos[0] + ""
    if !is_valid_agent_id(cid + "") { << emit_err(opts, "ERR_USAGE", 0, "invalid controller_id", 0, EXIT_USAGE) }
    out_path := fs.get_string("out")

    cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    pub_pem := encode_spki_public_pem(&priv.public) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
    fp := pubkey_fingerprint(&pub_pem)
    ts := time.now_time().unix()
    pl := cli_canon_adoption(cfg.agent_id + "", fp + "", cid + "", ts)
    asig := sign_pss_message(&priv, &pl) or (err) { << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO) }
    proof := "{\"payload\":" + pl + ",\"agent_sig\":" + json.quote(&asig) + "}\n"
    if out_path.len > 0 {
        write_atomic_mode(out_path + "", &proof, 384) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        if opts.json_mode {
            println("{\"ok\":true,\"agent_id\":" + json.quote(&cfg.agent_id) + ",\"controller_id\":" + json.quote(&cid) + ",\"out\":" + json.quote(&out_path) + "}")
        } else {
            println("wrote adoption proof -> " + out_path)
        }
    } else {
        println(strings.trim_space(&proof))
    }
    << EXIT_OK
}

pub fn cli_find_key_for_ver(doc &json.Doc, want_ver int, cur_ver int, cur_pem &string) string {
    if want_ver == cur_ver { << cur_pem + "" }
    rt := doc.root()
    if !doc.has(rt, "key_history") || !doc.is_list(doc.get(rt, "key_history")) { << "" }
    kh := doc.get(rt, "key_history")
    for i in 0:doc.count(kh) {
        el := doc.at(kh, i)
        if doc.is_dict(el) && json_int_or(doc, doc.get(el, "version"), 0) == want_ver {
            << json_str_or(doc, doc.get(el, "public_key_pem"), "")
        }
    }
    << ""
}

pub fn cli_verify_agent_rotations(cdoc &json.Doc, cid string, cur_ver int, cur_pem &string, errs $&[]string) {
    if cur_ver <= 1 { << }
    rt := cdoc.root()
    if !cdoc.has(rt, "key_history") || !cdoc.is_list(cdoc.get(rt, "key_history")) {
        errs.push("key_history missing for version v" + strconv.itoa(cur_ver))
        <<
    }
    kh := cdoc.get(rt, "key_history")
    cnt := doc_count(cdoc, kh)
    for ver in 1:cur_ver {
        $el_idx := -1
        for i in 0:cnt {
            el := cdoc.at(kh, i)
            if cdoc.is_dict(el) && json_int_or(cdoc, cdoc.get(el, "version"), 0) == ver {
                el_idx = i
                <-
            }
        }
        if el_idx < 0 {
            errs.push("missing key_history entry v" + strconv.itoa(ver))
            ->
        }
        el := cdoc.at(kh, el_idx)
        osig := json_str_or(cdoc, cdoc.get(el, "rotated_by_old_sig"), "")
        nsig := json_str_or(cdoc, cdoc.get(el, "rotated_by_new_sig"), "")
        if osig.len == 0 || nsig.len == 0 {
            errs.push("missing key rotation signatures for v" + strconv.itoa(ver))
            ->
        }
        old_pem := json_str_or(cdoc, cdoc.get(el, "public_key_pem"), "")
        vu := json_int_or(cdoc, cdoc.get(el, "valid_until"), 0)
        next_pem := cli_find_key_for_ver(cdoc, ver + 1, cur_ver, cur_pem)
        old_pk := decode_spki_public_pem(&old_pem) or (err) {
            errs.push("invalid historical key v" + strconv.itoa(ver))
            ->
        }
        if next_pem.len == 0 {
            errs.push("missing next key in chain v" + strconv.itoa(ver + 1))
            ->
        }
        next_pk := decode_spki_public_pem(&next_pem) or (err) {
            errs.push("invalid next key v" + strconv.itoa(ver + 1))
            ->
        }
        $matched := false
        for dt in -60:61 {
            cand := "{\"agent_id\":" + json.quote(&cid) + ",\"key_version\":" + strconv.itoa(ver + 1) + ",\"new_public_key_pem\":" + json.quote(&next_pem) + ",\"timestamp\":" + strconv.itoa(vu + dt) + "}"
            if verify_pss_message(&old_pk, &cand, osig + "") && verify_pss_message(&next_pk, &cand, nsig + "") {
                matched = true
                <-
            }
        }
        if !matched {
            errs.push("key rotation signature link v" + strconv.itoa(ver) + "->v" + strconv.itoa(ver + 1) + " failed")
        }
    }
}

fn cli_verify_pem_sig(pem &string, msg &string, sig string) bool {
    pk := decode_spki_public_pem(pem) or (err) { << false }
    << verify_pss_message(&pk, msg, sig)
}

fn doc_count(doc &json.Doc, n int) int {
    << doc.count(n)
}

fn cli_verify_agent_binding(
    aid string,
    afk &FetchedKey,
    adoc &json.Doc,
    on int,
    kind string,
    ctrl_id string,
    cid string,
    absig string
) string {
    ar := adoc.root()
    if !adoc.has(on, "agent_binding") || adoc.is_null(adoc.get(on, "agent_binding")) || !adoc.is_dict(adoc.get(on, "agent_binding")) {
        << "missing agent_binding"
    }
    ab := adoc.get(on, "agent_binding")
    if json_has_str(adoc, ab, "controller_id", "") != ctrl_id {
        << "agent_binding controller_id mismatch"
    }
    ab_fp := json_str_or(adoc, adoc.get(ab, "agent_pub_fp"), "")
    ab_ts := json_int_or(adoc, adoc.get(ab, "timestamp"), 0)
    $bind_pem := ""
    if pubkey_fingerprint(&afk.pub_pem) == ab_fp {
        bind_pem = afk.pub_pem + ""
    } else if adoc.has(ar, "key_history") && adoc.is_list(adoc.get(ar, "key_history")) {
        kh := adoc.get(ar, "key_history")
        for i in 0:adoc.count(kh) {
            el := adoc.at(kh, i)
            kpem := json_str_or(adoc, adoc.get(el, "public_key_pem"), "")
            if pubkey_fingerprint(&kpem) == ab_fp {
                bind_pem = kpem
                <-
            }
        }
    }
    if bind_pem.len == 0 {
        << "agent_binding fingerprint key missing from agent"
    }
    $canon_b := ""
    if kind == "enrollment" {
        canon_b = cli_canon_binding(ab_fp + "", ctrl_id + "", cid + "", ab_ts)
    } else {
        ab_cid := json_has_str(adoc, ab, "cred_id", "")
        if ab_cid.len > 0 {
            if !is_valid_cred_id(ab_cid + "") {
                << "invalid agent_binding cred_id"
            }
            canon_b = cli_canon_binding(ab_fp + "", ctrl_id + "", ab_cid + "", ab_ts)
        } else {
            if json_has_str(adoc, ab, "agent_id", "") != aid {
                << "agent_binding agent_id mismatch"
            }
            canon_b = cli_canon_adoption(aid + "", ab_fp + "", ctrl_id + "", ab_ts)
        }
    }
    if canon_b.len == 0 || !cli_verify_pem_sig(&bind_pem, &canon_b, absig + "") {
        << "agent_binding_sig verification failed"
    }
    << ""
}

pub fn cli_verify_controller_binding_for_doc(
    aid string,
    afk &FetchedKey,
    adoc &json.Doc,
    expected_ctrl_id string,
    cfk &FetchedKey,
    cdoc &json.Doc
) string {
    if afk.status != "active" {
        << "agent status is " + afk.status
    }
    if cfk.status != "active" {
        << "controller status is " + cfk.status
    }
    $arot_errs := []string{}
    cli_verify_agent_rotations(adoc, aid + "", afk.key_version, &afk.pub_pem, $&arot_errs)
    if arot_errs.len > 0 {
        << arot_errs[0] + ""
    }
    ar := adoc.root()
    if !adoc.is_dict(ar) || !adoc.has(ar, "ownership") || adoc.is_null(adoc.get(ar, "ownership")) {
        << "agent does not declare controller ownership"
    }
    on := adoc.get(ar, "ownership")
    if !adoc.is_dict(on) { << "invalid agent ownership object" }
    ctrl_id := json_has_str(adoc, on, "controller_id", "")
    if ctrl_id != expected_ctrl_id || !is_valid_agent_id(ctrl_id + "") {
        << "ownership controller_id mismatch: expected " + expected_ctrl_id + ", got " + ctrl_id
    }
    ost := json_has_str(adoc, on, "status", "")
    if ost != "active" {
        << "ownership status is " + ost
    }
    ckv := json_has_int(adoc, on, "controller_key_version", 0)
    cid := json_has_str(adoc, on, "cred_id", "")
    kind := json_has_str(adoc, on, "kind", "")
    lbl := json_has_str(adoc, on, "label", "")
    iat := json_has_int(adoc, on, "issued_at", 0)
    exp := json_has_int(adoc, on, "expires_at", 0)
    if exp > 0 && time.now_time().unix() > exp {
        << "credential expired"
    }
    csig := json_has_str(adoc, on, "controller_sig", "")
    absig := json_has_str(adoc, on, "agent_binding_sig", "")

    $scopes := []string{}
    if adoc.has(on, "scopes") && adoc.is_list(adoc.get(on, "scopes")) {
        sa := adoc.get(on, "scopes")
        for i in 0:adoc.count(sa) { scopes.push(json_str_or(adoc, adoc.at(sa, i), "")) }
    }

    cr := cdoc.root()
    if !cdoc.is_dict(cr) { << "invalid controller json" }
    if cdoc.has(cr, "ownership") && !cdoc.is_null(cdoc.get(cr, "ownership")) {
        << "controller itself has ownership (violates 1-hop hierarchy)"
    }
    $rot_errs := []string{}
    cli_verify_agent_rotations(cdoc, ctrl_id + "", cfk.key_version, &cfk.pub_pem, $&rot_errs)
    if rot_errs.len > 0 {
        << rot_errs[0] + ""
    }
    cpem := cli_find_key_for_ver(cdoc, ckv, cfk.key_version, &cfk.pub_pem)
    if cpem.len == 0 {
        << "controller key version v" + strconv.itoa(ckv) + " missing"
    }
    $canon_pl := ""
    if kind == "enrollment" {
        canon_pl = cli_canon_enrollment(ctrl_id + "", ckv, cid + "", exp, iat, lbl + "", &scopes)
    } else if kind == "agent_cert" {
        if !adoc.has(on, "payload") || !adoc.is_dict(adoc.get(on, "payload")) {
            << "missing agent_cert payload"
        }
        pl := adoc.get(on, "payload")
        akv := json_int_or(adoc, adoc.get(pl, "agent_key_version"), 0)
        afp := json_str_or(adoc, adoc.get(pl, "agent_pub_fp"), "")
        apem_ver := cli_find_key_for_ver(adoc, akv, afk.key_version, &afk.pub_pem)
        if apem_ver.len == 0 {
            << "agent_cert agent_key_version v" + strconv.itoa(akv) + " missing from agent"
        }
        if pubkey_fingerprint(&apem_ver) != afp {
            << "agent_cert fingerprint does not match agent key"
        }
        canon_pl = cli_canon_agent_cert(aid + "", akv, afp + "", ctrl_id + "", ckv, cid + "", exp, iat, lbl + "", &scopes)
    } else {
        << "unknown ownership kind: " + kind
    }
    if canon_pl.len == 0 || !cli_verify_pem_sig(&cpem, &canon_pl, csig + "") {
        << "controller_sig verification failed"
    }
    $in_roster := false
    if cdoc.has(cr, "managed_agents") && cdoc.is_list(cdoc.get(cr, "managed_agents")) {
        arr := cdoc.get(cr, "managed_agents")
        for i in 0:cdoc.count(arr) {
            el := cdoc.at(arr, i)
            if cdoc.is_dict(el) && json_str_or(cdoc, cdoc.get(el, "agent_id"), "") == aid &&
               json_str_or(cdoc, cdoc.get(el, "cred_id"), "") == cid {
                in_roster = true
                <-
            }
        }
    }
    if !in_roster {
        << "agent credential not listed in controller managed_agents roster"
    }
    << cli_verify_agent_binding(aid + "", afk, adoc, on, kind + "", ctrl_id + "", cid + "", absig + "")
}

pub fn cmd_verify(opts &CliOpts, args []string) int {
    if args.len < 1 { << emit_err(opts, "ERR_USAGE", 0, "usage: fatext verify <agent_id>", 0, EXIT_USAGE) }
    aid := args[0] + ""
    if !is_valid_agent_id(aid + "") { << emit_err(opts, "ERR_USAGE", 0, "invalid agent_id", 0, EXIT_USAGE) }

    api_base := resolve_api_base(opts, "")
    cfg_opt := load_config_or_base(opts, api_base + "")
    afk := fetch_agent_key(cfg_opt.api_base + "", opts.timeout_sec, aid + "")
    if !afk.ok { << emit_err(opts, afk.err_code + "", 0, afk.err_msg + "", 0, afk.exit_code) }

    adoc := json.parse(&afk.raw_json)
    if !adoc.ok() { << emit_err(opts, "ERR_CRYPTO", 0, "invalid agent json", 0, EXIT_CRYPTO) }
    ar := adoc.root()
    $errs := []string{}
    if afk.status != "active" {
        errs.push("agent status is " + afk.status)
    }
    cli_verify_agent_rotations(&adoc, aid + "", afk.key_version, &afk.pub_pem, $&errs)

    now := time.now_time().unix()
    if !adoc.has(ar, "ownership") || adoc.is_null(adoc.get(ar, "ownership")) {
        $valid := errs.len == 0
        $vs := "false"
        if valid { vs = "true" }
        $err_qs := []string{}
        for i in 0:errs.len { err_qs.push(json.quote(&errs[i])) }
        if opts.json_mode {
            println("{\"chain_valid\":" + vs + ",\"autonomous\":true,\"agent_id\":" + json.quote(&aid) + ",\"agent_status\":" + json.quote(&afk.status) + ",\"errors\":[" + join_ref(&err_qs, ",") + "]}")
        } else {
            println("agent_id=" + aid + " autonomous=true chain_valid=" + vs + " status=" + afk.status)
        }
        if valid { << EXIT_OK }
        << EXIT_CRYPTO
    }

    on := adoc.get(ar, "ownership")
    ctrl_id := json_str_or(&adoc, adoc.get(on, "controller_id"), "")
    ckv := json_int_or(&adoc, adoc.get(on, "controller_key_version"), 0)
    cid := json_str_or(&adoc, adoc.get(on, "cred_id"), "")
    kind := json_str_or(&adoc, adoc.get(on, "kind"), "")
    lbl := json_str_or(&adoc, adoc.get(on, "label"), "")
    ost := json_str_or(&adoc, adoc.get(on, "status"), "")
    iat := json_int_or(&adoc, adoc.get(on, "issued_at"), 0)
    exp := json_int_or(&adoc, adoc.get(on, "expires_at"), 0)
    csig := json_str_or(&adoc, adoc.get(on, "controller_sig"), "")
    absig := json_str_or(&adoc, adoc.get(on, "agent_binding_sig"), "")

    $scopes := []string{}
    if adoc.has(on, "scopes") && adoc.is_list(adoc.get(on, "scopes")) {
        sa := adoc.get(on, "scopes")
        for i in 0:adoc.count(sa) { scopes.push(json_str_or(&adoc, adoc.at(sa, i), "")) }
    }

    if ost != "active" { errs.push("ownership status is " + ost) }
    if exp > 0 && now > exp { errs.push("credential expired") }

    $cst := "unknown"
    if !is_valid_agent_id(ctrl_id + "") {
        errs.push("invalid ownership controller_id")
    } else {
        cfk := fetch_agent_key(cfg_opt.api_base + "", opts.timeout_sec, ctrl_id + "")
        if !cfk.ok {
            errs.push("failed fetching controller " + ctrl_id + ": " + cfk.err_msg)
        } else {
            cst = cfk.status + ""
            if cfk.status != "active" { errs.push("controller status is " + cfk.status) }
            cdoc := json.parse(&cfk.raw_json)
            if !cdoc.ok() {
                errs.push("invalid controller json")
            } else {
                cr := cdoc.root()
                if cdoc.has(cr, "ownership") && !cdoc.is_null(cdoc.get(cr, "ownership")) {
                    errs.push("controller itself has ownership (violates 1-hop hierarchy)")
                }
                cli_verify_agent_rotations(&cdoc, ctrl_id + "", cfk.key_version, &cfk.pub_pem, $&errs)
                cpem := cli_find_key_for_ver(&cdoc, ckv, cfk.key_version, &cfk.pub_pem)
                if cpem.len == 0 {
                    errs.push("controller key version v" + strconv.itoa(ckv) + " missing")
                } else {
                    $canon_pl := ""
                    if kind == "enrollment" {
                        canon_pl = cli_canon_enrollment(ctrl_id + "", ckv, cid + "", exp, iat, lbl + "", &scopes)
                    } else if kind == "agent_cert" {
                        pl := adoc.get(on, "payload")
                        akv := json_int_or(&adoc, adoc.get(pl, "agent_key_version"), 0)
                        afp := json_str_or(&adoc, adoc.get(pl, "agent_pub_fp"), "")
                        apem_ver := cli_find_key_for_ver(&adoc, akv, afk.key_version, &afk.pub_pem)
                        if apem_ver.len == 0 {
                            errs.push("agent_cert agent_key_version v" + strconv.itoa(akv) + " missing from agent")
                        } else if pubkey_fingerprint(&apem_ver) != afp {
                            errs.push("agent_cert fingerprint does not match agent key")
                        }
                        canon_pl = cli_canon_agent_cert(aid + "", akv, afp + "", ctrl_id + "", ckv, cid + "", exp, iat, lbl + "", &scopes)
                    } else {
                        errs.push("unknown ownership kind: " + kind)
                    }
                    if canon_pl.len > 0 && !cli_verify_pem_sig(&cpem, &canon_pl, csig + "") {
                        errs.push("controller_sig verification failed")
                    }
                }
                // Verify roster entry in controller.managed_agents[]
                $in_roster := false
                if cdoc.has(cr, "managed_agents") && cdoc.is_list(cdoc.get(cr, "managed_agents")) {
                    arr := cdoc.get(cr, "managed_agents")
                    for i in 0:cdoc.count(arr) {
                        el := cdoc.at(arr, i)
                        if cdoc.is_dict(el) && json_str_or(&cdoc, cdoc.get(el, "agent_id"), "") == aid &&
                           json_str_or(&cdoc, cdoc.get(el, "cred_id"), "") == cid {
                            in_roster = true
                            <-
                        }
                    }
                }
                if !in_roster { errs.push("agent credential not listed in controller managed_agents roster") }
            }
        }
    }

    ab_err := cli_verify_agent_binding(aid + "", &afk, &adoc, on, kind + "", ctrl_id + "", cid + "", absig + "")
    if ab_err.len > 0 {
        errs.push(ab_err)
    }

    valid := errs.len == 0
    $vs := "false"
    if valid { vs = "true" }
    $err_qs := []string{}
    for i in 0:errs.len { err_qs.push(json.quote(&errs[i])) }
    if opts.json_mode {
        println("{\"chain_valid\":" + vs +
            ",\"autonomous\":false" +
            ",\"controller_id\":" + json.quote(&ctrl_id) +
            ",\"controller_status\":" + json.quote(&cst) +
            ",\"cred_id\":" + json.quote(&cid) +
            ",\"kind\":" + json.quote(&kind) +
            ",\"scopes\":" + cli_scopes_json_array(&scopes) +
            ",\"expires_at\":" + strconv.itoa(exp) +
            ",\"agent_id\":" + json.quote(&aid) +
            ",\"agent_status\":" + json.quote(&afk.status) +
            ",\"ownership_status\":" + json.quote(&ost) +
            ",\"errors\":[" + join_ref(&err_qs, ",") + "]}")
    } else {
        println("chain_valid=" + vs + " controller_id=" + ctrl_id + " -> cred_id=" + cid + " (" + kind + ") -> agent_id=" + aid + " status=" + ost)
        for i in 0:errs.len { println("  error: " + errs[i]) }
    }
    if valid { << EXIT_OK }
    << EXIT_CRYPTO
}

@main

#crypto/rsa
#crypto/sha256
#encoding/json
#flag
#math/big
#os
#strconv
#strings
#time

pub fn cli_canon_doc_payload(
    agent_id string,
    content_sha256 string,
    kind string,
    locked bool,
    signer_id string,
    signer_key_version int,
    updated_at int,
    version int,
    visibility string
) string {
    $lck := "false"
    if locked { lck = "true" }
    << "{\"agent_id\":" + json.quote(&agent_id) +
        ",\"content_sha256\":" + json.quote(&content_sha256) +
        ",\"kind\":" + json.quote(&kind) +
        ",\"locked\":" + lck +
        ",\"signer_id\":" + json.quote(&signer_id) +
        ",\"signer_key_version\":" + strconv.itoa(signer_key_version) +
        ",\"updated_at\":" + strconv.itoa(updated_at) +
        ",\"version\":" + strconv.itoa(version) +
        ",\"visibility\":" + json.quote(&visibility) + "}"
}

struct DocVerifyOut {
    ok bool
    err string
    err_code string
    exit_code int
    agent_id string
    kind string
    version int
    visibility string
    locked bool
    locked_by string
    format string
    content_sha256 string
    content_bytes int
    content string
    signed_by string
    signer_id string
    signer_key_version int
    updated_at int
    signature string
}

fn doc_verify_fail(code string, exit_c int, msg string) DocVerifyOut {
    << DocVerifyOut{
        ok: false, err: msg, err_code: code, exit_code: exit_c,
        agent_id: "", kind: "", version: 0, visibility: "", locked: false,
        locked_by: "", format: "", content_sha256: "", content_bytes: 0,
        content: "", signed_by: "", signer_id: "", signer_key_version: 0,
        updated_at: 0, signature: ""
    }
}

fn cli_verify_doc_and_extract(
    opts &CliOpts,
    api_base string,
    expected_agent_id string,
    expected_kind string,
    role string,
    self_id string,
    home string,
    cur_kv int,
    has_priv bool,
    cur_priv &rsa.PrivateKey,
    raw_json &string
) DocVerifyOut {
    doc := json.parse(raw_json)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "invalid document json")
    }
    r := doc.root()
    aid := json_has_str(&doc, r, "agent_id", "")
    kind := json_has_str(&doc, r, "kind", "")
    ver := json_has_int(&doc, r, "version", 0)
    vis := json_has_str(&doc, r, "visibility", "")
    locked := json_has_bool(&doc, r, "locked", false)
    locked_by := json_has_str(&doc, r, "locked_by", "")
    fmt := json_has_str(&doc, r, "format", "markdown")
    csha := json_has_str(&doc, r, "content_sha256", "")
    cbytes := json_has_int(&doc, r, "content_bytes", 0)
    signed_by := json_has_str(&doc, r, "signed_by", "")
    signer_id := json_has_str(&doc, r, "signer_id", "")
    signer_kv := json_has_int(&doc, r, "signer_key_version", 0)
    uat := json_has_int(&doc, r, "updated_at", 0)
    sig := json_has_str(&doc, r, "signature", "")

    if aid.len == 0 || kind.len == 0 || ver < 1 || csha.len != 64 || sig.len == 0 {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "incomplete document metadata or signature")
    }
    if aid != expected_agent_id {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "document agent_id mismatch: expected " + expected_agent_id + ", got " + aid)
    }
    if kind != expected_kind {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "document kind mismatch: expected " + expected_kind + ", got " + kind)
    }

    // Fetch signer public key matching signer_key_version and verify signer authority
    $signer_pem := ""
    if signed_by == "agent" {
        if signer_id != expected_agent_id {
            << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "document signer_id mismatch: expected " + expected_agent_id + ", got " + signer_id)
        }
        fk := fetch_agent_key(api_base + "", opts.timeout_sec, expected_agent_id + "")
        if !fk.ok { << doc_verify_fail(fk.err_code + "", fk.exit_code, fk.err_msg + "") }
        sdoc := json.parse(&fk.raw_json)
        if !sdoc.ok() { << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "corrupt signer agent json") }
        $srot_errs := []string{}
        cli_verify_agent_rotations(&sdoc, expected_agent_id + "", fk.key_version, &fk.pub_pem, $&srot_errs)
        if srot_errs.len > 0 {
            << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, srot_errs[0] + "")
        }
        signer_pem = cli_find_key_for_ver(&sdoc, signer_kv, fk.key_version, &fk.pub_pem)
    } else if signed_by == "controller" {
        cfk := fetch_agent_key(api_base + "", opts.timeout_sec, signer_id + "")
        if !cfk.ok { << doc_verify_fail(cfk.err_code + "", cfk.exit_code, cfk.err_msg + "") }
        cdoc := json.parse(&cfk.raw_json)
        if !cdoc.ok() { << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "corrupt signer controller json") }
        afk := fetch_agent_key(api_base + "", opts.timeout_sec, expected_agent_id + "")
        if !afk.ok { << doc_verify_fail(afk.err_code + "", afk.exit_code, afk.err_msg + "") }
        adoc := json.parse(&afk.raw_json)
        if !adoc.ok() { << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "corrupt target agent json") }
        bind_err := cli_verify_controller_binding_for_doc(expected_agent_id + "", &afk, &adoc, signer_id + "", &cfk, &cdoc)
        if bind_err.len > 0 {
            << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "controller signature unauthorized: " + bind_err)
        }
        signer_pem = cli_find_key_for_ver(&cdoc, signer_kv, cfk.key_version, &cfk.pub_pem)
    } else {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "unknown document signed_by: " + signed_by)
    }
    if signer_pem.len == 0 {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "signer key v" + strconv.itoa(signer_kv) + " missing")
    }
    spk := decode_spki_public_pem(&signer_pem) or (err) {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, err.msg())
    }
    canon := cli_canon_doc_payload(aid + "", csha + "", kind + "", locked, signer_id + "", signer_kv, uat, ver, vis + "")
    if !verify_pss_message(&spk, &canon, sig + "") {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "document signature verification failed")
    }

    $plaintext := ""
    if vis == "public" {
        if !doc.has(r, "content") || doc.is_null(doc.get(r, "content")) {
            << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "missing public document content")
        }
        plaintext = json_str_or(&doc, doc.get(r, "content"), "")
        if sha256.sum256(plaintext + "") != csha {
            << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "public document sha256 mismatch")
        }
    } else if vis == "private" {
        if !has_priv {
            << doc_verify_fail("ERR_FORBIDDEN", EXIT_FORBIDDEN, "private document requires credentials to decrypt")
        }
        if !doc.has(r, "envelope") || doc.is_null(doc.get(r, "envelope")) {
            << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "missing encrypted doc envelope")
        }
        env_json := json_encode_or(&doc, doc.get(r, "envelope"), "")
        dec := decrypt_doc_envelope(role + "", self_id + "", home + "", cur_kv, cur_priv, aid + "", kind + "", ver, csha + "", &env_json)
        if !dec.ok {
            << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, dec.err + "")
        }
        plaintext = dec.plaintext
    } else {
        << doc_verify_fail("ERR_CRYPTO", EXIT_CRYPTO, "unknown visibility: " + vis)
    }

    << DocVerifyOut{
        ok: true, err: "", err_code: "", exit_code: EXIT_OK,
        agent_id: aid, kind: kind, version: ver, visibility: vis, locked: locked,
        locked_by: locked_by, format: fmt, content_sha256: csha, content_bytes: cbytes,
        content: plaintext, signed_by: signed_by, signer_id: signer_id,
        signer_key_version: signer_kv, updated_at: uat, signature: sig
    }
}

fn doc_verified_json_out(dv &DocVerifyOut) string {
    $lck := "false"
    if dv.locked { lck = "true" }
    << "{\"agent_id\":" + json.quote(&dv.agent_id) +
        ",\"kind\":" + json.quote(&dv.kind) +
        ",\"version\":" + strconv.itoa(dv.version) +
        ",\"visibility\":" + json.quote(&dv.visibility) +
        ",\"locked\":" + lck +
        ",\"locked_by\":" + json.quote(&dv.locked_by) +
        ",\"format\":" + json.quote(&dv.format) +
        ",\"content_sha256\":" + json.quote(&dv.content_sha256) +
        ",\"content_bytes\":" + strconv.itoa(dv.content_bytes) +
        ",\"signed_by\":" + json.quote(&dv.signed_by) +
        ",\"signer_id\":" + json.quote(&dv.signer_id) +
        ",\"signer_key_version\":" + strconv.itoa(dv.signer_key_version) +
        ",\"updated_at\":" + strconv.itoa(dv.updated_at) +
        ",\"verified\":true" +
        ",\"content\":" + json.quote(&dv.content) + "}"
}

fn build_signed_doc_put_body(
    api_base string,
    timeout_sec int,
    agent_id string,
    kind string,
    next_ver int,
    vis string,
    locked bool,
    fmt string,
    plaintext &string,
    signer_priv &rsa.PrivateKey,
    signer_id string,
    signer_kv int
) ApiResp {
    csha := sha256.sum256(plaintext + "")
    uat := time.now_time().unix()
    $env_json := ""
    if vis == "private" {
        afk := fetch_agent_key(api_base + "", timeout_sec, agent_id + "")
        if !afk.ok {
            << empty_api_err(false, afk.err_code + "", afk.err_msg + "")
        }
        $has_ctrl := false
        $cid := ""
        $ckv := 1
        $cpem := ""
        adoc := json.parse(&afk.raw_json)
        if adoc.ok() && adoc.has(adoc.root(), "ownership") && !adoc.is_null(adoc.get(adoc.root(), "ownership")) {
            on := adoc.get(adoc.root(), "ownership")
            if adoc.is_dict(on) {
                oc := json_str_or(&adoc, adoc.get(on, "controller_id"), "")
                if oc.len > 0 {
                    if !is_valid_agent_id(oc + "") {
                        << empty_api_err(false, "ERR_CRYPTO", "invalid ownership controller_id")
                    }
                    cfk := fetch_agent_key(api_base + "", timeout_sec, oc + "")
                    if !cfk.ok {
                        << empty_api_err(false, cfk.err_code + "", "failed fetching controller key: " + cfk.err_msg)
                    }
                    cdoc := json.parse(&cfk.raw_json)
                    if !cdoc.ok() {
                        << empty_api_err(false, "ERR_CRYPTO", "corrupt controller json")
                    }
                    bind_err := cli_verify_controller_binding_for_doc(agent_id + "", &afk, &adoc, oc + "", &cfk, &cdoc)
                    if bind_err.len > 0 {
                        << empty_api_err(false, "ERR_CRYPTO", "controller binding verification failed: " + bind_err)
                    }
                    has_ctrl = true
                    cid = oc
                    ckv = cfk.key_version
                    cpem = cfk.pub_pem + ""
                }
            }
        }
        if has_ctrl {
            cpk := decode_spki_public_pem(&cpem) or (err) {
                << empty_api_err(false, "ERR_CRYPTO", err.msg())
            }
            env_json = encrypt_doc_envelope(
                agent_id + "", kind + "", next_ver, csha + "", plaintext,
                afk.key_version, &afk.pk, true, cid + "", ckv, &cpk
            ) or (err) {
                << empty_api_err(false, "ERR_CRYPTO", err.msg())
            }
        } else {
            env_json = encrypt_doc_envelope(
                agent_id + "", kind + "", next_ver, csha + "", plaintext,
                afk.key_version, &afk.pk, false, "", 0, &afk.pk
            ) or (err) {
                << empty_api_err(false, "ERR_CRYPTO", err.msg())
            }
        }
    }

    canon := cli_canon_doc_payload(agent_id + "", csha + "", kind + "", locked, signer_id + "", signer_kv, uat, next_ver, vis + "")
    sig := sign_pss_message(signer_priv, &canon) or (err) {
        << empty_api_err(false, "ERR_CRYPTO", err.msg())
    }

    $lck := "false"
    if locked { lck = "true" }
    $body := "{\"version\":" + strconv.itoa(next_ver) +
        ",\"visibility\":" + json.quote(&vis) +
        ",\"locked\":" + lck +
        ",\"format\":" + json.quote(&fmt) +
        ",\"content_sha256\":" + json.quote(&csha)
    if vis == "public" {
        body = body + ",\"content\":" + json.quote(plaintext)
    } else {
        body = body + ",\"content_bytes\":" + strconv.itoa(plaintext.len) + ",\"envelope\":" + env_json
    }
    body = body + ",\"updated_at\":" + strconv.itoa(uat) + ",\"signature\":" + json.quote(&sig) + "}"
    << ApiResp{ok: true, status: 200, retry_after: 0, reset_at: 0, required_bits: 0, err_code: "", err_msg: "", receipt: "", review_date: "", review_status: "", body: body, net_err: false}
}

fn cli_dummy_priv() rsa.PrivateKey {
    << rsa.PrivateKey{public: rsa.PublicKey{n: big.new_int(0), e: 65537}, d: big.new_int(0), p: big.new_int(0), q: big.new_int(0)}
}

fn emit_doc_output(opts &CliOpts, kind string, out_path string, dv &DocVerifyOut) int {
    if out_path.len > 0 {
        $mode := 420
        if dv.visibility == "private" { mode = 384 }
        write_atomic_mode(out_path + "", &dv.content, mode) or (err) {
            << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
        }
        if opts.json_mode {
            println(doc_verified_json_out(dv))
        } else {
            println("wrote " + kind + " v" + strconv.itoa(dv.version) + " -> " + out_path)
        }
        << EXIT_OK
    }
    if opts.json_mode {
        println(doc_verified_json_out(dv))
        << EXIT_OK
    }
    c := dv.content + ""
    if c.len > 0 && (c[c.len - 1] & 255) == 10 {
        println(c[0:(c.len - 1)])
    } else {
        println(c)
    }
    << EXIT_OK
}

fn doc_status_print(opts &CliOpts, raw &string) {
    if opts.json_mode {
        println(raw + "")
        <<
    }
    doc := json.parse(raw)
    if !doc.ok() {
        println(raw + "")
        <<
    }
    rt := doc.root()
    aid := json_str_or(&doc, doc.get(rt, "agent_id"), "")
    println("agent_id=" + aid)
    kinds := ["soul", "rules"]
    for i in 0:2 {
        k := kinds[i] + ""
        if !doc.has(rt, k + "") || doc.is_null(doc.get(rt, k + "")) {
            println("  " + k + ": (none)")
        } else {
            kn := doc.get(rt, k + "")
            ver := json_int_or(&doc, doc.get(kn, "version"), 0)
            vis := json_str_or(&doc, doc.get(kn, "visibility"), "")
            lck := json_bool_or(&doc, doc.get(kn, "locked"), false)
            cb := json_int_or(&doc, doc.get(kn, "content_bytes"), 0)
            sb := json_str_or(&doc, doc.get(kn, "signed_by"), "")
            sid := json_str_or(&doc, doc.get(kn, "signer_id"), "")
            $ls := "unlocked"
            if lck { ls = "locked" }
            println("  " + k + ": v" + strconv.itoa(ver) + " " + vis + " " + ls + " bytes=" + strconv.itoa(cb) + " signer=" + sb + ":" + sid)
        }
    }
}

pub fn cmd_doc(opts &CliOpts, kind string, args []string) int {
    if args.len < 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext " + kind + " <set|get|pull|status|rm> ...", 0, EXIT_USAGE)
    }
    sub := args[0] + ""
    $rest := []string{}
    for i in 1:args.len { rest.push(args[i] + "") }

    if sub == "set" {
        $fs := flag.new_set(kind + " set")
        fs.define_bool("public", false, "make document public")
        fs.define_bool("private", false, "make document private")
        fs.define_string("format", "markdown", "document format (markdown|text)")
        fs.define_string("text", "", "inline document text")
        pr := parse_flags(opts, $&fs, rest, true, "usage: fatext " + kind + " set [<file|->] [--text <str>] [--public|--private] [--format markdown|text]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        if fs.is_set("public") && fs.is_set("private") {
            << emit_err(opts, "ERR_USAGE", 0, "--public and --private are mutually exclusive", 0, EXIT_USAGE)
        }
        pos := fs.args()
        if pos.len > 1 {
            << emit_err(opts, "ERR_USAGE", 0, "unexpected argument: " + pos[1], 0, EXIT_USAGE)
        }
        $vis := "public"
        if fs.get_bool("private") { vis = "private" }
        else if fs.is_set("public") && !fs.get_bool("public") { vis = "private" }
        fmt := fs.get_string("format")
        has_text := fs.is_set("text")
        text_val := fs.get_string("text")
        $file_arg := ""
        if pos.len == 1 { file_arg = pos[0] + "" }
        $content := ""
        if has_text {
            content = text_val
        } else if file_arg == "-" {
            content = read_stdin_all()
        } else if file_arg.len > 0 {
            content = os.read(file_arg + "") or (err) {
                << emit_err(opts, "ERR_CONFIG", 0, "failed reading file " + file_arg + ": " + err.msg(), 0, EXIT_CONFIG)
            }
        } else {
            << emit_err(opts, "ERR_USAGE", 0, "usage: fatext " + kind + " set [<file|->] [--text <str>] [--public|--private] [--format markdown|text]", 0, EXIT_USAGE)
        }
        if content.len > 65536 {
            << emit_err(opts, "ERR_USAGE", 0, "document exceeds 65536 bytes", 0, EXIT_USAGE)
        }

        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }

        empty := ""
        cur_r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/agents/docs/" + kind, &empty, "")
        $next_ver := 1
        if cur_r.ok {
            cdoc := json.parse(&cur_r.body)
            if cdoc.ok() && cdoc.has(cdoc.root(), "version") {
                next_ver = json_int_or(&cdoc, cdoc.get(cdoc.root(), "version"), 0) + 1
            }
        } else if cur_r.status != 404 {
            << handle_api_fail(opts, &cur_r)
        }

        built := build_signed_doc_put_body(
            cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", kind + "",
            next_ver, vis + "", false, fmt + "", &content, &priv, cfg.agent_id + "", cfg.key_version
        )
        if !built.ok {
            << emit_err(opts, built.err_code + "", 0, built.err_msg + "", 0, EXIT_CRYPTO)
        }
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "PUT", "/v1/agents/docs/" + kind, &built.body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if opts.json_mode {
            println(r.body)
        } else {
            println("saved " + kind + " v" + strconv.itoa(next_ver) + " (" + vis + ", " + strconv.itoa(content.len) + " bytes)")
        }
        << EXIT_OK
    }

    if sub == "get" || sub == "pull" {
        $fs := flag.new_set(kind + " " + sub)
        fs.define_string("out", "", "output file path")
        pr := parse_flags(opts, $&fs, rest, true, "usage: fatext " + kind + " " + sub + " [<agent_id>] [--out <file>]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        pos := fs.args()
        if pos.len > 1 {
            << emit_err(opts, "ERR_USAGE", 0, "unexpected argument: " + pos[1], 0, EXIT_USAGE)
        }
        $target := ""
        if pos.len == 1 { target = pos[0] + "" }
        out_path := fs.get_string("out")

        $api_base := resolve_api_base(opts, "")
        cfg_opt := load_config_or_base(opts, api_base + "")
        if target.len == 0 || (cfg_opt.agent_id.len > 0 && target == cfg_opt.agent_id) {
            cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
            priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
            empty := ""
            r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/agents/docs/" + kind, &empty, "")
            if !r.ok { << handle_api_fail(opts, &r) }
            dv := cli_verify_doc_and_extract(opts, cfg.api_base + "", cfg.agent_id + "", kind + "", "agent", cfg.agent_id + "", cfg.home + "", cfg.key_version, true, &priv, &r.body)
            if !dv.ok { << emit_err(opts, dv.err_code + "", 0, dv.err + "", 0, dv.exit_code) }
            << emit_doc_output(opts, kind + "", out_path + "", &dv)
        }

        if !is_valid_agent_id(target + "") {
            << emit_err(opts, "ERR_USAGE", 0, "invalid agent_id: " + target, 0, EXIT_USAGE)
        }
        empty := ""
        r := api_call_anon(cfg_opt.api_base + "", opts.timeout_sec, "GET", "/k/" + target + "/" + kind + ".json", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        raw_body := r.body + ""
        api_base = cfg_opt.api_base + ""
        dpriv := cli_dummy_priv()
        dv := cli_verify_doc_and_extract(opts, api_base + "", target + "", kind + "", "agent", target + "", "", 1, false, &dpriv, &raw_body)
        if !dv.ok { << emit_err(opts, dv.err_code + "", 0, dv.err + "", 0, dv.exit_code) }
        << emit_doc_output(opts, kind + "", out_path + "", &dv)
    }

    if sub == "status" {
        if rest.len == 0 {
            cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
            priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
            empty := ""
            r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/agents/docs", &empty, "")
            if !r.ok { << handle_api_fail(opts, &r) }
            doc_status_print(opts, &r.body)
            << EXIT_OK
        }
        aid := rest[0] + ""
        if !is_valid_agent_id(aid + "") { << emit_err(opts, "ERR_USAGE", 0, "invalid agent_id", 0, EXIT_USAGE) }
        api_base := resolve_api_base(opts, "")
        cfg_opt := load_config_or_base(opts, api_base + "")
        empty := ""
        r := api_call_anon(cfg_opt.api_base + "", opts.timeout_sec, "GET", "/k/" + aid + "/docs.json", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        doc_status_print(opts, &r.body)
        << EXIT_OK
    }

    if sub == "rm" || sub == "delete" {
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        empty := ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "DELETE", "/v1/agents/docs/" + kind, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if opts.json_mode { println(r.body) } else { println("deleted " + kind) }
        << EXIT_OK
    }

    << emit_err(opts, "ERR_USAGE", 0, "unknown " + kind + " subcommand: " + sub, 0, EXIT_USAGE)
}

pub fn cmd_ctl_doc(opts &CliOpts, kind string, args []string) int {
    if args.len < 2 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl " + kind + " <set|get|pull|status|lock|unlock|rm> <agent_id> ...", 0, EXIT_USAGE)
    }
    sub := args[0] + ""
    aid := args[1] + ""
    if aid == "-h" || aid == "--help" {
        if sub == "set" {
            $hfs := flag.new_set("ctl " + kind + " set")
            hfs.define_bool("public", false, "make document public")
            hfs.define_bool("private", false, "make document private")
            hfs.define_bool("lock", false, "lock document against agent edits")
            hfs.define_bool("unlock", false, "unlock document")
            hfs.define_string("format", "markdown", "document format (markdown|text)")
            hfs.define_string("text", "", "inline document text")
            _ := parse_flags(opts, $&hfs, ["-h"], false, "usage: fatext ctl " + kind + " set <agent_id> [<file|->] [--text <str>] [--public|--private] [--lock|--unlock] [--format markdown|text]")
            << EXIT_OK
        }
        if sub == "get" || sub == "pull" {
            $hfs := flag.new_set("ctl " + kind + " " + sub)
            hfs.define_string("out", "", "output file path")
            _ := parse_flags(opts, $&hfs, ["-h"], false, "usage: fatext ctl " + kind + " " + sub + " <agent_id> [--out <file>]")
            << EXIT_OK
        }
    }
    if !is_valid_agent_id(aid + "") {
        << emit_err(opts, "ERR_USAGE", 0, "invalid agent_id: " + aid, 0, EXIT_USAGE)
    }
    rest := slice_args(&args, 2)

    if sub == "set" {
        $fs := flag.new_set("ctl " + kind + " set")
        fs.define_bool("public", false, "make document public")
        fs.define_bool("private", false, "make document private")
        fs.define_bool("lock", false, "lock document against agent edits")
        fs.define_bool("unlock", false, "unlock document")
        fs.define_string("format", "markdown", "document format (markdown|text)")
        fs.define_string("text", "", "inline document text")
        pr := parse_flags(opts, $&fs, rest, true, "usage: fatext ctl " + kind + " set <agent_id> [<file|->] [--text <str>] [--public|--private] [--lock|--unlock] [--format markdown|text]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        if fs.is_set("public") && fs.is_set("private") {
            << emit_err(opts, "ERR_USAGE", 0, "--public and --private are mutually exclusive", 0, EXIT_USAGE)
        }
        if fs.is_set("lock") && fs.is_set("unlock") {
            << emit_err(opts, "ERR_USAGE", 0, "--lock and --unlock are mutually exclusive", 0, EXIT_USAGE)
        }
        pos := fs.args()
        if pos.len > 1 {
            << emit_err(opts, "ERR_USAGE", 0, "unexpected argument: " + pos[1], 0, EXIT_USAGE)
        }
        $vis := "public"
        if fs.get_bool("private") { vis = "private" }
        else if fs.is_set("public") && !fs.get_bool("public") { vis = "private" }
        $locked := false
        if fs.get_bool("lock") { locked = true }
        else if fs.is_set("unlock") { locked = !fs.get_bool("unlock") }
        fmt := fs.get_string("format")
        has_text := fs.is_set("text")
        text_val := fs.get_string("text")
        $file_arg := ""
        if pos.len == 1 { file_arg = pos[0] + "" }
        $content := ""
        if has_text {
            content = text_val
        } else if file_arg == "-" {
            content = read_stdin_all()
        } else if file_arg.len > 0 {
            content = os.read(file_arg + "") or (err) {
                << emit_err(opts, "ERR_CONFIG", 0, "failed reading file " + file_arg + ": " + err.msg(), 0, EXIT_CONFIG)
            }
        } else {
            << emit_err(opts, "ERR_USAGE", 0, "usage: fatext ctl " + kind + " set <agent_id> [<file|->] [--text <str>] [--public|--private] [--lock|--unlock]", 0, EXIT_USAGE)
        }
        if content.len > 65536 {
            << emit_err(opts, "ERR_USAGE", 0, "document exceeds 65536 bytes", 0, EXIT_USAGE)
        }

        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        empty := ""
        cur_r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/ctl/agents/" + aid + "/docs/" + kind, &empty, "")
        $next_ver := 1
        if cur_r.ok {
            cdoc := json.parse(&cur_r.body)
            if cdoc.ok() && cdoc.has(cdoc.root(), "version") {
                next_ver = json_int_or(&cdoc, cdoc.get(cdoc.root(), "version"), 0) + 1
            }
        } else if cur_r.status != 404 {
            << handle_api_fail(opts, &cur_r)
        }

        built := build_signed_doc_put_body(
            cfg.api_base + "", opts.timeout_sec, aid + "", kind + "",
            next_ver, vis + "", locked, fmt + "", &content, &priv, cfg.agent_id + "", cfg.key_version
        )
        if !built.ok {
            << emit_err(opts, built.err_code + "", 0, built.err_msg + "", 0, EXIT_CRYPTO)
        }
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "PUT", "/v1/ctl/agents/" + aid + "/docs/" + kind, &built.body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if opts.json_mode {
            println(r.body)
        } else {
            $ls := "unlocked"
            if locked { ls = "locked" }
            println("saved " + kind + " v" + strconv.itoa(next_ver) + " for " + aid + " (" + vis + ", " + ls + ")")
        }
        << EXIT_OK
    }

    if sub == "get" || sub == "pull" {
        $fs := flag.new_set("ctl " + kind + " " + sub)
        fs.define_string("out", "", "output file path")
        pr := parse_flags(opts, $&fs, rest, false, "usage: fatext ctl " + kind + " " + sub + " <agent_id> [--out <file>]")
        if pr == FLAG_HELP { << EXIT_OK }
        if pr != FLAG_OK { << EXIT_USAGE }
        out_path := fs.get_string("out")
        cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
        empty := ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/ctl/agents/" + aid + "/docs/" + kind, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        dv := cli_verify_doc_and_extract(opts, cfg.api_base + "", aid + "", kind + "", "controller", cfg.agent_id + "", cfg.home + "", cfg.key_version, true, &priv, &r.body)
        if !dv.ok { << emit_err(opts, dv.err_code + "", 0, dv.err + "", 0, dv.exit_code) }
        << emit_doc_output(opts, kind + "", out_path + "", &dv)
    }

    cfg := load_config(opts) or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }
    priv := load_private_key_checked(cfg.home + "") or (err) { << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG) }

    if sub == "status" {
        empty := ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/ctl/agents/" + aid + "/docs", &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        doc_status_print(opts, &r.body)
        << EXIT_OK
    }

    if sub == "lock" || sub == "unlock" {
        empty := ""
        cur_r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "GET", "/v1/ctl/agents/" + aid + "/docs/" + kind, &empty, "")
        if !cur_r.ok { << handle_api_fail(opts, &cur_r) }
        dv := cli_verify_doc_and_extract(opts, cfg.api_base + "", aid + "", kind + "", "controller", cfg.agent_id + "", cfg.home + "", cfg.key_version, true, &priv, &cur_r.body)
        if !dv.ok { << emit_err(opts, dv.err_code + "", 0, dv.err + "", 0, dv.exit_code) }
        next_ver := dv.version + 1
        new_locked := sub == "lock"
        built := build_signed_doc_put_body(
            cfg.api_base + "", opts.timeout_sec, aid + "", kind + "",
            next_ver, dv.visibility + "", new_locked, dv.format + "", &dv.content, &priv, cfg.agent_id + "", cfg.key_version
        )
        if !built.ok {
            << emit_err(opts, built.err_code + "", 0, built.err_msg + "", 0, EXIT_CRYPTO)
        }
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "PUT", "/v1/ctl/agents/" + aid + "/docs/" + kind, &built.body, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if opts.json_mode {
            println(r.body)
        } else {
            println(sub + "ed " + kind + " v" + strconv.itoa(next_ver) + " for " + aid)
        }
        << EXIT_OK
    }

    if sub == "rm" || sub == "delete" {
        empty := ""
        r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "DELETE", "/v1/ctl/agents/" + aid + "/docs/" + kind, &empty, "")
        if !r.ok { << handle_api_fail(opts, &r) }
        if opts.json_mode { println(r.body) } else { println("deleted " + kind + " for " + aid) }
        << EXIT_OK
    }

    << emit_err(opts, "ERR_USAGE", 0, "unknown ctl " + kind + " subcommand: " + sub, 0, EXIT_USAGE)
}

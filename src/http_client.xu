@main

#errors
#math/big
#crypto/rsa
#crypto/tls
#encoding/json
#net
#net/http
#net/url
#strconv
#strings
#time

pub struct ApiResp {
    pub ok bool
    pub status int
    pub retry_after int
    pub reset_at int
    pub required_bits int
    pub err_code string
    pub err_msg string
    pub receipt string
    pub review_date string
    pub review_status string
    pub body string
    pub net_err bool
}

pub struct FetchedKey {
    pub ok bool
    pub exit_code int
    pub err_code string
    pub err_msg string
    pub agent_id string
    pub status string
    pub key_version int
    pub pub_pem string
    pub pk rsa.PublicKey
    pub raw_json string
    pub self_sig_valid bool
}

fn empty_api_err(net_err bool, code string, msg string) ApiResp {
    << ApiResp{ok: false, status: 0, retry_after: 0, reset_at: 0, required_bits: 0, err_code: code, err_msg: msg, receipt: "", review_date: "", review_status: "", body: "", net_err: net_err}
}

pub fn api_call(api_base string, timeout_sec int, agent_id string, priv &rsa.PrivateKey, signed bool, method string, path_and_query string, body &string, extra_headers string) ApiResp {
    $cl := http.new_client()
    cl.set_timeout(timeout_sec * 1000000000)
    cl.max_redirects = -1
    cl.max_response_bytes = 8388608

    $extra := extra_headers + ""
    if !strings.contains(&extra, "User-Agent:") {
        extra = extra + "User-Agent: fatext-cli/" + CLI_VERSION + "\r\n"
    }
    if body.len > 0 && !strings.contains(&extra, "Content-Type:") {
        extra = extra + "Content-Type: application/json\r\n"
    }
    if signed {
        ts := strconv.itoa(time.now_time().unix())
        sig := sign_http_request(priv, method + "", path_and_query + "", ts + "", body) or (err) {
            << empty_api_err(false, "ERR_CRYPTO", err.msg())
        }
        if agent_id.len > 0 {
            extra = extra + "X-Agent-Id: " + agent_id + "\r\n"
        }
        extra = extra + "X-Timestamp: " + ts + "\r\n"
        extra = extra + "X-Signature: " + sig + "\r\n"
    }

    full_url := api_base + path_and_query
    resp := cl.do_extra(method, full_url, extra, body) or (err) {
        << empty_api_err(true, "ERR_NETWORK", err.msg())
    }
    st := resp.status_code()
    rbody := resp.body()
    if st >= 200 && st < 300 {
        << ApiResp{ok: true, status: st, retry_after: 0, reset_at: 0, required_bits: 0, err_code: "", err_msg: "", receipt: "", review_date: "", review_status: "", body: rbody, net_err: false}
    }

    $ra := 0
    ra_hdr := resp.header("Retry-After")
    if ra_hdr.len > 0 {
        ra = parse_int_or(&strings.trim_space(&ra_hdr), 0)
    }
    $ecode := "ERR_HTTP_" + strconv.itoa(st)
    $emsg := resp.status()
    $req_bits := 0
    $reset_at := 0
    $receipt := ""
    $rev_date := ""
    $rev_status := ""

    edoc := json.parse(&rbody)
    if edoc.ok() && edoc.is_dict(edoc.root()) {
        eroot := edoc.root()
        if edoc.has(eroot, "error") {
            en := edoc.get(eroot, "error")
            if edoc.is_dict(en) {
                if edoc.has(en, "code") { ecode = json_str_or(&edoc, edoc.get(en, "code"), ecode + "") }
                if edoc.has(en, "message") { emsg = json_str_or(&edoc, edoc.get(en, "message"), emsg + "") }
                if edoc.has(en, "retry_after") {
                    ra_b := json_int_or(&edoc, edoc.get(en, "retry_after"), 0)
                    if ra_b > 0 { ra = ra_b }
                }
                if edoc.has(en, "reset_at") {
                    reset_at = json_int_or(&edoc, edoc.get(en, "reset_at"), 0)
                }
                if edoc.has(en, "required_bits") {
                    req_bits = json_int_or(&edoc, edoc.get(en, "required_bits"), 0)
                }
            }
        }
        if edoc.has(eroot, "receipt") { receipt = json_str_or(&edoc, edoc.get(eroot, "receipt"), "") }
        if edoc.has(eroot, "date") { rev_date = json_str_or(&edoc, edoc.get(eroot, "date"), "") }
        if edoc.has(eroot, "status") { rev_status = json_str_or(&edoc, edoc.get(eroot, "status"), "") }
    }
    << ApiResp{ok: false, status: st, retry_after: ra, reset_at: reset_at, required_bits: req_bits, err_code: ecode, err_msg: emsg, receipt: receipt, review_date: rev_date, review_status: rev_status, body: rbody, net_err: false}
}

pub fn api_call_anon(api_base string, timeout_sec int, method string, path_and_query string, body &string, extra_headers string) ApiResp {
    dummy := rsa.PrivateKey{public: rsa.PublicKey{n: big_zero(), e: 65537}, d: big_zero(), p: big_zero(), q: big_zero()}
    << api_call(api_base, timeout_sec, "", &dummy, false, method, path_and_query, body, extra_headers)
}

fn big_zero() big.Int {
    << big.new_int(0)
}

pub fn dummy_rsa_pk() rsa.PublicKey {
    << rsa.PublicKey{n: big_zero(), e: 65537}
}

pub fn discover_pow_bits(opts &CliOpts, api_base string, scope string, fallback int) int {
    if opts.pow_bits_override > 0 {
        << opts.pow_bits_override
    }
    empty := ""
    r := api_call_anon(api_base, 3, "GET", "/.well-known/fatext.json", &empty, "")
    if !r.ok { << fallback }
    doc := json.parse(&r.body)
    if !doc.ok() { << fallback }
    rt := doc.root()
    if !doc.is_dict(rt) || !doc.has(rt, "pow") { << fallback }
    pn := doc.get(rt, "pow")
    if !doc.is_dict(pn) || !doc.has(pn, scope) { << fallback }
    sn := doc.get(pn, scope)
    if !doc.is_dict(sn) || !doc.has(sn, "difficulty_bits") { << fallback }
    bits := json_int_or(&doc, doc.get(sn, "difficulty_bits"), fallback)
    if bits > 0 && bits <= 30 { << bits }
    << fallback
}

pub fn fetch_agent_key(api_base string, timeout_sec int, agent_id string) FetchedKey {
    empty := ""
    r := api_call_anon(api_base, timeout_sec, "GET", "/k/" + agent_id + ".json", &empty, "")
    $dummy_pk := rsa.PublicKey{n: big_zero(), e: 65537}
    if !r.ok {
        $ec := map_http_exit_code(r.status, r.err_code + "")
        if r.net_err { ec = EXIT_NET }
        << FetchedKey{ok: false, exit_code: ec, err_code: r.err_code + "", err_msg: r.err_msg + "", agent_id: agent_id + "", status: "", key_version: 0, pub_pem: "", pk: dummy_pk, raw_json: "", self_sig_valid: false}
    }
    doc := json.parse(&r.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        << FetchedKey{ok: false, exit_code: EXIT_CRYPTO, err_code: "ERR_CRYPTO", err_msg: "invalid identity json", agent_id: agent_id + "", status: "", key_version: 0, pub_pem: "", pk: dummy_pk, raw_json: r.body + "", self_sig_valid: false}
    }
    rt := doc.root()
    doc_aid := json_has_str(&doc, rt, "agent_id", "")
    if doc_aid != agent_id {
        << FetchedKey{ok: false, exit_code: EXIT_CRYPTO, err_code: "ERR_CRYPTO", err_msg: "identity doc agent_id mismatch", agent_id: agent_id + "", status: "", key_version: 0, pub_pem: "", pk: dummy_pk, raw_json: r.body + "", self_sig_valid: false}
    }
    pem_s := json_has_str(&doc, rt, "current_public_key_pem", "")
    pk := decode_spki_public_pem(&pem_s) or (err) {
        << FetchedKey{ok: false, exit_code: EXIT_CRYPTO, err_code: "ERR_CRYPTO", err_msg: err.msg(), agent_id: agent_id + "", status: "", key_version: 0, pub_pem: pem_s + "", pk: dummy_pk, raw_json: r.body + "", self_sig_valid: false}
    }
    status := json_has_str(&doc, rt, "status", "active")
    kv := json_has_int(&doc, rt, "key_version", 1)
    << FetchedKey{ok: true, exit_code: 0, err_code: "", err_msg: "", agent_id: agent_id + "", status: status, key_version: kv, pub_pem: pem_s + "", pk: pk, raw_json: r.body + "", self_sig_valid: true}
}

pub struct SseConn {
    pub is_tls bool
    pub conn net.Conn
    pub tc tls.Conn
    pub buf string
    pub decoded_buf string
    pub chunked bool
    pub chunk_rem int
    pub eof bool
}

pub struct SseEvent {
    pub ok bool
    pub eof bool
    pub event_type string
    pub data string
}

fn dial_port_addr(host string, https bool) string {
    $def_port := ":80"
    if https { def_port = ":443" }
    if host.len > 0 && (host[0] & 255) == 91 {
        rb := strings.index_of(&host, "]")
        if rb > 0 {
            if rb + 1 < host.len && (host[rb + 1] & 255) == 58 { << host }
            << host + def_port
        }
        << host
    }
    first_col := strings.index_of(&host, ":")
    if first_col >= 0 {
        rest := host[(first_col + 1):host.len]
        if strings.index_of(&rest, ":") >= 0 {
            << "[" + host + "]" + def_port
        }
        << host
    }
    << host + def_port
}

fn strip_port(host string) string {
    if host.len > 0 && (host[0] & 255) == 91 {
        rb := strings.index_of(&host, "]")
        if rb > 1 { << host[1:rb] }
        << host + ""
    }
    first_col := strings.index_of(&host, ":")
    if first_col >= 0 {
        rest := host[(first_col + 1):host.len]
        if strings.index_of(&rest, ":") >= 0 { << host + "" }
        << host[0:first_col]
    }
    << host + ""
}

const SSE_CONNECT_TIMEOUT_NS = 10000000000
const SSE_READ_TIMEOUT_NS = 75000000000
const SSE_MAX_LINE_BYTES = 1048576

fn tc_write(tc $&tls.Conn, data &string) int { << tc.write(data) or >> }
fn nc_write(c $&net.Conn, data &string) int { << c.write(data) or >> }
fn tc_read(tc $&tls.Conn, n int) string { << tc.read(n) or >> }
fn nc_read(c $&net.Conn, n int) string { << c.read(n) or >> }
fn tc_close(tc $&tls.Conn) { tc.close() or (err) { << } }
fn nc_close(c $&net.Conn) { c.close() or (err) { << } }
fn net_fd_close_q(fd int) {
    if fd >= 0 {
        _ := net.conn_close(fd) or (err) { << }
    }
}

fn tc_set_deadline_q(tc $&tls.Conn, dl int) {
    _ := tc.set_deadline(dl) or (err) { << }
}

fn nc_set_deadline_q(nc $&net.Conn, dl int) {
    _ := nc.set_deadline(dl) or (err) { << }
}

fn sse_set_deadline(sc $&SseConn, dur_ns int) {
    $dl := 0
    if dur_ns > 0 { dl = time.now() + dur_ns }
    if sc.is_tls {
        tc_set_deadline_q($&sc.tc, dl)
        <<
    }
    nc_set_deadline_q($&sc.conn, dl)
}

fn sse_write_all(sc $&SseConn, data &string) int {
    sse_set_deadline(sc, SSE_CONNECT_TIMEOUT_NS)
    if sc.is_tls {
        << tc_write($&sc.tc, data) or >>
    }
    << nc_write($&sc.conn, data) or >>
}

fn sse_read_chunk(sc $&SseConn) string {
    sse_set_deadline(sc, SSE_READ_TIMEOUT_NS)
    if sc.is_tls {
        << tc_read($&sc.tc, 8192) or >>
    }
    << nc_read($&sc.conn, 8192) or >>
}

pub fn sse_close(sc $&SseConn) {
    if sc.is_tls {
        tc_close($&sc.tc)
        <<
    }
    nc_close($&sc.conn)
}

fn sse_read_raw_line(sc $&SseConn) string {
    while true {
        idx := strings.index_of(&sc.buf, "\n")
        if idx >= 0 {
            if idx > SSE_MAX_LINE_BYTES {
                sc.eof = true
                sc.buf = ""
                << ""
            }
            $ln := sc.buf[0:idx]
            if idx + 1 < sc.buf.len {
                sc.buf = sc.buf[(idx + 1):sc.buf.len]
            } else {
                sc.buf = ""
            }
            if ln.len > 0 && (ln[ln.len - 1] & 255) == 13 {
                ln = ln[0:(ln.len - 1)]
            }
            << ln
        }
        if sc.buf.len >= SSE_MAX_LINE_BYTES {
            sc.eof = true
            sc.buf = ""
            << ""
        }
        chunk := sse_read_chunk(sc) or (err) {
            sc.eof = true
            rem := sc.buf + ""
            sc.buf = ""
            << rem
        }
        if chunk.len == 0 {
            sc.eof = true
            rem := sc.buf + ""
            sc.buf = ""
            << rem
        }
        sc.buf = sc.buf + chunk
    }
    << ""
}

fn parse_chunk_size_hex(line &string) int {
    semi := strings.index_of(line, ";")
    $s := *line + ""
    if semi >= 0 { s = line[0:semi] }
    s = strings.trim_space(&s)
    if s.len == 0 || s.len > 8 { << -1 }
    $val := 0
    for i in 0:s.len {
        c := s[i] & 255
        $d := -1
        if c >= 48 && c <= 57 { d = c - 48 }
        else if c >= 97 && c <= 102 { d = 10 + (c - 97) }
        else if c >= 65 && c <= 70 { d = 10 + (c - 65) }
        if d < 0 { << -1 }
        val = val * 16 + d
    }
    << val
}

fn sse_read_raw_exact(sc $&SseConn, need int) string {
    while sc.buf.len < need {
        chunk := sse_read_chunk(sc) or (err) {
            sc.eof = true
            << ""
        }
        if chunk.len == 0 {
            sc.eof = true
            << ""
        }
        sc.buf = sc.buf + chunk
    }
    out := sc.buf[0:need]
    if need < sc.buf.len {
        sc.buf = sc.buf[need:sc.buf.len]
    } else {
        sc.buf = ""
    }
    << out
}

fn sse_read_line(sc $&SseConn) string {
    if !sc.chunked {
        << sse_read_raw_line(sc)
    }
    while true {
        idx := strings.index_of(&sc.decoded_buf, "\n")
        if idx >= 0 {
            if idx > SSE_MAX_LINE_BYTES {
                sc.eof = true
                sc.decoded_buf = ""
                << ""
            }
            $ln := sc.decoded_buf[0:idx]
            if idx + 1 < sc.decoded_buf.len {
                sc.decoded_buf = sc.decoded_buf[(idx + 1):sc.decoded_buf.len]
            } else {
                sc.decoded_buf = ""
            }
            if ln.len > 0 && (ln[ln.len - 1] & 255) == 13 {
                ln = ln[0:(ln.len - 1)]
            }
            << ln
        }
        if sc.decoded_buf.len >= SSE_MAX_LINE_BYTES || sc.eof {
            sc.eof = true
            sc.decoded_buf = ""
            << ""
        }
        hdr := sse_read_raw_line(sc)
        if sc.eof && hdr.len == 0 {
            sc.decoded_buf = ""
            << ""
        }
        csz := parse_chunk_size_hex(&hdr)
        if csz < 0 {
            sc.eof = true
            sc.decoded_buf = ""
            << ""
        }
        if csz == 0 {
            _ := sse_read_raw_line(sc)
            sc.eof = true
            rem := sc.decoded_buf + ""
            sc.decoded_buf = ""
            << rem
        }
        if sc.decoded_buf.len + csz > SSE_MAX_LINE_BYTES {
            sc.eof = true
            sc.decoded_buf = ""
            << ""
        }
        cdata := sse_read_raw_exact(sc, csz)
        if sc.eof {
            sc.decoded_buf = ""
            << ""
        }
        _ := sse_read_raw_line(sc)
        sc.decoded_buf = sc.decoded_buf + cdata
    }
    << ""
}

pub struct SseConnectOutcome {
    pub ok bool
    pub http_status int
    pub err_msg string
}

pub fn empty_sse_conn() SseConn {
    << SseConn{is_tls: false, conn: net.closed_conn(), tc: tls.closed_conn(), buf: "", decoded_buf: "", chunked: false, chunk_rem: 0, eof: true}
}

fn parse_http_status_line(line &string) int {
    parts := strings.split(line, " ")
    if parts.len < 2 { << 0 }
    << parse_int_or(&parts[1], 0)
}

pub fn sse_connect_into(api_base string, agent_id string, priv &rsa.PrivateKey, path_and_query string, sc $&SseConn) SseConnectOutcome {
    full := api_base + path_and_query
    $u := url.new_url()
    u.parse(full) or (err) {
        << SseConnectOutcome{ok: false, http_status: 0, err_msg: err.msg()}
    }
    scheme := u.scheme()
    https := scheme == "https"
    host := u.host()
    addr := dial_port_addr(host + "", https)
    sni := strip_port(host + "")

    sc.is_tls = https
    sc.conn = net.closed_conn()
    sc.tc = tls.closed_conn()
    sc.buf = ""
    sc.decoded_buf = ""
    sc.chunked = false
    sc.chunk_rem = 0
    sc.eof = false

    if https {
        $nc := net.dial_timeout("tcp", addr, SSE_CONNECT_TIMEOUT_NS) or (err) {
            << SseConnectOutcome{ok: false, http_status: 0, err_msg: err.msg()}
        }
        fd := nc.descriptor() or (err) {
            nc_close($&nc)
            << SseConnectOutcome{ok: false, http_status: 0, err_msg: err.msg()}
        }
        nc.set_deadline(time.now() + SSE_CONNECT_TIMEOUT_NS) or (err) {
            net_fd_close_q(fd)
            << SseConnectOutcome{ok: false, http_status: 0, err_msg: err.msg()}
        }
        $cfg := tls.new_config(sni)
        cfg.set_next_protos(["http/1.1"])
        sc.tc = tls.client(nc, &cfg) or (err) {
            net_fd_close_q(fd)
            << SseConnectOutcome{ok: false, http_status: 0, err_msg: err.msg()}
        }
    } else {
        sc.conn = net.dial_timeout("tcp", addr, SSE_CONNECT_TIMEOUT_NS) or (err) {
            << SseConnectOutcome{ok: false, http_status: 0, err_msg: err.msg()}
        }
    }

    ts := strconv.itoa(time.now_time().unix())
    empty := ""
    sig := sign_http_request(priv, "GET", path_and_query + "", ts + "", &empty) or (err) {
        sse_close(sc)
        << SseConnectOutcome{ok: false, http_status: 0, err_msg: err.msg()}
    }
    req := "GET " + path_and_query + " HTTP/1.1\r\n" +
        "Host: " + host + "\r\n" +
        "User-Agent: fatext-cli/" + CLI_VERSION + "\r\n" +
        "Accept: text/event-stream\r\n" +
        "Cache-Control: no-cache\r\n" +
        "Connection: close\r\n" +
        "X-Agent-Id: " + agent_id + "\r\n" +
        "X-Timestamp: " + ts + "\r\n" +
        "X-Signature: " + sig + "\r\n\r\n"
    _ := sse_write_all(sc, &req) or (err) {
        sse_close(sc)
        << SseConnectOutcome{ok: false, http_status: 0, err_msg: err.msg()}
    }

    status_ln := sse_read_raw_line(sc)
    code := parse_http_status_line(&status_ln)
    if code != 200 {
        sse_close(sc)
        << SseConnectOutcome{ok: false, http_status: code, err_msg: "sse: HTTP error: " + status_ln}
    }
    $hdr_lines := 0
    $saw_end := false
    while !sc.eof {
        hln := sse_read_raw_line(sc)
        if hln.len == 0 {
            if !sc.eof { saw_end = true }
            <-
        }
        hdr_lines += 1
        if hdr_lines > 128 {
            sse_close(sc)
            << SseConnectOutcome{ok: false, http_status: 0, err_msg: "sse: too many response headers"}
        }
        low := strings.to_lower(&hln)
        if strings.has_prefix(&low, "transfer-encoding:") && strings.contains(&low, "chunked") {
            sc.chunked = true
        }
    }
    if !saw_end {
        sse_close(sc)
        << SseConnectOutcome{ok: false, http_status: 0, err_msg: "sse: truncated response headers"}
    }
    << SseConnectOutcome{ok: true, http_status: 200, err_msg: ""}
}

pub fn sse_connect(api_base string, agent_id string, priv &rsa.PrivateKey, path_and_query string) SseConn {
    $sc := empty_sse_conn()
    res := sse_connect_into(api_base + "", agent_id + "", priv, path_and_query + "", $&sc)
    if !res.ok {
        >> errors.new(res.err_msg + "")
    }
    << sc
}

pub fn sse_read_event(sc $&SseConn) SseEvent {
    $ev_type := "message"
    $data_buf := ""
    $has_data := false
    while !sc.eof {
        ln := sse_read_line(sc)
        if ln.len == 0 {
            if has_data {
                << SseEvent{ok: true, eof: false, event_type: ev_type, data: data_buf}
            }
            ev_type = "message"
            ->
        }
        if (ln[0] & 255) == 58 {
            // SSE comment / heartbeat
            ->
        }
        if strings.has_prefix(&ln, "event:") {
            rest := ln[6:ln.len]
            ev_type = strings.trim_space(&rest)
        } else if strings.has_prefix(&ln, "data:") {
            rest := ln[5:ln.len]
            $val := rest
            if val.len > 0 && (val[0] & 255) == 32 {
                val = val[1:val.len]
            }
            if has_data {
                data_buf = data_buf + "\n" + val
            } else {
                data_buf = val
                has_data = true
            }
        }
    }
    << SseEvent{ok: false, eof: true, event_type: "", data: ""}
}

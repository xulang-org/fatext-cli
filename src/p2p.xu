@main

#errors
#crypto/aes
#crypto/cipher
#crypto/ecdh
#crypto/rand
#crypto/rsa
#crypto/sha256
#encoding/base64
#encoding/json
#net
#os
#strconv
#strings
#time

const P2P_PKT_PUNCH = 1
const P2P_PKT_ACK = 2
const P2P_PKT_DATA = 3
const P2P_PKT_FIN = 4
const P2P_PKT_PING = 5
const P2P_PKT_PONG = 6
const P2P_MTU_CHUNK = 1150

fn push_mtu_chunks(q $&[]string, data &string) {
    if data.len == 0 { << }
    $off := 0
    while off < data.len {
        $end := off + P2P_MTU_CHUNK
        if end > data.len { end = data.len }
        q.push(data[off:end] + "")
        off = end
    }
}

fn send_ack_q(pconn $&net.PacketConn, ciph &aes.Cipher, sess string, seq int, peer_addr &net.UDPAddr) {
    empty := ""
    apkt := seal_pkt_q(ciph, sess + "", P2P_PKT_ACK, seq, &empty)
    if apkt.len > 0 { pconn_write_q(pconn, &apkt, peer_addr) }
}

fn send_ctrl_pkt_q(pconn $&net.PacketConn, ciph &aes.Cipher, sess string, ptype int, peer_addr &net.UDPAddr) {
    empty := ""
    pkt := seal_pkt_q(ciph, sess + "", ptype, 0, &empty)
    if pkt.len > 0 { pconn_write_q(pconn, &pkt, peer_addr) }
}

fn pconn_deadline_q(pconn $&net.PacketConn, dur_ns int) {
    if dur_ns <= 0 {
        pconn.set_read_deadline(0) or (err) { << }
    } else {
        pconn.set_read_deadline(time.now() + dur_ns) or (err) { << }
    }
}

fn pconn_close_q(pconn $&net.PacketConn) {
    pconn.close() or (err) { << }
}

fn pconn_write_q(pconn $&net.PacketConn, pkt &string, addr &net.UDPAddr) {
    _ := pconn.write_to(pkt, addr) or (err) { << }
}

fn seal_pkt_q(ciph &aes.Cipher, session string, ptype int, seq int, payload &string) string {
    << p2p_seal_packet(ciph, session, ptype, seq, payload) or (err) { << "" }
}

fn atoi_or_0(s &string) int {
    << strconv.atoi(s) or (err) { << 0 }
}

fn fd_write_q(fd int, s string) {
    _ := os.fd_write(fd, s) or (err) { << }
}

fn read_from_or(pconn $&net.PacketConn, n int) net.UDPPacket {
    << pconn.read_from(n) or (err) { << net.UDPPacket{addr: net.UDPAddr{ip: "", port: 0, zone: ""}, data: ""} }
}

fn encrypt_dm_or(sender_id string, sender_priv &rsa.PrivateKey, to_id string, to_pk &rsa.PublicKey, to_key_ver int, msg_type string, body_json string, conv_state string, ts int) string {
    << encrypt_dm_frame(sender_id, sender_priv, to_id, to_pk, to_key_ver, msg_type, body_json, conv_state, ts) or (err) { << "" }
}

fn net_dial_or(addr string) int {
    << net.dial(addr) or (err) { << -1 }
}

fn net_accept_or(lfd int) int {
    << net.accept(lfd) or (err) { << -1 }
}

fn net_close_q(fd int) {
    if fd >= 0 {
        _ := net.conn_close(fd) or (err) { << }
    }
}

fn net_close_write_q(fd int) {
    if fd >= 0 {
        _ := os.shutdown(fd, 1) or (err) { << }
    }
}

fn net_write_q(fd int, data &string) {
    if fd >= 0 {
        _ := net.conn_write(fd, data) or (err) { << }
    }
}

fn p2p_tcp_reader(tcp_fd int, out_ch chan string, eof_ch chan int) {
    while true {
        chunk := net.conn_read(tcp_fd, 4096) or (err) { <- }
        if chunk.len == 0 { <- }
        out_ch <- chunk
    }
    select {
        eof_ch <- 1 {}
        else {}
    }
}

fn p2p_stdin_line_reader(line_ch chan string, eof_ch chan int) {
    $buf := ""
    while true {
        chunk := os.fd_read(0, 4096) or (err) { <- }
        if chunk.len == 0 { <- }
        buf = buf + chunk
        while true {
            nl := strings.index_of(&buf, "\n")
            if nl < 0 { <- }
            $ln := buf[0:nl] + ""
            if strings.has_suffix(&ln, "\r") {
                ln = ln[0:(ln.len - 1)] + ""
            }
            buf = buf[(nl + 1):buf.len] + ""
            if ln.len > 0 {
                line_ch <- ln
            }
        }
    }
    rem := strings.trim_space(&buf)
    if rem.len > 0 {
        line_ch <- rem
    }
    select {
        eof_ch <- 1 {}
        else {}
    }
}

struct StarGuardMsg {
    acquire bool
    reply_ch chan bool
}

fn star_guard_loop(max_peers int, ch chan StarGuardMsg) {
    $active := 0
    while true {
        msg := <-ch
        if msg.acquire {
            $ok := true
            if max_peers > 0 && active >= max_peers { ok = false }
            if ok { active += 1 }
            msg.reply_ch <- ok
        } else {
            if active > 0 { active -= 1 }
        }
    }
}

fn star_guard_acquire(ch chan StarGuardMsg) bool {
    rc := chan bool{cap: 1}
    ch <- StarGuardMsg{acquire: true, reply_ch: rc}
    << <-rc
}

fn star_guard_release(ch chan StarGuardMsg) {
    ch <- StarGuardMsg{acquire: false, reply_ch: chan bool{cap: 1}}
}

const BUS_JOIN = 1
const BUS_LEAVE = 2
const BUS_INBOUND = 3
const BUS_HUB_SEND = 4

struct BusPeer {
    agent_id string
    session string
    tx_ch chan string
}

struct BusMsg {
    kind int
    agent_id string
    to_id string
    session string
    text string
    tx_ch chan string
}

struct ParsedBusFrame {
    from_id string
    to_id string
    text string
}

fn parse_bus_frame(raw &string, default_from string, default_to string) ParsedBusFrame {
    d := json.parse(raw)
    if d.ok() && d.is_dict(d.root()) && d.has(d.root(), "text") {
        rt := d.root()
        $fr := default_from + ""
        $to := default_to + ""
        if d.has(rt, "from") {
            fv := json_str_or(&d, d.get(rt, "from"), "")
            if fv.len > 0 { fr = fv }
        }
        if d.has(rt, "to") {
            tv := json_str_or(&d, d.get(rt, "to"), "")
            if tv.len > 0 { to = tv }
        }
        tx := json_str_or(&d, d.get(rt, "text"), "")
        << ParsedBusFrame{from_id: fr, to_id: to, text: tx}
    }
    << ParsedBusFrame{from_id: default_from + "", to_id: default_to + "", text: raw + ""}
}

fn bus_emit_jsonl(from_id &string, to_id &string, session &string, text &string) {
    fd_write_q(1, "{\"type\":\"p2p_msg\",\"from\":" + json.quote(from_id) + ",\"to\":" + json.quote(to_id) + ",\"session\":" + json.quote(session) + ",\"text\":" + json.quote(text) + "}\n")
}

fn star_bus_loop(self_id string, ch chan BusMsg) {
    $peers := []BusPeer{}
    while true {
        msg := <-ch
        if msg.kind == BUS_JOIN {
            $next := []BusPeer{}
            for i in 0:peers.len {
                if peers[i].agent_id != msg.agent_id {
                    next.push(BusPeer{agent_id: peers[i].agent_id + "", session: peers[i].session + "", tx_ch: peers[i].tx_ch})
                }
            }
            next.push(BusPeer{agent_id: msg.agent_id + "", session: msg.session + "", tx_ch: msg.tx_ch})
            peers = next
        } else if msg.kind == BUS_LEAVE {
            $next := []BusPeer{}
            for i in 0:peers.len {
                if peers[i].session != msg.session {
                    next.push(BusPeer{agent_id: peers[i].agent_id + "", session: peers[i].session + "", tx_ch: peers[i].tx_ch})
                }
            }
            peers = next
        } else if msg.kind == BUS_INBOUND {
            bus_emit_jsonl(&msg.agent_id, &msg.to_id, &msg.session, &msg.text)
            fwd := "{\"from\":" + json.quote(&msg.agent_id) + ",\"to\":" + json.quote(&msg.to_id) + ",\"text\":" + json.quote(&msg.text) + "}"
            if msg.to_id == "*" {
                for i in 0:peers.len {
                    if peers[i].session != msg.session && peers[i].agent_id != msg.agent_id {
                        select {
                            peers[i].tx_ch <- (fwd + "") {}
                            else {}
                        }
                    }
                }
            } else if msg.to_id != self_id {
                for i in 0:peers.len {
                    if peers[i].agent_id == msg.to_id {
                        select {
                            peers[i].tx_ch <- (fwd + "") {}
                            else {}
                        }
                    }
                }
            }
        } else if msg.kind == BUS_HUB_SEND {
            fwd := "{\"from\":" + json.quote(&self_id) + ",\"to\":" + json.quote(&msg.to_id) + ",\"text\":" + json.quote(&msg.text) + "}"
            if msg.to_id == "*" {
                for i in 0:peers.len {
                    select {
                        peers[i].tx_ch <- (fwd + "") {}
                        else {}
                    }
                }
            } else {
                for i in 0:peers.len {
                    if peers[i].agent_id == msg.to_id {
                        select {
                            peers[i].tx_ch <- (fwd + "") {}
                            else {}
                        }
                    }
                }
            }
        }
    }
}

fn hub_stdin_bridge(bus_ch chan BusMsg) {
    line_ch := chan string{cap: 64}
    eof_ch := chan int{cap: 1}
    xu p2p_stdin_line_reader(line_ch, eof_ch)
    $alive := true
    while alive {
        select {
            ln := <-line_ch {
                pf := parse_bus_frame(&ln, "hub", "*")
                bus_ch <- BusMsg{kind: BUS_HUB_SEND, agent_id: "", to_id: pf.to_id + "", session: "hub", text: pf.text + "", tx_ch: chan string{cap: 1}}
            }
            _ := <-eof_ch {
                alive = false
            }
        }
    }
}

fn p2p_star_forward_worker(
    opts CliOpts,
    pconn_in net.PacketConn,
    ciph aes.Cipher,
    sess string,
    from_id string,
    cands []net.UDPAddr,
    rport int,
    guard_ch chan StarGuardMsg
) {
    $pconn := pconn_in
    tcp_fd := net_dial_or("127.0.0.1:" + strconv.itoa(rport))
    _ := p2p_punch_and_session(&opts, $&pconn, &ciph, sess + "", from_id + "", &cands, false, false, tcp_fd, -1)
    pconn_close_q($&pconn)
    star_guard_release(guard_ch)
}

fn p2p_punch_only(
    opts &CliOpts,
    pconn $&net.PacketConn,
    ciph &aes.Cipher,
    session string,
    peer_id string,
    cands &[]net.UDPAddr
) net.UDPAddr {
    empty := ""
    t_start := time.now_time().unix()
    for round in 0:200 {
        if time.now_time().unix() - t_start > 10 { <- }
        punch_pkt := seal_pkt_q(ciph, session + "", P2P_PKT_PUNCH, 0, &empty)
        if punch_pkt.len > 0 {
            for i in 0:cands.len {
                pconn_write_q(pconn, &punch_pkt, &cands[i])
            }
        }
        pconn_deadline_q(pconn, 50000000)
        upkt := pconn.read_from(4096) or (err) { -> }
        opened := p2p_open_packet(ciph, session + "", &upkt.data)
        if opened.ok {
            pa := net.UDPAddr{ip: upkt.addr.ip + "", port: upkt.addr.port, zone: ""}
            if opened.ptype == P2P_PKT_PUNCH {
                ack_pkt := seal_pkt_q(ciph, session + "", P2P_PKT_ACK, 0, &empty)
                if ack_pkt.len > 0 { pconn_write_q(pconn, &ack_pkt, &pa) }
                << pa
            } else if opened.ptype == P2P_PKT_ACK {
                << pa
            }
        }
    }
    p2p_log(opts, "failed", session + "", peer_id + "", "\"reason\":\"punch_timeout\"")
    << net.UDPAddr{ip: "", port: 0, zone: ""}
}

fn p2p_star_bus_worker(
    opts CliOpts,
    pconn_in net.PacketConn,
    ciph aes.Cipher,
    sess string,
    from_id string,
    cands []net.UDPAddr,
    bus_ch chan BusMsg,
    guard_ch chan StarGuardMsg
) {
    $pconn := pconn_in
    peer_addr := p2p_punch_only(&opts, $&pconn, &ciph, sess + "", from_id + "", &cands)
    if peer_addr.port == 0 {
        pconn_close_q($&pconn)
        star_guard_release(guard_ch)
        <<
    }
    p2p_log(&opts, "connected", sess + "", from_id + "", "\"path\":\"direct\",\"topology\":\"star\",\"mode\":\"bus\"")

    tx_ch := chan string{cap: 64}
    bus_ch <- BusMsg{kind: BUS_JOIN, agent_id: from_id + "", to_id: "", session: sess + "", text: "", tx_ch: tx_ch}

    $tx_q := []string{}
    $tx_head := 0
    $wait_ack := false
    $unacked_seq := 0
    $unacked_pkt := ""
    $unacked_ns := 0
    $unacked_tries := 0
    $last_tx_ns := time.now()
    $rx_buf := ""
    $seq := 1
    $expected_seq := 1
    $bytes_in := 0
    $bytes_out := 0
    $alive := true
    empty := ""

    while alive {
        $drain := true
        while drain {
            select {
                out_msg := <-tx_ch {
                    wire := out_msg + "\n"
                    push_mtu_chunks($&tx_q, &wire)
                }
                else {
                    drain = false
                }
            }
        }

        if !wait_ack && tx_head < tx_q.len {
            ch_s := tx_q[tx_head] + ""
            tx_head += 1
            if tx_head >= tx_q.len {
                tx_q = []string{}
                tx_head = 0
            }
            bytes_out += ch_s.len
            dpkt := seal_pkt_q(&ciph, sess + "", P2P_PKT_DATA, seq, &ch_s)
            if dpkt.len > 0 {
                pconn_write_q($&pconn, &dpkt, &peer_addr)
                wait_ack = true
                unacked_seq = seq
                unacked_pkt = dpkt + ""
                unacked_ns = time.now()
                unacked_tries = 1
                last_tx_ns = unacked_ns
                seq += 1
            }
        } else if wait_ack && time.now() - unacked_ns >= 60000000 {
            if unacked_tries < 8 {
                pconn_write_q($&pconn, &unacked_pkt, &peer_addr)
                unacked_ns = time.now()
                unacked_tries += 1
                last_tx_ns = unacked_ns
            } else {
                wait_ack = false
            }
        }

        if !wait_ack && time.now() - last_tx_ns >= 15000000000 {
            send_ctrl_pkt_q($&pconn, &ciph, sess + "", P2P_PKT_PING, &peer_addr)
            last_tx_ns = time.now()
        }

        $dl := 10000000
        if wait_ack { dl = 2000000 }
        pconn_deadline_q($&pconn, dl)
        upkt := read_from_or($&pconn, 65535)
        if upkt.data.len > 0 {
            opened := p2p_open_packet(&ciph, sess + "", &upkt.data)
            if opened.ok {
                if opened.ptype == P2P_PKT_ACK {
                    if wait_ack && opened.seq == unacked_seq {
                        wait_ack = false
                    }
                } else if opened.ptype == P2P_PKT_PUNCH {
                    send_ack_q($&pconn, &ciph, sess + "", 0, &peer_addr)
                } else if opened.ptype == P2P_PKT_PING {
                    send_ctrl_pkt_q($&pconn, &ciph, sess + "", P2P_PKT_PONG, &peer_addr)
                } else if opened.ptype == P2P_PKT_DATA {
                    send_ack_q($&pconn, &ciph, sess + "", opened.seq, &peer_addr)
                    if opened.seq >= expected_seq {
                        bytes_in += opened.data.len
                        expected_seq = opened.seq + 1
                        rx_buf = rx_buf + opened.data
                        while true {
                            nl := strings.index_of(&rx_buf, "\n")
                            if nl < 0 { <- }
                            ln := rx_buf[0:nl] + ""
                            rx_buf = rx_buf[(nl + 1):rx_buf.len] + ""
                            if ln.len > 0 {
                                pf := parse_bus_frame(&ln, from_id + "", "*")
                                bus_ch <- BusMsg{kind: BUS_INBOUND, agent_id: from_id + "", to_id: pf.to_id + "", session: sess + "", text: pf.text + "", tx_ch: chan string{cap: 1}}
                            }
                        }
                    }
                } else if opened.ptype == P2P_PKT_FIN {
                    alive = false
                }
            }
        }
    }

    bus_ch <- BusMsg{kind: BUS_LEAVE, agent_id: from_id + "", to_id: "", session: sess + "", text: "", tx_ch: chan string{cap: 1}}
    pconn_close_q($&pconn)
    star_guard_release(guard_ch)
    p2p_log(&opts, "closed", sess + "", from_id + "", "\"bytes_in\":" + strconv.itoa(bytes_in) + ",\"bytes_out\":" + strconv.itoa(bytes_out))
}

fn p2p_bus_client_session(
    opts &CliOpts,
    pconn $&net.PacketConn,
    ciph &aes.Cipher,
    sess string,
    peer_id string,
    self_id string,
    cands &[]net.UDPAddr
) int {
    peer_addr := p2p_punch_only(opts, pconn, ciph, sess + "", peer_id + "", cands)
    if peer_addr.port == 0 {
        << EXIT_P2P
    }
    p2p_log(opts, "connected", sess + "", peer_id + "", "\"path\":\"direct\",\"topology\":\"star\",\"mode\":\"bus\"")

    line_ch := chan string{cap: 64}
    eof_ch := chan int{cap: 1}
    xu p2p_stdin_line_reader(line_ch, eof_ch)

    $tx_q := []string{}
    $tx_head := 0
    $wait_ack := false
    $unacked_seq := 0
    $unacked_pkt := ""
    $unacked_ns := 0
    $unacked_tries := 0
    $last_tx_ns := time.now()
    $rx_buf := ""
    $seq := 1
    $expected_seq := 1
    $bytes_in := 0
    $bytes_out := 0
    $stdin_eof := false
    $alive := true
    empty := ""

    // Brief settle so hub worker registers tx_ch before initial DATA bursts
    time.sleep(30000000)

    while alive {
        $drain := !stdin_eof
        while drain {
            select {
                ln := <-line_ch {
                    pf := parse_bus_frame(&ln, self_id + "", "*")
                    wire := "{\"to\":" + json.quote(&pf.to_id) + ",\"text\":" + json.quote(&pf.text) + "}\n"
                    push_mtu_chunks($&tx_q, &wire)
                }
                else {
                    drain = false
                }
            }
        }
        if !stdin_eof {
            select {
                _ := <-eof_ch {
                    stdin_eof = true
                }
                else {}
            }
        }

        if !wait_ack && tx_head < tx_q.len {
            ch_s := tx_q[tx_head] + ""
            tx_head += 1
            if tx_head >= tx_q.len {
                tx_q = []string{}
                tx_head = 0
            }
            bytes_out += ch_s.len
            dpkt := seal_pkt_q(ciph, sess + "", P2P_PKT_DATA, seq, &ch_s)
            if dpkt.len > 0 {
                pconn_write_q(pconn, &dpkt, &peer_addr)
                wait_ack = true
                unacked_seq = seq
                unacked_pkt = dpkt + ""
                unacked_ns = time.now()
                unacked_tries = 1
                last_tx_ns = unacked_ns
                seq += 1
            }
        } else if wait_ack && time.now() - unacked_ns >= 60000000 {
            if unacked_tries < 8 {
                pconn_write_q(pconn, &unacked_pkt, &peer_addr)
                unacked_ns = time.now()
                unacked_tries += 1
                last_tx_ns = unacked_ns
            } else {
                wait_ack = false
            }
        }

        if stdin_eof && tx_head >= tx_q.len && !wait_ack {
            fin_pkt := seal_pkt_q(ciph, sess + "", P2P_PKT_FIN, seq, &empty)
            if fin_pkt.len > 0 {
                for r in 0:3 { pconn_write_q(pconn, &fin_pkt, &peer_addr) }
            }
            alive = false
            <-
        }

        if !wait_ack && time.now() - last_tx_ns >= 15000000000 {
            send_ctrl_pkt_q(pconn, ciph, sess + "", P2P_PKT_PING, &peer_addr)
            last_tx_ns = time.now()
        }

        $dl := 10000000
        if wait_ack { dl = 2000000 }
        pconn_deadline_q(pconn, dl)
        upkt := read_from_or(pconn, 65535)
        if upkt.data.len > 0 {
            opened := p2p_open_packet(ciph, sess + "", &upkt.data)
            if opened.ok {
                if opened.ptype == P2P_PKT_ACK {
                    if wait_ack && opened.seq == unacked_seq {
                        wait_ack = false
                    }
                } else if opened.ptype == P2P_PKT_PING {
                    send_ctrl_pkt_q(pconn, ciph, sess + "", P2P_PKT_PONG, &peer_addr)
                } else if opened.ptype == P2P_PKT_DATA {
                    send_ack_q(pconn, ciph, sess + "", opened.seq, &peer_addr)
                    if opened.seq >= expected_seq {
                        bytes_in += opened.data.len
                        expected_seq = opened.seq + 1
                        rx_buf = rx_buf + opened.data
                        while true {
                            nl := strings.index_of(&rx_buf, "\n")
                            if nl < 0 { <- }
                            ln := rx_buf[0:nl] + ""
                            rx_buf = rx_buf[(nl + 1):rx_buf.len] + ""
                            if ln.len > 0 {
                                pf := parse_bus_frame(&ln, peer_id + "", self_id + "")
                                bus_emit_jsonl(&pf.from_id, &pf.to_id, &sess, &pf.text)
                            }
                        }
                    }
                } else if opened.ptype == P2P_PKT_FIN {
                    alive = false
                }
            }
        }
    }

    p2p_log(opts, "closed", sess + "", peer_id + "", "\"bytes_in\":" + strconv.itoa(bytes_in) + ",\"bytes_out\":" + strconv.itoa(bytes_out))
    << EXIT_OK
}

fn gen_sess_or() string {
    << generate_session_id() or (err) { << "s_0000000000000000" }
}

fn p2p_log(opts &CliOpts, state string, session string, peer string, extra_json string) {
    if opts.json_mode {
        $s := "{\"type\":\"p2p\",\"state\":" + json.quote(&state) + ",\"session\":" + json.quote(&session) + ",\"peer\":" + json.quote(&peer)
        if extra_json.len > 0 {
            s = s + "," + extra_json
        }
        s = s + "}"
        eprintln(s)
    } else {
        eprintln("p2p [" + state + "] session=" + session + " peer=" + peer)
    }
}

fn parse_host_port(hp string) []string {
    $s := hp + ""
    if strings.has_prefix(&s, "stun:") {
        s = s[5:s.len]
    }
    $col := -1
    for i in 0:s.len {
        if (s[i] & 255) == 58 { col = i }
    }
    if col <= 0 || col + 1 >= s.len { << []string{} }
    << [s[0:col], s[(col + 1):s.len]]
}

fn udp_addr_from_str(hp string) net.UDPAddr {
    parts := parse_host_port(hp + "")
    if parts.len != 2 {
        >> errors.new("p2p: invalid host:port: " + hp)
    }
    port := strconv.atoi(&parts[1]) or >>
    $ip := net.parse_ip(&parts[0])
    if ip.len == 0 {
        ips := net.lookup_ip(parts[0] + "") or >>
        $found := false
        for i in 0:ips.len {
            if ips[i].len == 4 {
                ip = ips[i] + ""
                found = true
                <-
            }
        }
        if !found {
            >> errors.new("p2p: cannot resolve IPv4 for " + parts[0])
        }
    }
    << net.UDPAddr{ip: ip, port: port, zone: ""}
}

pub fn stun_discover(pconn &net.PacketConn, stun_hp string) string {
    if stun_hp.len == 0 || stun_hp == "none" { << "" }
    raddr := udp_addr_from_str(stun_hp) or (err) { << "" }
    tx := rand.read(12) or (err) { << "" }
    // RFC 5389 Binding Request: type=0x0001, len=0x0000, magic=0x2112A442, 12-byte txid
    $req := [0, 1, 0, 0, 33, 18, 164, 66]
    for i in 0:12 { req.push(tx[i] & 255) }
    pkt := string_from_bytes(req)
    _ := pconn.write_to(&pkt, &raddr) or (err) { << "" }
    resp := pconn.read_from(2048) or (err) { << "" }
    d := resp.data + ""
    if d.len < 20 { << "" }
    // Verify magic cookie & transaction id
    if (d[4] & 255) != 33 || (d[5] & 255) != 18 || (d[6] & 255) != 164 || (d[7] & 255) != 66 {
        << ""
    }
    $off := 20
    while off + 4 <= d.len {
        atype := ((d[off] & 255) << 8) | (d[off + 1] & 255)
        alen := ((d[off + 2] & 255) << 8) | (d[off + 3] & 255)
        off += 4
        if off + alen > d.len { <- }
        if (atype == 32 || atype == 1) && alen >= 8 {
            fam := d[off + 1] & 255
            if fam == 1 {
                $xport := ((d[off + 2] & 255) << 8) | (d[off + 3] & 255)
                $b0 := d[off + 4] & 255
                $b1 := d[off + 5] & 255
                $b2 := d[off + 6] & 255
                $b3 := d[off + 7] & 255
                if atype == 32 {
                    xport = xport ^ 8466
                    b0 = b0 ^ 33
                    b1 = b1 ^ 18
                    b2 = b2 ^ 164
                    b3 = b3 ^ 66
                }
                << strconv.itoa(b0) + "." + strconv.itoa(b1) + "." + strconv.itoa(b2) + "." + strconv.itoa(b3) + ":" + strconv.itoa(xport)
            }
        }
        $pad := alen % 4
        if pad != 0 { pad = 4 - pad }
        off = off + alen + pad
    }
    << ""
}

fn p2p_derive_key(session string, shared_secret &string) string {
    << sha256.sum256_bytes("fatext-p2p-v1\n" + session + "\n" + (shared_secret + ""))
}

fn p2p_seal_packet(ciph &aes.Cipher, session string, ptype int, seq int, payload &string) string {
    iv := rand.read(12) or >>
    $hdr := [ptype & 255]
    $s := seq
    $sh := 56
    while sh >= 0 {
        hdr.push((s >> sh) & 255)
        sh -= 8
    }
    aad := string_from_bytes(hdr) + session
    ct := cipher.seal_gcm(ciph, &iv, payload, &aad) or >>
    << string_from_bytes(hdr) + iv + ct
}

struct P2PPacket {
    pub ok bool
    pub ptype int
    pub seq int
    pub data string
}

fn p2p_open_packet(ciph &aes.Cipher, session string, raw &string) P2PPacket {
    if raw.len < 9 + 12 + 16 {
        << P2PPacket{ok: false, ptype: 0, seq: 0, data: ""}
    }
    ptype := raw[0] & 255
    $seq := 0
    for i in 1:9 {
        seq = (seq << 8) | (raw[i] & 255)
    }
    hdr := raw[0:9]
    iv := raw[9:21]
    ct := raw[21:raw.len]
    aad := hdr + session
    pt := cipher.open_gcm(ciph, &iv, &ct, &aad) or (err) {
        << P2PPacket{ok: false, ptype: 0, seq: 0, data: ""}
    }
    << P2PPacket{ok: true, ptype: ptype, seq: seq, data: pt}
}

fn local_port_of(pconn &net.PacketConn) int {
    loc := pconn.local_addr()
    parts := parse_host_port(loc)
    if parts.len == 2 {
        << atoi_or_0(&parts[1])
    }
    << 0
}

fn discover_lan_ips() []string {
    $out := []string{}
    addrs := net.interface_addrs() or (err) { << out }
    for i in 0:addrs.len {
        a := addrs[i] + ""
        $host := a
        sl := strings.index_of(&host, "/")
        if sl >= 0 { host = host[0:sl] }
        ip := net.parse_ip(&host)
        if ip.len != 4 { -> }
        b0 := ip[0] & 255
        b1 := ip[1] & 255
        if b0 == 127 || b0 == 0 || (b0 == 169 && b1 == 254) { -> }
        $dup := false
        for j in 0:out.len {
            if out[j] == host { dup = true }
        }
        if !dup {
            out.push(host)
            if out.len >= 2 { <- }
        }
    }
    << out
}

fn build_candidates_json(lport int, srflx string) string {
    $cands := ["{\"t\":\"host\",\"a\":\"127.0.0.1:" + strconv.itoa(lport) + "\"}"]
    lan := discover_lan_ips()
    for i in 0:lan.len {
        hp := lan[i] + ":" + strconv.itoa(lport)
        cands.push("{\"t\":\"host\",\"a\":" + json.quote(&hp) + "}")
    }
    if srflx.len > 0 {
        cands.push("{\"t\":\"srflx\",\"a\":" + json.quote(&srflx) + "}")
    }
    << "[" + strings.join(cands, ",") + "]"
}

fn extract_candidate_addrs(doc &json.Doc, arr_node int) []net.UDPAddr {
    $out := []net.UDPAddr{}
    if !doc.is_list(arr_node) { << out }
    for i in 0:doc.count(arr_node) {
        el := doc.at(arr_node, i)
        if doc.is_dict(el) && doc.has(el, "a") {
            astr := json_str_or(doc, doc.get(el, "a"), "")
            addr := udp_addr_from_str(astr + "") or (err) { -> }
            out.push(addr)
        }
    }
    << out
}

fn p2p_punch_and_session(
    opts &CliOpts,
    pconn $&net.PacketConn,
    ciph &aes.Cipher,
    session string,
    peer_id string,
    cands &[]net.UDPAddr,
    is_initiator bool,
    stdio_mode bool,
    tcp_fd_in int,
    lfd_in int
) int {
    pconn_deadline_q(pconn, 50000000)
    $peer_addr := net.UDPAddr{ip: "", port: 0, zone: ""}
    $connected := false
    $bytes_in := 0
    $bytes_out := 0
    $expected_seq := 1
    $got_fin := false
    empty := ""
    t_start := time.now_time().unix()

    // Hole punching loop up to 10s
    for round in 0:200 {
        if time.now_time().unix() - t_start > 10 { <- }
        punch_pkt := seal_pkt_q(ciph, session + "", P2P_PKT_PUNCH, 0, &empty)
        if punch_pkt.len > 0 {
            for i in 0:cands.len {
                ca := &cands[i]
                pconn_write_q(pconn, &punch_pkt, ca)
            }
        }
        pconn_deadline_q(pconn, 50000000)
        upkt := pconn.read_from(4096) or (err) {
            ->
        }
        opened := p2p_open_packet(ciph, session + "", &upkt.data)
        if opened.ok {
            peer_addr = net.UDPAddr{ip: upkt.addr.ip + "", port: upkt.addr.port, zone: ""}
            if opened.ptype == P2P_PKT_PUNCH {
                ack_pkt := seal_pkt_q(ciph, session + "", P2P_PKT_ACK, 0, &empty)
                if ack_pkt.len > 0 {
                    pconn_write_q(pconn, &ack_pkt, &peer_addr)
                }
                connected = true
                <-
            } else if opened.ptype == P2P_PKT_ACK {
                connected = true
                <-
            } else if opened.ptype == P2P_PKT_DATA {
                send_ack_q(pconn, ciph, session + "", opened.seq, &peer_addr)
                if opened.seq >= expected_seq {
                    if stdio_mode && !is_initiator {
                        bytes_in += opened.data.len
                        fd_write_q(1, opened.data + "")
                        expected_seq = opened.seq + 1
                    } else if !stdio_mode && tcp_fd_in >= 0 {
                        bytes_in += opened.data.len
                        net_write_q(tcp_fd_in, &opened.data)
                        expected_seq = opened.seq + 1
                    }
                }
                connected = true
                <-
            } else if opened.ptype == P2P_PKT_FIN {
                got_fin = true
                connected = true
                <-
            }
        }
    }
    if !connected {
        p2p_log(opts, "failed", session + "", peer_id + "", "\"reason\":\"punch_timeout\"")
        << EXIT_P2P
    }
    p2p_log(opts, "connected", session + "", peer_id + "", "\"path\":\"direct\"")

    $tcp_fd := tcp_fd_in
    if !stdio_mode && tcp_fd < 0 && lfd_in >= 0 {
        tcp_fd = net_accept_or(lfd_in)
        net_close_q(lfd_in)
    }

    if stdio_mode {
        if is_initiator {
            // Brief settle so peer finishes handshake before DATA packets arrive
            time.sleep(50000000)
            // Read stdin, split into <= P2P_MTU_CHUNK packets, and wait for ACK(seq) per chunk
            $seq := 1
            $aborted := false
            while !aborted {
                raw_in := os.fd_read(0, 8192) or (err) { <- }
                if raw_in.len == 0 { <- }
                $chunks := []string{}
                push_mtu_chunks($&chunks, &raw_in)
                for ci in 0:chunks.len {
                    ch_s := chunks[ci] + ""
                    bytes_out += ch_s.len
                    dpkt := p2p_seal_packet(ciph, session + "", P2P_PKT_DATA, seq, &ch_s) or (err) {
                        aborted = true
                        <-
                    }
                    $ack_ok := false
                    $tries := 0
                    while !ack_ok && tries < 8 {
                        pconn.write_to(&dpkt, &peer_addr) or (err) {
                            aborted = true
                            <-
                        }
                        tries += 1
                        t_sent := time.now()
                        while !ack_ok && time.now() - t_sent < 60000000 {
                            pconn_deadline_q(pconn, 10000000)
                            upkt := read_from_or(pconn, 65535)
                            if upkt.data.len > 0 {
                                opened := p2p_open_packet(ciph, session + "", &upkt.data)
                                if opened.ok {
                                    if opened.ptype == P2P_PKT_ACK && opened.seq == seq {
                                        ack_ok = true
                                    } else if opened.ptype == P2P_PKT_PUNCH {
                                        send_ack_q(pconn, ciph, session + "", 0, &peer_addr)
                                    } else if opened.ptype == P2P_PKT_PING {
                                        send_ctrl_pkt_q(pconn, ciph, session + "", P2P_PKT_PONG, &peer_addr)
                                    }
                                }
                            }
                        }
                    }
                    if aborted { <- }
                    seq += 1
                }
            }
            fin_pkt := seal_pkt_q(ciph, session + "", P2P_PKT_FIN, seq, &empty)
            if fin_pkt.len > 0 {
                for r in 0:3 {
                    pconn_write_q(pconn, &fin_pkt, &peer_addr)
                }
            }
        } else {
            // Receiver: read UDP packets until FIN or idle timeout after data
            $idle := 0
            while !got_fin {
                pconn_deadline_q(pconn, 500000000)
                upkt := pconn.read_from(65535) or (err) {
                    idle += 1
                    if idle > 10 { <- }
                    ->
                }
                idle = 0
                opened := p2p_open_packet(ciph, session + "", &upkt.data)
                if !opened.ok { -> }
                if opened.ptype == P2P_PKT_PUNCH {
                    send_ack_q(pconn, ciph, session + "", 0, &peer_addr)
                    ->
                }
                if opened.ptype == P2P_PKT_PING {
                    send_ctrl_pkt_q(pconn, ciph, session + "", P2P_PKT_PONG, &peer_addr)
                    ->
                }
                if opened.ptype == P2P_PKT_DATA {
                    send_ack_q(pconn, ciph, session + "", opened.seq, &peer_addr)
                    if opened.seq >= expected_seq {
                        bytes_in += opened.data.len
                        fd_write_q(1, opened.data + "")
                        expected_seq = opened.seq + 1
                    }
                    ->
                }
                if opened.ptype == P2P_PKT_FIN {
                    <-
                }
            }
        }
    } else if tcp_fd >= 0 {
        // Single-task non-blocking TCP + UDP bridge (avoids 2-task poll contention)
        $tx_q := []string{}
        $tx_head := 0
        $wait_ack := false
        $unacked_seq := 0
        $unacked_pkt := ""
        $unacked_ns := 0
        $unacked_tries := 0
        $last_tx_ns := time.now()
        $seq := 1
        $tcp_eof_seen := false
        $local_fin := false
        $remote_fin := got_fin
        if remote_fin {
            net_close_write_q(tcp_fd)
        }
        $fin_idle := 0
        while !(local_fin && remote_fin) {
            if !tcp_eof_seen {
                $reads := 0
                while reads < 8 && (tx_q.len - tx_head) < 16 {
                    ev_m := os.socket_wait(tcp_fd, 1, -1) or (err) {
                        tcp_eof_seen = true
                        <-
                    }
                    if (ev_m & 13) == 0 { <- }
                    chunk := net.conn_read(tcp_fd, 4096) or (err) {
                        tcp_eof_seen = true
                        <-
                    }
                    if chunk.len == 0 {
                        tcp_eof_seen = true
                        <-
                    }
                    push_mtu_chunks($&tx_q, &chunk)
                    reads += 1
                }
            }

            if !wait_ack && tx_head < tx_q.len {
                ch_s := tx_q[tx_head] + ""
                tx_head += 1
                if tx_head >= tx_q.len {
                    tx_q = []string{}
                    tx_head = 0
                }
                bytes_out += ch_s.len
                dpkt := seal_pkt_q(ciph, session + "", P2P_PKT_DATA, seq, &ch_s)
                if dpkt.len > 0 {
                    pconn.write_to(&dpkt, &peer_addr) or (err) { <- }
                    wait_ack = true
                    unacked_seq = seq
                    unacked_pkt = dpkt + ""
                    unacked_ns = time.now()
                    unacked_tries = 1
                    last_tx_ns = unacked_ns
                    seq += 1
                }
            } else if wait_ack && time.now() - unacked_ns >= 60000000 {
                if unacked_tries < 8 {
                    pconn.write_to(&unacked_pkt, &peer_addr) or (err) { <- }
                    unacked_ns = time.now()
                    unacked_tries += 1
                    last_tx_ns = unacked_ns
                } else {
                    wait_ack = false
                }
            }

            if !local_fin && tcp_eof_seen && tx_head >= tx_q.len && !wait_ack {
                local_fin = true
                fin_pkt := seal_pkt_q(ciph, session + "", P2P_PKT_FIN, seq, &empty)
                if fin_pkt.len > 0 {
                    for r in 0:3 { pconn_write_q(pconn, &fin_pkt, &peer_addr) }
                }
            }

            if !wait_ack && time.now() - last_tx_ns >= 15000000000 {
                send_ctrl_pkt_q(pconn, ciph, session + "", P2P_PKT_PING, &peer_addr)
                last_tx_ns = time.now()
            }

            $dl := 10000000
            if wait_ack { dl = 2000000 }
            pconn_deadline_q(pconn, dl)
            upkt := read_from_or(pconn, 65535)
            if upkt.data.len > 0 {
                opened := p2p_open_packet(ciph, session + "", &upkt.data)
                if opened.ok {
                    fin_idle = 0
                    if opened.ptype == P2P_PKT_ACK {
                        if wait_ack && opened.seq == unacked_seq {
                            wait_ack = false
                        }
                    } else if opened.ptype == P2P_PKT_PUNCH {
                        send_ack_q(pconn, ciph, session + "", 0, &peer_addr)
                    } else if opened.ptype == P2P_PKT_PING {
                        send_ctrl_pkt_q(pconn, ciph, session + "", P2P_PKT_PONG, &peer_addr)
                    } else if opened.ptype == P2P_PKT_DATA {
                        send_ack_q(pconn, ciph, session + "", opened.seq, &peer_addr)
                        if opened.seq >= expected_seq {
                            bytes_in += opened.data.len
                            _ := net.conn_write(tcp_fd, &opened.data) or (err) { <- }
                            expected_seq = opened.seq + 1
                        }
                    } else if opened.ptype == P2P_PKT_FIN {
                        if !remote_fin {
                            remote_fin = true
                            net_close_write_q(tcp_fd)
                        }
                    }
                }
            } else if local_fin || remote_fin {
                fin_idle += 1
                if fin_idle > 200 { <- }
            }
        }
        net_close_q(tcp_fd)
    }

    p2p_log(opts, "closed", session + "", peer_id + "", "\"bytes_in\":" + strconv.itoa(bytes_in) + ",\"bytes_out\":" + strconv.itoa(bytes_out))
    << EXIT_OK
}

fn check_is_friend(api_base string, timeout_sec int, self_id string, priv &rsa.PrivateKey, peer_id string) bool {
    empty := ""
    r := api_call(api_base, timeout_sec, self_id, priv, true, "GET", "/v1/friends", &empty, "")
    if !r.ok { << false }
    doc := json.parse(&r.body)
    if !doc.ok() || !doc.has(doc.root(), "friends") { << false }
    arr := doc.get(doc.root(), "friends")
    if !doc.is_list(arr) { << false }
    for i in 0:doc.count(arr) {
        el := doc.at(arr, i)
        if doc.is_string(el) {
            if json_str_or(&doc, el, "") == peer_id { << true }
        } else if doc.is_dict(el) && doc.has(el, "agent_id") {
            if json_str_or(&doc, doc.get(el, "agent_id"), "") == peer_id { << true }
        }
    }
    << false
}

fn p2p_star_worker(
    json_mode bool,
    bus_mode bool,
    pconn_in net.PacketConn,
    ciph aes.Cipher,
    sess string,
    from_id string,
    cands []net.UDPAddr,
    rport int,
    bus_ch chan BusMsg,
    guard_ch chan StarGuardMsg
) {
    opts := CliOpts{
        json_mode: json_mode,
        config_path: "",
        api_override: "",
        timeout_sec: 30,
        pow_bits_override: 0
    }
    if bus_mode {
        p2p_star_bus_worker(opts, pconn_in, ciph, sess + "", from_id + "", cands, bus_ch, guard_ch)
        <<
    }
    p2p_star_forward_worker(opts, pconn_in, ciph, sess + "", from_id + "", cands, rport, guard_ch)
}

fn handle_incoming_p2p_offer(
    opts &CliOpts,
    sc $&SseConn,
    cfg &Config,
    priv &rsa.PrivateKey,
    friends_only bool,
    stdio_mode bool,
    star_mode bool,
    bus_mode bool,
    expose_ports &[]int,
    stun_hp string,
    bus_ch chan BusMsg,
    guard_ch chan StarGuardMsg,
    ev_data &string
) int {
    d := json.parse(ev_data)
    if !d.ok() || !d.has(d.root(), "from") || !d.has(d.root(), "frame") { << -1 }
    from_id := json_str_or(&d, d.get(d.root(), "from"), "")
    frame_json := json_encode_or(&d, d.get(d.root(), "frame"), "")

    fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, from_id + "")
    dec := decrypt_dm_frame(cfg.agent_id + "", priv, from_id + "", &fk.pk, fk.ok, &frame_json)
    if !dec.ok || !dec.verified || dec.msg_type != "p2p_offer" { << -1 }
    now0 := time.now_time().unix()
    if dec.ts <= 0 || (now0 - dec.ts) > 60 || (dec.ts - now0) > 60 { << -1 }
    if dec.nonce.len > 0 && !check_and_record_nonce_in(cfg.home + "", "p2p_nonces.jsonl", dec.nonce + "", now0) { << -1 }

    odoc := json.parse(&dec.body_json)
    if !odoc.ok() { << -1 }
    oroot := odoc.root()
    sess := json_str_or(&odoc, odoc.get(oroot, "session"), "")
    exp := json_int_or(&odoc, odoc.get(oroot, "expires_at"), 0)
    now := time.now_time().unix()
    if exp > 0 && now > exp { << -1 }

    mode := json_str_or(&odoc, odoc.get(oroot, "mode"), "stdio")
    rport := json_int_or(&odoc, odoc.get(oroot, "remote_port"), 0)
    xpub_b64 := json_str_or(&odoc, odoc.get(oroot, "x25519_pub"), "")
    cands := extract_candidate_addrs(&odoc, odoc.get(oroot, "candidates"))

    $accept := true
    $reason := ""
    if friends_only && !check_is_friend(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, from_id + "") {
        accept = false
        reason = "not_friend"
    }
    if accept && bus_mode && mode != "bus" {
        accept = false
        reason = "bus_mode_only"
    }
    if accept && !bus_mode && mode == "bus" {
        accept = false
        reason = "bus_not_enabled"
    }
    if accept && star_mode && !bus_mode && mode != "forward" {
        accept = false
        reason = "star_requires_forward_or_bus"
    }
    if accept && mode == "forward" {
        $allowed := false
        for j in 0:expose_ports.len {
            if expose_ports[j] == rport { allowed = true }
        }
        if !allowed {
            accept = false
            reason = "port_not_exposed"
        }
    }
    $got_slot := false
    if accept && star_mode {
        if !star_guard_acquire(guard_ch) {
            accept = false
            reason = "max_peers_reached"
        } else {
            got_slot = true
        }
    }
    if !accept {
        ans_rej := "{\"session\":" + json.quote(&sess) + ",\"accept\":false,\"reason\":" + json.quote(&reason) + "}"
        rej_frame := encrypt_dm_or(cfg.agent_id + "", priv, from_id + "", &fk.pk, fk.key_version, "p2p_answer", ans_rej, "open", now)
        if rej_frame.len > 0 {
            _ := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, true, "POST", "/v1/dm/" + from_id, &rej_frame, "")
        }
        << -1
    }

    $pconn := net.listen_packet("udp4", "0.0.0.0:0") or (err) {
        if got_slot { star_guard_release(guard_ch) }
        if star_mode { << -1 }
        sse_close(sc)
        << emit_err(opts, "ERR_P2P", 0, err.msg(), 0, EXIT_P2P)
    }
    lport := local_port_of(&pconn)
    pconn_deadline_q($&pconn, 1500000000)
    srflx := stun_discover(&pconn, stun_hp + "")

    xpriv := ecdh.generate_key(ecdh.x25519()) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        if star_mode { << -1 }
        sse_close(sc)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    xpub_bytes := xpriv.public_key().bytes()
    my_xpub_b64 := base64.encode_to_string(xpub_bytes)

    peer_xpub_raw := base64.decode_string(xpub_b64) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        << -1
    }
    peer_xpub := ecdh.new_public_key(ecdh.x25519(), &peer_xpub_raw) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        << -1
    }
    shared := xpriv.ecdh(&peer_xpub) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        << -1
    }
    sess_key := p2p_derive_key(sess + "", &shared)
    ciph := aes.new_cipher(&sess_key) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        << -1
    }

    cands_json := build_candidates_json(lport, srflx)
    ans_body := "{\"session\":" + json.quote(&sess) + ",\"accept\":true,\"candidates\":" + cands_json + ",\"x25519_pub\":" + json.quote(&my_xpub_b64) + "}"
    ans_frame := encrypt_dm_or(cfg.agent_id + "", priv, from_id + "", &fk.pk, fk.key_version, "p2p_answer", ans_body, "open", now)
    _ := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, true, "POST", "/v1/dm/" + (from_id + ""), &ans_frame, "")
    p2p_log(opts, "offer_accepted", sess + "", from_id + "", "")

    if !star_mode {
        sse_close(sc)
        $tcp_fd := -1
        if mode == "forward" && !stdio_mode {
            tcp_fd = net_dial_or("127.0.0.1:" + strconv.itoa(rport))
        }
        rc := p2p_punch_and_session(opts, $&pconn, &ciph, sess + "", from_id + "", &cands, false, stdio_mode || mode == "stdio", tcp_fd, -1)
        pconn_close_q($&pconn)
        << rc
    }

    xu p2p_star_worker(opts.json_mode, bus_mode, pconn, ciph, sess + "", from_id + "", cands, rport, bus_ch, guard_ch)
    << -1
}

pub fn cmd_p2p_listen(opts &CliOpts, args []string) int {
    $friends_only := true
    $expose_ports := []int{}
    $stdio_mode := false
    $star_mode := false
    $bus_mode := false
    $max_peers := 32
    $has_max_peers := false
    $stun_hp := "stun.cloudflare.com:3478"
    $i := 0
    while i < args.len {
        a := args[i] + ""
        if a == "--allow-friends-only" {
            friends_only = true
        } else if a == "--allow-anyone" {
            friends_only = false
        } else if a == "--stdio" {
            stdio_mode = true
        } else if a == "--star" || a == "--hub" {
            star_mode = true
        } else if a == "--bus" {
            bus_mode = true
            star_mode = true
        } else if a == "--max-peers" && i + 1 < args.len {
            i += 1
            max_peers = parse_int_or(&args[i], 32)
            has_max_peers = true
        } else if a == "--expose" && i + 1 < args.len {
            i += 1
            parts := strings.split(&args[i], ",")
            for j in 0:parts.len {
                p := atoi_or_0(&strings.trim_space(&parts[j]))
                if p > 0 { expose_ports.push(p) }
            }
        } else if a == "--stun" && i + 1 < args.len {
            i += 1
            stun_hp = args[i] + ""
        } else {
            << emit_err(opts, "ERR_USAGE", 0, "unknown p2p listen flag: " + a, 0, EXIT_USAGE)
        }
        i += 1
    }
    if stdio_mode && (star_mode || bus_mode) {
        << emit_err(opts, "ERR_USAGE", 0, "--stdio cannot be combined with --star or --bus", 0, EXIT_USAGE)
    }
    if !star_mode && !has_max_peers {
        max_peers = 1
    }

    cfg := load_config(opts) or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    priv := load_private_key_checked(cfg.home + "") or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }

    guard_ch := chan StarGuardMsg{cap: 64}
    if star_mode {
        xu star_guard_loop(max_peers, guard_ch)
    }
    bus_ch := chan BusMsg{cap: 128}
    if bus_mode {
        xu star_bus_loop(cfg.agent_id + "", bus_ch)
    }

    $extra_listen := ""
    if bus_mode {
        extra_listen = "\"topology\":\"star\",\"mode\":\"bus\",\"max_peers\":" + strconv.itoa(max_peers)
    } else if star_mode {
        extra_listen = "\"topology\":\"star\",\"max_peers\":" + strconv.itoa(max_peers)
    }

    $backoff_ms := 500
    $connected_once := false
    $stop_listen := false
    while !stop_listen {
        $sc := empty_sse_conn()
        out := sse_connect_into(cfg.api_base + "", cfg.agent_id + "", &priv, "/v1/stream", $&sc)
        if !out.ok {
            if out.http_status == 401 {
                << emit_err(opts, "ERR_AUTH", 401, out.err_msg + "", 0, EXIT_AUTH)
            }
            if out.http_status == 403 {
                << emit_err(opts, "ERR_FORBIDDEN", 403, out.err_msg + "", 0, EXIT_FORBIDDEN)
            }
            if !connected_once || !star_mode {
                << emit_err(opts, "ERR_NETWORK", out.http_status, out.err_msg + "", 0, EXIT_NET)
            }
            time.sleep(jitter_ms(backoff_ms) * 1000000)
            backoff_ms = backoff_ms * 2
            if backoff_ms > 30000 { backoff_ms = 30000 }
            ->
        }
        if !connected_once {
            if bus_mode {
                xu hub_stdin_bridge(bus_ch)
            }
            p2p_log(opts, "listening", "", cfg.agent_id + "", extra_listen)
        } else {
            p2p_log(opts, "reconnected", "", cfg.agent_id + "", extra_listen)
        }
        connected_once = true
        backoff_ms = 500

        while true {
            ev := sse_read_event($&sc)
            if ev.eof { <- }
            if !ev.ok { -> }
            if ev.event_type == "system" {
                sd := json.parse(&ev.data)
                if sd.ok() && sd.is_dict(sd.root()) {
                    sk := json_str_or(&sd, sd.get(sd.root(), "kind"), "")
                    if sk == "disconnected" || sk == "key_rotated" {
                        stop_listen = true
                        <-
                    }
                }
                ->
            }
            if ev.event_type != "dm" { -> }
            rc := handle_incoming_p2p_offer(
                opts, $&sc, &cfg, &priv, friends_only, stdio_mode, star_mode, bus_mode,
                &expose_ports, stun_hp + "", bus_ch, guard_ch, &ev.data
            )
            if rc >= 0 {
                << rc
            }
        }
        sse_close($&sc)
        if !star_mode || stop_listen { <- }
        time.sleep(jitter_ms(backoff_ms) * 1000000)
        backoff_ms = backoff_ms * 2
        if backoff_ms > 30000 { backoff_ms = 30000 }
    }
    << EXIT_OK
}

pub fn cmd_p2p_connect(opts &CliOpts, args []string) int {
    if args.len < 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext p2p connect <agent_id> [--forward L:R | --bus] [--relay URL] [--stun HOST:PORT]", 0, EXIT_USAGE)
    }
    peer_id := args[0] + ""
    if !is_valid_agent_id(peer_id + "") {
        << emit_err(opts, "ERR_USAGE", 0, "invalid peer agent_id: " + peer_id, 0, EXIT_USAGE)
    }
    $lport_fwd := 0
    $rport_fwd := 0
    $forward_mode := false
    $bus_mode := false
    $stun_hp := "stun.cloudflare.com:3478"
    $i := 1
    while i < args.len {
        a := args[i] + ""
        if a == "--forward" && i + 1 < args.len {
            i += 1
            ps := strings.split(&args[i], ":")
            if ps.len != 2 {
                << emit_err(opts, "ERR_USAGE", 0, "--forward requires <local_port>:<remote_port>", 0, EXIT_USAGE)
            }
            lport_fwd = parse_int_or(&ps[0], 0)
            rport_fwd = parse_int_or(&ps[1], 0)
            if lport_fwd <= 0 || rport_fwd <= 0 {
                << emit_err(opts, "ERR_USAGE", 0, "invalid --forward ports", 0, EXIT_USAGE)
            }
            forward_mode = true
        } else if a == "--bus" {
            bus_mode = true
        } else if a == "--stun" && i + 1 < args.len {
            i += 1
            stun_hp = args[i] + ""
        } else if a == "--relay" && i + 1 < args.len {
            i += 1
        } else {
            << emit_err(opts, "ERR_USAGE", 0, "unknown p2p connect flag: " + a, 0, EXIT_USAGE)
        }
        i += 1
    }
    if forward_mode && bus_mode {
        << emit_err(opts, "ERR_USAGE", 0, "--forward and --bus are mutually exclusive", 0, EXIT_USAGE)
    }

    cfg := load_config(opts) or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    priv := load_private_key_checked(cfg.home + "") or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, peer_id + "")
    if !fk.ok {
        << emit_err(opts, fk.err_code + "", 0, fk.err_msg + "", 0, fk.exit_code)
    }

    $sc := sse_connect(cfg.api_base + "", cfg.agent_id + "", &priv, "/v1/stream") or (err) {
        << emit_err(opts, "ERR_NETWORK", 0, err.msg(), 0, EXIT_NET)
    }
    $pconn := net.listen_packet("udp4", "0.0.0.0:0") or (err) {
        sse_close($&sc)
        << emit_err(opts, "ERR_P2P", 0, err.msg(), 0, EXIT_P2P)
    }
    lport := local_port_of(&pconn)
    pconn_deadline_q($&pconn, 1500000000)
    srflx := stun_discover(&pconn, stun_hp + "")

    xpriv := ecdh.generate_key(ecdh.x25519()) or (err) {
        pconn_close_q($&pconn)
        sse_close($&sc)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    xpub_b64 := base64.encode_to_string(xpriv.public_key().bytes())
    sess := gen_sess_or()
    now := time.now_time().unix()
    $mode_s := "stdio"
    if forward_mode { mode_s = "forward" }
    else if bus_mode { mode_s = "bus" }
    cands_json := build_candidates_json(lport, srflx)
    offer_body := "{\"session\":" + json.quote(&sess) +
        ",\"candidates\":" + cands_json +
        ",\"x25519_pub\":" + json.quote(&xpub_b64) +
        ",\"mode\":" + json.quote(&mode_s) +
        ",\"remote_port\":" + strconv.itoa(rport_fwd) +
        ",\"relay\":false,\"expires_at\":" + strconv.itoa(now + 60) + "}"

    offer_frame := encrypt_dm_frame(cfg.agent_id + "", &priv, peer_id + "", &fk.pk, fk.key_version, "p2p_offer", offer_body, "open", now) or (err) {
        pconn_close_q($&pconn)
        sse_close($&sc)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    dm_r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/dm/" + (peer_id + ""), &offer_frame, "")
    if !dm_r.ok {
        pconn_close_q($&pconn)
        sse_close($&sc)
        << emit_err(opts, dm_r.err_code + "", dm_r.status, dm_r.err_msg + "", dm_r.retry_after, map_http_exit_code(dm_r.status, dm_r.err_code + ""))
    }
    p2p_log(opts, "offer_sent", sess + "", peer_id + "", "")

    // Wait for matching p2p_answer over SSE
    $peer_cands := []net.UDPAddr{}
    $peer_xpub_b64 := ""
    $got_answer := false
    while true {
        ev := sse_read_event($&sc)
        if ev.eof { <- }
        if !ev.ok || ev.event_type != "dm" { -> }
        d := json.parse(&ev.data)
        if !d.ok() || !d.has(d.root(), "from") || !d.has(d.root(), "frame") { -> }
        from_id := json_str_or(&d, d.get(d.root(), "from"), "")
        if from_id != peer_id { -> }
        frame_json := json_encode_or(&d, d.get(d.root(), "frame"), "")
        dec := decrypt_dm_frame(cfg.agent_id + "", &priv, peer_id + "", &fk.pk, true, &frame_json)
        if !dec.ok || !dec.verified || dec.msg_type != "p2p_answer" { -> }
        now_a := time.now_time().unix()
        if dec.ts <= 0 || (now_a - dec.ts) > 60 || (dec.ts - now_a) > 60 { -> }
        if dec.nonce.len > 0 && !check_and_record_nonce_in(cfg.home + "", "p2p_nonces.jsonl", dec.nonce + "", now_a) { -> }
        ad := json.parse(&dec.body_json)
        if !ad.ok() { -> }
        ar := ad.root()
        if json_str_or(&ad, ad.get(ar, "session"), "") != sess { -> }
        acc := json_bool_or(&ad, ad.get(ar, "accept"), false)
        if !acc {
            rsn := json_str_or(&ad, ad.get(ar, "reason"), "rejected")
            pconn_close_q($&pconn)
            sse_close($&sc)
            << emit_err(opts, "ERR_P2P_REJECTED", 0, "peer rejected offer: " + rsn, 0, EXIT_P2P)
        }
        peer_cands = extract_candidate_addrs(&ad, ad.get(ar, "candidates"))
        peer_xpub_b64 = json_str_or(&ad, ad.get(ar, "x25519_pub"), "")
        got_answer = true
        <-
    }
    sse_close($&sc)
    if !got_answer || peer_cands.len == 0 || peer_xpub_b64.len == 0 {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_P2P", 0, "no valid p2p_answer received", 0, EXIT_P2P)
    }

    px_raw := base64.decode_string(peer_xpub_b64) or (err) {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_CRYPTO", 0, "invalid peer x25519 key", 0, EXIT_CRYPTO)
    }
    px := ecdh.new_public_key(ecdh.x25519(), &px_raw) or (err) {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_CRYPTO", 0, "invalid peer x25519 key", 0, EXIT_CRYPTO)
    }
    shared := xpriv.ecdh(&px) or (err) {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    sess_key := p2p_derive_key(sess + "", &shared)
    ciph := aes.new_cipher(&sess_key) or (err) {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }

    if bus_mode {
        rc := p2p_bus_client_session(opts, $&pconn, &ciph, sess + "", peer_id + "", cfg.agent_id + "", &peer_cands)
        pconn_close_q($&pconn)
        << rc
    }

    $lfd := -1
    if forward_mode {
        lfd = net.listen("127.0.0.1:" + strconv.itoa(lport_fwd)) or (err) {
            pconn_close_q($&pconn)
            << emit_err(opts, "ERR_P2P", 0, err.msg(), 0, EXIT_P2P)
        }
    }
    rc := p2p_punch_and_session(opts, $&pconn, &ciph, sess + "", peer_id + "", &peer_cands, true, !forward_mode, -1, lfd)
    net_close_q(lfd)
    pconn_close_q($&pconn)
    << rc
}

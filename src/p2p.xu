@main

#errors
#crypto/ecdh
#crypto/rsa
#encoding/base64
#encoding/json
#flag
#net
#os
#strconv
#strings
#time

fn p2p_stdin_line_reader(line_ch chan string, eof_ch chan int) {
    $buf := ""
    while true {
        rdy := os.fd_wait_read(0, 50000000) or (err) { <- }
        if rdy == 0 { -> }
        chunk := os.fd_read(0, 4096) or (err) { <- }
        if chunk.len == 0 { <- }
        buf = buf + chunk
        while true {
            nl := strings.index_of(&buf, "\n")
            if nl < 0 { <- }
            $ln := buf[0:nl] + ""
            if strings.has_suffix(&ln, "\r") {
                ln = ln[0:(ln.len - 1)] + ""
            }
            buf = buf[(nl + 1):buf.len] + ""
            if ln.len > 0 {
                line_ch <- ln
            }
        }
    }
    rem := strings.trim_space(&buf)
    if rem.len > 0 {
        line_ch <- rem
    }
    select {
        eof_ch <- 1 {}
        else {}
    }
}

struct StarGuardMsg {
    acquire bool
    reply_ch chan bool
}

fn star_guard_loop(max_peers int, ch chan StarGuardMsg) {
    $active := 0
    while true {
        msg := <-ch
        if msg.acquire {
            $ok := true
            if max_peers > 0 && active >= max_peers { ok = false }
            if ok { active += 1 }
            msg.reply_ch <- ok
        } else {
            if active > 0 { active -= 1 }
        }
    }
}

fn star_guard_acquire(ch chan StarGuardMsg) bool {
    rc := chan bool{cap: 1}
    ch <- StarGuardMsg{acquire: true, reply_ch: rc}
    << <-rc
}

fn star_guard_release(ch chan StarGuardMsg) {
    ch <- StarGuardMsg{acquire: false, reply_ch: chan bool{cap: 1}}
}

const BUS_JOIN = 1
const BUS_LEAVE = 2
const BUS_INBOUND = 3
const BUS_HUB_SEND = 4

struct BusPeer {
    agent_id string
    session string
    tx_ch chan string
}

struct BusMsg {
    kind int
    agent_id string
    to_id string
    session string
    text string
    tx_ch chan string
}

struct ParsedBusFrame {
    from_id string
    to_id string
    text string
}

fn parse_bus_frame(raw &string, default_from string, default_to string) ParsedBusFrame {
    d := json.parse(raw)
    if d.ok() && d.is_dict(d.root()) && d.has(d.root(), "text") {
        rt := d.root()
        $fr := default_from + ""
        $to := default_to + ""
        if d.has(rt, "from") {
            fv := json_str_or(&d, d.get(rt, "from"), "")
            if fv.len > 0 { fr = fv }
        }
        if d.has(rt, "to") {
            tv := json_str_or(&d, d.get(rt, "to"), "")
            if tv.len > 0 { to = tv }
        }
        tx := json_str_or(&d, d.get(rt, "text"), "")
        << ParsedBusFrame{from_id: fr, to_id: to, text: tx}
    }
    << ParsedBusFrame{from_id: default_from + "", to_id: default_to + "", text: raw + ""}
}

fn bus_emit_jsonl(from_id &string, to_id &string, session &string, text &string) {
    fd_write_q(1, "{\"type\":\"p2p_msg\",\"from\":" + json.quote(from_id) + ",\"to\":" + json.quote(to_id) + ",\"session\":" + json.quote(session) + ",\"text\":" + json.quote(text) + "}\n")
}

fn star_bus_loop(self_id string, ch chan BusMsg) {
    $peers := []BusPeer{}
    while true {
        msg := <-ch
        if msg.kind == BUS_JOIN {
            $next := []BusPeer{}
            for i in 0:peers.len {
                if peers[i].agent_id != msg.agent_id {
                    next.push(BusPeer{agent_id: peers[i].agent_id + "", session: peers[i].session + "", tx_ch: peers[i].tx_ch})
                }
            }
            next.push(BusPeer{agent_id: msg.agent_id + "", session: msg.session + "", tx_ch: msg.tx_ch})
            peers = next
        } else if msg.kind == BUS_LEAVE {
            $next := []BusPeer{}
            for i in 0:peers.len {
                if peers[i].session != msg.session {
                    next.push(BusPeer{agent_id: peers[i].agent_id + "", session: peers[i].session + "", tx_ch: peers[i].tx_ch})
                }
            }
            peers = next
        } else if msg.kind == BUS_INBOUND {
            bus_emit_jsonl(&msg.agent_id, &msg.to_id, &msg.session, &msg.text)
            fwd := "{\"from\":" + json.quote(&msg.agent_id) + ",\"to\":" + json.quote(&msg.to_id) + ",\"text\":" + json.quote(&msg.text) + "}"
            if msg.to_id == "*" {
                for i in 0:peers.len {
                    if peers[i].session != msg.session && peers[i].agent_id != msg.agent_id {
                        select {
                            peers[i].tx_ch <- (fwd + "") {}
                            else {}
                        }
                    }
                }
            } else if msg.to_id != self_id {
                for i in 0:peers.len {
                    if peers[i].agent_id == msg.to_id {
                        select {
                            peers[i].tx_ch <- (fwd + "") {}
                            else {}
                        }
                    }
                }
            }
        } else if msg.kind == BUS_HUB_SEND {
            fwd := "{\"from\":" + json.quote(&self_id) + ",\"to\":" + json.quote(&msg.to_id) + ",\"text\":" + json.quote(&msg.text) + "}"
            if msg.to_id == "*" {
                for i in 0:peers.len {
                    select {
                        peers[i].tx_ch <- (fwd + "") {}
                        else {}
                    }
                }
            } else {
                for i in 0:peers.len {
                    if peers[i].agent_id == msg.to_id {
                        select {
                            peers[i].tx_ch <- (fwd + "") {}
                            else {}
                        }
                    }
                }
            }
        }
    }
}

fn hub_stdin_bridge(bus_ch chan BusMsg) {
    line_ch := chan string{cap: 64}
    eof_ch := chan int{cap: 1}
    xu p2p_stdin_line_reader(line_ch, eof_ch)
    $alive := true
    while alive {
        select {
            ln := <-line_ch {
                pf := parse_bus_frame(&ln, "hub", "*")
                bus_ch <- BusMsg{kind: BUS_HUB_SEND, agent_id: "", to_id: pf.to_id + "", session: "hub", text: pf.text + "", tx_ch: chan string{cap: 1}}
            }
            _ := <-eof_ch {
                alive = false
            }
        }
    }
}

fn p2p_star_forward_worker(
    opts CliOpts,
    pconn_in net.PacketConn,
    ciph_in P2PCiphers,
    sess string,
    from_id string,
    cands []net.UDPAddr,
    rport int,
    guard_ch chan StarGuardMsg
) {
    $pconn := pconn_in
    $ciph := ciph_in
    _ := p2p_punch_and_session(&opts, $&pconn, $&ciph, sess + "", from_id + "", &cands, false, false, -1, -1, rport)
    pconn_close_q($&pconn)
    star_guard_release(guard_ch)
}

fn p2p_star_bus_worker(
    opts CliOpts,
    pconn_in net.PacketConn,
    ciph_in P2PCiphers,
    sess string,
    from_id string,
    cands []net.UDPAddr,
    bus_ch chan BusMsg,
    guard_ch chan StarGuardMsg
) {
    $pconn := pconn_in
    $ciph := ciph_in
    $tr := make_p2p_transport(sess + "", from_id + "", &net.UDPAddr{ip: "", port: 0, zone: ""})
    if !p2p_punch_handshake(&opts, $&pconn, $&ciph, sess + "", from_id + "", &cands, $&tr) {
        pconn_close_q($&pconn)
        star_guard_release(guard_ch)
        <<
    }
    p2p_log(&opts, "connected", sess + "", from_id + "", "\"path\":\"direct\",\"topology\":\"star\",\"mode\":\"bus\"")

    tx_ch := chan string{cap: 64}
    bus_ch <- BusMsg{kind: BUS_JOIN, agent_id: from_id + "", to_id: "", session: sess + "", text: "", tx_ch: tx_ch}

    $rx_buf := ""
    $alive := true
    while alive {
        $drain := true
        while drain {
            select {
                out_msg := <-tx_ch {
                    wire := out_msg + "\n"
                    p2p_tr_enqueue($&tr, &wire)
                }
                else {
                    drain = false
                }
            }
        }

        if !p2p_tr_flush_tx($&tr, $&pconn, $&ciph) {
            alive = false
            <-
        }

        $dl := 10000000
        if p2p_tr_tx_pending(&tr) > 0 { dl = 2000000 }
        p2p_tr_poll_udp($&tr, $&pconn, $&ciph, dl, 32)

        rx := p2p_tr_take_rx($&tr)
        if rx.len > 0 {
            if rx_buf.len + rx.len > 1048576 {
                alive = false
                <-
            }
            rx_buf = rx_buf + rx
            while true {
                nl := strings.index_of(&rx_buf, "\n")
                if nl < 0 { <- }
                ln := rx_buf[0:nl] + ""
                rx_buf = rx_buf[(nl + 1):rx_buf.len] + ""
                if ln.len > 0 {
                    pf := parse_bus_frame(&ln, from_id + "", "*")
                    bus_ch <- BusMsg{kind: BUS_INBOUND, agent_id: from_id + "", to_id: pf.to_id + "", session: sess + "", text: pf.text + "", tx_ch: chan string{cap: 1}}
                }
            }
        }
        if tr.remote_fin {
            alive = false
        }
    }

    bus_ch <- BusMsg{kind: BUS_LEAVE, agent_id: from_id + "", to_id: "", session: sess + "", text: "", tx_ch: chan string{cap: 1}}
    pconn_close_q($&pconn)
    star_guard_release(guard_ch)
    p2p_log(&opts, "closed", sess + "", from_id + "", "\"bytes_in\":" + strconv.itoa(tr.bytes_in) + ",\"bytes_out\":" + strconv.itoa(tr.bytes_out))
}

fn p2p_bus_client_session(
    opts &CliOpts,
    pconn $&net.PacketConn,
    ciph $&P2PCiphers,
    sess string,
    peer_id string,
    self_id string,
    cands &[]net.UDPAddr
) int {
    $tr := make_p2p_transport(sess + "", peer_id + "", &net.UDPAddr{ip: "", port: 0, zone: ""})
    if !p2p_punch_handshake(opts, pconn, ciph, sess + "", peer_id + "", cands, $&tr) {
        << EXIT_P2P
    }
    p2p_log(opts, "connected", sess + "", peer_id + "", "\"path\":\"direct\",\"topology\":\"star\",\"mode\":\"bus\"")

    line_ch := chan string{cap: 64}
    eof_ch := chan int{cap: 1}
    xu p2p_stdin_line_reader(line_ch, eof_ch)

    $rx_buf := ""
    $stdin_eof := false
    $alive := true

    // Brief settle so hub worker registers tx_ch before initial DATA bursts
    time.sleep(30000000)

    while alive {
        $drain := !stdin_eof
        while drain {
            select {
                ln := <-line_ch {
                    pf := parse_bus_frame(&ln, self_id + "", "*")
                    wire := "{\"to\":" + json.quote(&pf.to_id) + ",\"text\":" + json.quote(&pf.text) + "}\n"
                    p2p_tr_enqueue($&tr, &wire)
                }
                else {
                    drain = false
                }
            }
        }
        if !stdin_eof {
            select {
                _ := <-eof_ch {
                    stdin_eof = true
                }
                else {}
            }
        }

        if !p2p_tr_flush_tx($&tr, pconn, ciph) {
            alive = false
            <-
        }

        if stdin_eof && p2p_tr_tx_pending(&tr) == 0 {
            p2p_tr_send_fin($&tr, pconn, ciph)
            alive = false
            <-
        }

        $dl := 10000000
        if p2p_tr_tx_pending(&tr) > 0 { dl = 2000000 }
        p2p_tr_poll_udp($&tr, pconn, ciph, dl, 32)

        rx := p2p_tr_take_rx($&tr)
        if rx.len > 0 {
            if rx_buf.len + rx.len > 1048576 {
                alive = false
                <-
            }
            rx_buf = rx_buf + rx
            while true {
                nl := strings.index_of(&rx_buf, "\n")
                if nl < 0 { <- }
                ln := rx_buf[0:nl] + ""
                rx_buf = rx_buf[(nl + 1):rx_buf.len] + ""
                if ln.len > 0 {
                    pf := parse_bus_frame(&ln, peer_id + "", self_id + "")
                    bus_emit_jsonl(&pf.from_id, &pf.to_id, &sess, &pf.text)
                }
            }
        }
        if tr.remote_fin {
            alive = false
        }
    }

    p2p_log(opts, "closed", sess + "", peer_id + "", "\"bytes_in\":" + strconv.itoa(tr.bytes_in) + ",\"bytes_out\":" + strconv.itoa(tr.bytes_out))
    << EXIT_OK
}

pub fn p2p_punch_and_session(
    opts &CliOpts,
    pconn $&net.PacketConn,
    ciph $&P2PCiphers,
    session string,
    peer_id string,
    cands &[]net.UDPAddr,
    is_initiator bool,
    stdio_mode bool,
    tcp_fd_in int,
    lfd_in int,
    target_rport int
) int {
    $tr := make_p2p_transport(session + "", peer_id + "", &net.UDPAddr{ip: "", port: 0, zone: ""})
    if !p2p_punch_handshake(opts, pconn, ciph, session + "", peer_id + "", cands, $&tr) {
        << EXIT_P2P
    }
    p2p_log(opts, "connected", session + "", peer_id + "", "\"path\":\"direct\"")

    $tcp_fd := tcp_fd_in
    if !stdio_mode && !is_initiator && tcp_fd < 0 && target_rport > 0 {
        tcp_fd = net_dial_or("127.0.0.1:" + strconv.itoa(target_rport))
        if tcp_fd < 0 {
            p2p_tr_send_fin($&tr, pconn, ciph)
            p2p_log(opts, "failed", session + "", peer_id + "", "\"reason\":\"target_dial_failed\"")
            << EXIT_P2P
        }
    }

    // Initiator --forward pre-accept loop: keepalive, buffer server-first banners, detect peer FIN
    $pre_rx_buf := p2p_tr_take_rx($&tr)
    if !stdio_mode && tcp_fd < 0 && lfd_in >= 0 {
        $aborted_pre := false
        while tcp_fd < 0 && !aborted_pre {
            ev_a := os.socket_wait(lfd_in, 1, -1) or (err) {
                aborted_pre = true
                <-
            }
            if (ev_a & 13) != 0 {
                tcp_fd = net_accept_or(lfd_in)
                net_close_q(lfd_in)
                <-
            }
            if !p2p_tr_flush_tx($&tr, pconn, ciph) {
                net_close_q(lfd_in)
                aborted_pre = true
                <-
            }
            p2p_tr_poll_udp($&tr, pconn, ciph, 10000000, 16)
            chunk := p2p_tr_take_rx($&tr)
            if chunk.len > 0 {
                if pre_rx_buf.len + chunk.len > 1048576 {
                    net_close_q(lfd_in)
                    aborted_pre = true
                    <-
                }
                pre_rx_buf = pre_rx_buf + chunk
            }
            if tr.remote_fin && pre_rx_buf.len == 0 {
                net_close_q(lfd_in)
                aborted_pre = true
                <-
            }
        }
        if aborted_pre || tcp_fd < 0 {
            net_close_q(lfd_in)
            p2p_log(opts, "closed", session + "", peer_id + "", "\"bytes_in\":" + strconv.itoa(tr.bytes_in) + ",\"bytes_out\":" + strconv.itoa(tr.bytes_out))
            << EXIT_P2P
        }
    }

    if !stdio_mode && tcp_fd >= 0 && pre_rx_buf.len > 0 {
        net_write_q(tcp_fd, &pre_rx_buf)
        pre_rx_buf = ""
    }

    if stdio_mode {
        if pre_rx_buf.len > 0 {
            fd_write_q(1, pre_rx_buf + "")
            pre_rx_buf = ""
        }
        if is_initiator {
            time.sleep(50000000)
            $stdin_eof := false
            $aborted := false
            $alive := true
            while alive {
                if !stdin_eof {
                    $reads := 0
                    while reads < 8 && p2p_tr_tx_pending(&tr) < 64 {
                        rdy := os.fd_wait_read(0, -1) or (err) {
                            stdin_eof = true
                            <-
                        }
                        if rdy == 0 { <- }
                        raw_in := os.fd_read(0, 8192) or (err) {
                            stdin_eof = true
                            <-
                        }
                        if raw_in.len == 0 {
                            stdin_eof = true
                            <-
                        }
                        p2p_tr_enqueue($&tr, &raw_in)
                        reads += 1
                    }
                }

                if !p2p_tr_flush_tx($&tr, pconn, ciph) {
                    aborted = true
                    alive = false
                    <-
                }

                if stdin_eof && p2p_tr_tx_pending(&tr) == 0 {
                    p2p_tr_send_fin($&tr, pconn, ciph)
                    alive = false
                    <-
                }

                $dl := 10000000
                if p2p_tr_tx_pending(&tr) > 0 { dl = 2000000 }
                p2p_tr_poll_udp($&tr, pconn, ciph, dl, 32)
                rx := p2p_tr_take_rx($&tr)
                if rx.len > 0 {
                    fd_write_q(1, rx + "")
                }
                if tr.remote_fin {
                    alive = false
                }
            }
            if aborted {
                p2p_log(opts, "failed", session + "", peer_id + "", "\"reason\":" + json.quote(&tr.fail_reason))
                << EXIT_P2P
            }
        } else {
            while !tr.remote_fin {
                if !p2p_tr_flush_tx($&tr, pconn, ciph) { <- }
                p2p_tr_poll_udp($&tr, pconn, ciph, 20000000, 32)
                rx := p2p_tr_take_rx($&tr)
                if rx.len > 0 {
                    fd_write_q(1, rx + "")
                }
            }
        }
    } else if tcp_fd >= 0 {
        $tcp_eof_seen := false
        $was_remote_fin := tr.remote_fin
        if was_remote_fin {
            net_close_write_q(tcp_fd)
        }
        while !(tr.local_fin && tr.remote_fin) {
            if !tcp_eof_seen {
                $reads := 0
                while reads < 8 && p2p_tr_tx_pending(&tr) < 64 {
                    ev_m := os.socket_wait(tcp_fd, 1, -1) or (err) {
                        tcp_eof_seen = true
                        <-
                    }
                    if (ev_m & 13) == 0 { <- }
                    chunk := net.conn_read(tcp_fd, 4096) or (err) {
                        tcp_eof_seen = true
                        <-
                    }
                    if chunk.len == 0 {
                        tcp_eof_seen = true
                        <-
                    }
                    p2p_tr_enqueue($&tr, &chunk)
                    reads += 1
                }
            }

            if !p2p_tr_flush_tx($&tr, pconn, ciph) { <- }

            if !tr.local_fin && tcp_eof_seen && p2p_tr_tx_pending(&tr) == 0 {
                p2p_tr_send_fin($&tr, pconn, ciph)
            }

            $dl := 10000000
            if p2p_tr_tx_pending(&tr) > 0 { dl = 2000000 }
            p2p_tr_poll_udp($&tr, pconn, ciph, dl, 32)

            rx := p2p_tr_take_rx($&tr)
            if rx.len > 0 {
                _ := net.conn_write(tcp_fd, &rx) or (err) { <- }
            }
            if tr.remote_fin && !was_remote_fin {
                was_remote_fin = true
                net_close_write_q(tcp_fd)
            }
        }
        net_close_q(tcp_fd)
    }

    p2p_log(opts, "closed", session + "", peer_id + "", "\"bytes_in\":" + strconv.itoa(tr.bytes_in) + ",\"bytes_out\":" + strconv.itoa(tr.bytes_out))
    << EXIT_OK
}

fn p2p_star_worker(
    json_mode bool,
    bus_mode bool,
    pconn_in net.PacketConn,
    ciph P2PCiphers,
    sess string,
    from_id string,
    cands []net.UDPAddr,
    rport int,
    bus_ch chan BusMsg,
    guard_ch chan StarGuardMsg
) {
    opts := CliOpts{
        json_mode: json_mode,
        config_path: "",
        api_override: "",
        timeout_sec: 30,
        pow_bits_override: 0
    }
    if bus_mode {
        p2p_star_bus_worker(opts, pconn_in, ciph, sess + "", from_id + "", cands, bus_ch, guard_ch)
        <<
    }
    p2p_star_forward_worker(opts, pconn_in, ciph, sess + "", from_id + "", cands, rport, guard_ch)
}

fn handle_incoming_p2p_offer(
    opts &CliOpts,
    sc $&SseConn,
    cfg &Config,
    priv &rsa.PrivateKey,
    friends_only bool,
    stdio_mode bool,
    star_mode bool,
    bus_mode bool,
    expose_ports &[]int,
    stun_hp string,
    include_host bool,
    bus_ch chan BusMsg,
    guard_ch chan StarGuardMsg,
    ev_data &string
) int {
    d := json.parse(ev_data)
    if !d.ok() || !d.has(d.root(), "from") || !d.has(d.root(), "frame") { << -1 }
    from_id := json_str_or(&d, d.get(d.root(), "from"), "")
    frame_json := json_encode_or(&d, d.get(d.root(), "frame"), "")

    fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, from_id + "")
    dec := decrypt_dm_frame_with_archive(cfg.home + "", cfg.agent_id + "", cfg.key_version, priv, from_id + "", &fk.pk, fk.ok, &frame_json)
    if !dec.ok || !dec.verified || dec.msg_type != "p2p_offer" { << -1 }
    now0 := time.now_time().unix()
    if dec.ts <= 0 || (now0 - dec.ts) > 60 || (dec.ts - now0) > 60 { << -1 }
    if dec.nonce.len == 0 || !check_and_record_nonce_in(cfg.home + "", "p2p_nonces.jsonl", dec.nonce + "", now0) { << -1 }

    odoc := json.parse(&dec.body_json)
    if !odoc.ok() { << -1 }
    oroot := odoc.root()
    sess := json_str_or(&odoc, odoc.get(oroot, "session"), "")
    if sess.len == 0 { << -1 }
    exp := json_int_or(&odoc, odoc.get(oroot, "expires_at"), 0)
    now := time.now_time().unix()
    if exp > 0 && now > exp { << -1 }

    mode := json_str_or(&odoc, odoc.get(oroot, "mode"), "stdio")
    proto := json_str_or(&odoc, odoc.get(oroot, "proto"), "")
    rport := json_int_or(&odoc, odoc.get(oroot, "remote_port"), 0)
    xpub_b64 := json_str_or(&odoc, odoc.get(oroot, "x25519_pub"), "")
    cands := extract_candidate_addrs(&odoc, odoc.get(oroot, "candidates"))

    $accept := true
    $reason := ""
    if proto != P2P_PROTO_V4 {
        accept = false
        reason = "unsupported_p2p_proto"
    }
    if accept && friends_only && !check_is_friend(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, from_id + "") {
        accept = false
        reason = "not_friend"
    }
    if accept && bus_mode && mode != "bus" {
        accept = false
        reason = "bus_mode_only"
    }
    if accept && !bus_mode && mode == "bus" {
        accept = false
        reason = "bus_not_enabled"
    }
    if accept && star_mode && !bus_mode && mode != "forward" {
        accept = false
        reason = "star_requires_forward_or_bus"
    }
    if accept && mode == "forward" {
        $allowed := false
        for j in 0:expose_ports.len {
            if expose_ports[j] == rport { allowed = true }
        }
        if !allowed {
            accept = false
            reason = "port_not_exposed"
        }
    }
    $got_slot := false
    if accept && star_mode {
        if !star_guard_acquire(guard_ch) {
            accept = false
            reason = "max_peers_reached"
        } else {
            got_slot = true
        }
    }
    if !accept {
        ans_rej := "{\"session\":" + json.quote(&sess) + ",\"accept\":false,\"reason\":" + json.quote(&reason) + "}"
        rej_frame := encrypt_dm_or(cfg.agent_id + "", priv, from_id + "", &fk.pk, fk.key_version, "p2p_answer", ans_rej, "open", now)
        if rej_frame.len > 0 {
            _ := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, true, "POST", "/v1/dm/" + from_id, &rej_frame, "")
        }
        << -1
    }

    $pconn := net.listen_packet("udp4", "0.0.0.0:0") or (err) {
        if got_slot { star_guard_release(guard_ch) }
        if star_mode { << -1 }
        sse_close(sc)
        << emit_err(opts, "ERR_P2P", 0, err.msg(), 0, EXIT_P2P)
    }
    lport := local_port_of(&pconn)
    srflx := stun_discover($&pconn, stun_hp + "")

    xpriv := ecdh.generate_key(ecdh.x25519()) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        if star_mode { << -1 }
        sse_close(sc)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    xpub_bytes := xpriv.public_key().bytes()
    my_xpub_b64 := base64.encode_to_string(xpub_bytes)

    peer_xpub_raw := base64.decode_string(xpub_b64 + "") or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        << -1
    }
    peer_xpub := ecdh.new_public_key(ecdh.x25519(), &peer_xpub_raw) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        << -1
    }
    shared := xpriv.ecdh(&peer_xpub) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        << -1
    }
    k_r2i := p2p_derive_dir_key("r2i", sess + "", from_id + "", cfg.agent_id + "", xpub_b64 + "", my_xpub_b64 + "", &shared)
    k_i2r := p2p_derive_dir_key("i2r", sess + "", from_id + "", cfg.agent_id + "", xpub_b64 + "", my_xpub_b64 + "", &shared)
    $ciph := make_p2p_ciphers(&k_r2i, &k_i2r) or (err) {
        pconn_close_q($&pconn)
        if got_slot { star_guard_release(guard_ch) }
        << -1
    }

    cands_json := build_candidates_json(lport, srflx, include_host)
    ans_body := "{\"session\":" + json.quote(&sess) + ",\"proto\":" + json.quote(&P2P_PROTO_V4) + ",\"accept\":true,\"candidates\":" + cands_json + ",\"x25519_pub\":" + json.quote(&my_xpub_b64) + "}"
    ans_frame := encrypt_dm_or(cfg.agent_id + "", priv, from_id + "", &fk.pk, fk.key_version, "p2p_answer", ans_body, "open", now)
    _ := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", priv, true, "POST", "/v1/dm/" + (from_id + ""), &ans_frame, "")
    p2p_log(opts, "offer_accepted", sess + "", from_id + "", "")

    if !star_mode {
        sse_close(sc)
        $target_r := 0
        if mode == "forward" && !stdio_mode {
            target_r = rport
        }
        rc := p2p_punch_and_session(opts, $&pconn, $&ciph, sess + "", from_id + "", &cands, false, stdio_mode || mode == "stdio", -1, -1, target_r)
        pconn_close_q($&pconn)
        << rc
    }

    xu p2p_star_worker(opts.json_mode, bus_mode, pconn, ciph, sess + "", from_id + "", cands, rport, bus_ch, guard_ch)
    << -1
}

pub fn cmd_p2p_listen(opts &CliOpts, args []string) int {
    norm_args := merge_repeatable_flag(&args, "expose")
    $fs := flag.new_set("p2p listen")
    fs.define_bool("allow-friends-only", true, "only accept P2P connections from friends")
    fs.define_bool("allow-anyone", false, "accept P2P connections from non-friends")
    fs.define_bool("stdio", false, "bridge P2P stream over stdin/stdout")
    fs.define_bool("star", false, "run multi-peer star hub")
    fs.define_bool("hub", false, "alias for --star")
    fs.define_bool("bus", false, "run star JSONL message bus")
    fs.define_bool("no-host-candidates", false, "omit LAN and loopback host candidates (publish STUN srflx only)")
    fs.define_int("max-peers", 32, "maximum concurrent star peers")
    fs.define_string("expose", "", "comma-separated local TCP ports to expose")
    fs.define_string("stun", "stun.cloudflare.com:3478,stun.l.google.com:19302", "comma-separated STUN servers or none")
    pr := parse_flags(opts, $&fs, norm_args, false, "usage: fatext p2p listen [--allow-friends-only|--allow-anyone] [--stdio | --star [--hub] [--bus] [--max-peers N]] [--expose PORTS] [--stun SPEC] [--no-host-candidates]")
    if pr == FLAG_HELP { << EXIT_OK }
    if pr != FLAG_OK { << EXIT_USAGE }

    if fs.is_set("allow-friends-only") && fs.is_set("allow-anyone") {
        << emit_err(opts, "ERR_USAGE", 0, "--allow-friends-only and --allow-anyone are mutually exclusive", 0, EXIT_USAGE)
    }
    $friends_only := true
    if fs.is_set("allow-anyone") {
        friends_only = !fs.get_bool("allow-anyone")
    } else if fs.is_set("allow-friends-only") {
        friends_only = fs.get_bool("allow-friends-only")
    }

    stdio_mode := fs.get_bool("stdio")
    bus_mode := fs.get_bool("bus")
    star_mode := fs.get_bool("star") || fs.get_bool("hub") || bus_mode
    has_max_peers := fs.is_set("max-peers")
    $max_peers := fs.get_int("max-peers")
    stun_hp := fs.get_string("stun")
    include_host := !fs.get_bool("no-host-candidates")
    $expose_ports := []int{}
    if fs.is_set("expose") {
        expose_csv := fs.get_string("expose")
        parts := strings.split(&expose_csv, ",")
        for j in 0:parts.len {
            tok := strings.trim_space(&parts[j])
            if tok.len == 0 { -> }
            p := strconv.atoi(&tok) or (err) {
                << emit_err(opts, "ERR_USAGE", 0, "invalid --expose port: " + tok, 0, EXIT_USAGE)
            }
            if p <= 0 || p > 65535 {
                << emit_err(opts, "ERR_USAGE", 0, "invalid --expose port: " + tok, 0, EXIT_USAGE)
            }
            expose_ports.push(p)
        }
    }
    if stdio_mode && (star_mode || bus_mode) {
        << emit_err(opts, "ERR_USAGE", 0, "--stdio cannot be combined with --star or --bus", 0, EXIT_USAGE)
    }
    if !star_mode && !has_max_peers {
        max_peers = 1
    }

    cfg := load_config(opts) or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    priv := load_private_key_checked(cfg.home + "") or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }

    guard_ch := chan StarGuardMsg{cap: 64}
    if star_mode {
        xu star_guard_loop(max_peers, guard_ch)
    }
    bus_ch := chan BusMsg{cap: 128}
    if bus_mode {
        xu star_bus_loop(cfg.agent_id + "", bus_ch)
    }

    $extra_listen := ""
    if bus_mode {
        extra_listen = "\"topology\":\"star\",\"mode\":\"bus\",\"max_peers\":" + strconv.itoa(max_peers)
    } else if star_mode {
        extra_listen = "\"topology\":\"star\",\"max_peers\":" + strconv.itoa(max_peers)
    }

    $backoff_ms := 500
    $connected_once := false
    $stop_listen := false
    while !stop_listen {
        $sc := empty_sse_conn()
        out := sse_connect_into(cfg.api_base + "", cfg.agent_id + "", &priv, "/v1/stream", $&sc)
        if !out.ok {
            if out.http_status == 401 {
                << emit_err(opts, "ERR_AUTH", 401, out.err_msg + "", 0, EXIT_AUTH)
            }
            if out.http_status == 403 {
                << emit_err(opts, "ERR_FORBIDDEN", 403, out.err_msg + "", 0, EXIT_FORBIDDEN)
            }
            if !connected_once || !star_mode {
                << emit_err(opts, "ERR_NETWORK", out.http_status, out.err_msg + "", 0, EXIT_NET)
            }
            time.sleep(jitter_ms(backoff_ms) * 1000000)
            backoff_ms = backoff_ms * 2
            if backoff_ms > 30000 { backoff_ms = 30000 }
            ->
        }
        if !connected_once {
            if bus_mode {
                xu hub_stdin_bridge(bus_ch)
            }
            p2p_log(opts, "listening", "", cfg.agent_id + "", extra_listen)
        } else {
            p2p_log(opts, "reconnected", "", cfg.agent_id + "", extra_listen)
        }
        connected_once = true
        backoff_ms = 500

        while true {
            ev := sse_read_event($&sc)
            if ev.eof { <- }
            if !ev.ok { -> }
            if ev.event_type == "system" {
                sd := json.parse(&ev.data)
                if sd.ok() && sd.is_dict(sd.root()) {
                    sk := json_str_or(&sd, sd.get(sd.root(), "kind"), "")
                    if sk == "disconnected" || sk == "key_rotated" {
                        stop_listen = true
                        <-
                    }
                }
                ->
            }
            if ev.event_type != "dm" { -> }
            rc := handle_incoming_p2p_offer(
                opts, $&sc, &cfg, &priv, friends_only, stdio_mode, star_mode, bus_mode,
                &expose_ports, stun_hp + "", include_host, bus_ch, guard_ch, &ev.data
            )
            if rc >= 0 {
                << rc
            }
        }
        sse_close($&sc)
        if !star_mode || stop_listen { <- }
        time.sleep(jitter_ms(backoff_ms) * 1000000)
        backoff_ms = backoff_ms * 2
        if backoff_ms > 30000 { backoff_ms = 30000 }
    }
    << EXIT_OK
}

pub fn cmd_p2p_connect(opts &CliOpts, args []string) int {
    $fs := flag.new_set("p2p connect")
    fs.define_string("forward", "", "TCP port forward <local_port>:<remote_port>")
    fs.define_bool("bus", false, "connect as star bus spoke")
    fs.define_bool("no-host-candidates", false, "omit LAN and loopback host candidates (publish STUN srflx only)")
    fs.define_string("stun", "stun.cloudflare.com:3478,stun.l.google.com:19302", "comma-separated STUN servers or none")
    fs.define_string("relay", "", "optional relay URL")
    pr := parse_flags(opts, $&fs, args, true, "usage: fatext p2p connect <agent_id> [--forward L:R | --bus] [--relay URL] [--stun SPEC] [--no-host-candidates]")
    if pr == FLAG_HELP { << EXIT_OK }
    if pr != FLAG_OK { << EXIT_USAGE }
    pos := fs.args()
    if pos.len != 1 {
        << emit_err(opts, "ERR_USAGE", 0, "usage: fatext p2p connect <agent_id> [--forward L:R | --bus] [--relay URL] [--stun SPEC] [--no-host-candidates]", 0, EXIT_USAGE)
    }
    peer_id := pos[0] + ""
    if !is_valid_agent_id(peer_id + "") {
        << emit_err(opts, "ERR_USAGE", 0, "invalid peer agent_id: " + peer_id, 0, EXIT_USAGE)
    }
    $lport_fwd := 0
    $rport_fwd := 0
    $forward_mode := false
    if fs.is_set("forward") {
        fwd_spec := fs.get_string("forward")
        ps := strings.split(&fwd_spec, ":")
        if ps.len != 2 {
            << emit_err(opts, "ERR_USAGE", 0, "--forward requires <local_port>:<remote_port>", 0, EXIT_USAGE)
        }
        lp := strconv.atoi(&ps[0]) or (err) {
            << emit_err(opts, "ERR_USAGE", 0, "invalid --forward ports", 0, EXIT_USAGE)
        }
        rp := strconv.atoi(&ps[1]) or (err) {
            << emit_err(opts, "ERR_USAGE", 0, "invalid --forward ports", 0, EXIT_USAGE)
        }
        if lp <= 0 || lp > 65535 || rp <= 0 || rp > 65535 {
            << emit_err(opts, "ERR_USAGE", 0, "invalid --forward ports", 0, EXIT_USAGE)
        }
        lport_fwd = lp
        rport_fwd = rp
        forward_mode = true
    }
    bus_mode := fs.get_bool("bus")
    include_host := !fs.get_bool("no-host-candidates")
    stun_hp := fs.get_string("stun")
    relay_url := fs.get_string("relay")
    if relay_url.len > 0 {
        << emit_err(opts, "ERR_USAGE", 0, "--relay is not supported yet", 0, EXIT_USAGE)
    }
    if forward_mode && bus_mode {
        << emit_err(opts, "ERR_USAGE", 0, "--forward and --bus are mutually exclusive", 0, EXIT_USAGE)
    }

    cfg := load_config(opts) or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    priv := load_private_key_checked(cfg.home + "") or (err) {
        << emit_err(opts, "ERR_CONFIG", 0, err.msg(), 0, EXIT_CONFIG)
    }
    fk := fetch_agent_key(cfg.api_base + "", opts.timeout_sec, peer_id + "")
    if !fk.ok {
        << emit_err(opts, fk.err_code + "", 0, fk.err_msg + "", 0, fk.exit_code)
    }

    $sc := sse_connect(cfg.api_base + "", cfg.agent_id + "", &priv, "/v1/stream") or (err) {
        << emit_err(opts, "ERR_NETWORK", 0, err.msg(), 0, EXIT_NET)
    }
    $pconn := net.listen_packet("udp4", "0.0.0.0:0") or (err) {
        sse_close($&sc)
        << emit_err(opts, "ERR_P2P", 0, err.msg(), 0, EXIT_P2P)
    }
    lport := local_port_of(&pconn)
    srflx := stun_discover($&pconn, stun_hp + "")

    xpriv := ecdh.generate_key(ecdh.x25519()) or (err) {
        pconn_close_q($&pconn)
        sse_close($&sc)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    xpub_b64 := base64.encode_to_string(xpriv.public_key().bytes())
    sess := generate_session_id() or (err) {
        pconn_close_q($&pconn)
        sse_close($&sc)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    now := time.now_time().unix()
    $mode_s := "stdio"
    if forward_mode { mode_s = "forward" }
    else if bus_mode { mode_s = "bus" }
    cands_json := build_candidates_json(lport, srflx, include_host)
    offer_body := "{\"session\":" + json.quote(&sess) +
        ",\"proto\":" + json.quote(&P2P_PROTO_V4) +
        ",\"candidates\":" + cands_json +
        ",\"x25519_pub\":" + json.quote(&xpub_b64) +
        ",\"mode\":" + json.quote(&mode_s) +
        ",\"remote_port\":" + strconv.itoa(rport_fwd) +
        ",\"relay\":false,\"expires_at\":" + strconv.itoa(now + 60) + "}"

    offer_frame := encrypt_dm_frame(cfg.agent_id + "", &priv, peer_id + "", &fk.pk, fk.key_version, "p2p_offer", offer_body, "open", now) or (err) {
        pconn_close_q($&pconn)
        sse_close($&sc)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    dm_r := api_call(cfg.api_base + "", opts.timeout_sec, cfg.agent_id + "", &priv, true, "POST", "/v1/dm/" + (peer_id + ""), &offer_frame, "")
    if !dm_r.ok {
        pconn_close_q($&pconn)
        sse_close($&sc)
        << emit_err(opts, dm_r.err_code + "", dm_r.status, dm_r.err_msg + "", dm_r.retry_after, map_http_exit_code(dm_r.status, dm_r.err_code + ""))
    }
    p2p_log(opts, "offer_sent", sess + "", peer_id + "", "")

    // Wait for matching p2p_answer over SSE
    $peer_cands := []net.UDPAddr{}
    $peer_xpub_b64 := ""
    $got_answer := false
    deadline := time.now_time().unix() + 75
    while time.now_time().unix() < deadline {
        ev := sse_read_event($&sc)
        if ev.eof { <- }
        if !ev.ok || ev.event_type != "dm" { -> }
        d := json.parse(&ev.data)
        if !d.ok() || !d.has(d.root(), "from") || !d.has(d.root(), "frame") { -> }
        from_id := json_str_or(&d, d.get(d.root(), "from"), "")
        if from_id != peer_id { -> }
        frame_json := json_encode_or(&d, d.get(d.root(), "frame"), "")
        dec := decrypt_dm_frame_with_archive(cfg.home + "", cfg.agent_id + "", cfg.key_version, &priv, peer_id + "", &fk.pk, true, &frame_json)
        if !dec.ok || !dec.verified || dec.msg_type != "p2p_answer" { -> }
        now_a := time.now_time().unix()
        if dec.ts <= 0 || (now_a - dec.ts) > 60 || (dec.ts - now_a) > 60 { -> }
        if dec.nonce.len == 0 || !check_and_record_nonce_in(cfg.home + "", "p2p_nonces.jsonl", dec.nonce + "", now_a) { -> }
        ad := json.parse(&dec.body_json)
        if !ad.ok() { -> }
        ar := ad.root()
        if json_str_or(&ad, ad.get(ar, "session"), "") != sess { -> }
        acc := json_bool_or(&ad, ad.get(ar, "accept"), false)
        if !acc {
            rsn := json_str_or(&ad, ad.get(ar, "reason"), "rejected")
            pconn_close_q($&pconn)
            sse_close($&sc)
            << emit_err(opts, "ERR_P2P_REJECTED", 0, "peer rejected offer: " + rsn, 0, EXIT_P2P)
        }
        if json_str_or(&ad, ad.get(ar, "proto"), "") != P2P_PROTO_V4 {
            pconn_close_q($&pconn)
            sse_close($&sc)
            << emit_err(opts, "ERR_P2P", 0, "unsupported peer p2p protocol", 0, EXIT_P2P)
        }
        peer_cands = extract_candidate_addrs(&ad, ad.get(ar, "candidates"))
        peer_xpub_b64 = json_str_or(&ad, ad.get(ar, "x25519_pub"), "")
        got_answer = true
        <-
    }
    sse_close($&sc)
    if !got_answer || peer_cands.len == 0 || peer_xpub_b64.len == 0 {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_P2P", 0, "no valid p2p_answer received", 0, EXIT_P2P)
    }

    px_raw := base64.decode_string(peer_xpub_b64 + "") or (err) {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_CRYPTO", 0, "invalid peer x25519 key", 0, EXIT_CRYPTO)
    }
    px := ecdh.new_public_key(ecdh.x25519(), &px_raw) or (err) {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_CRYPTO", 0, "invalid peer x25519 key", 0, EXIT_CRYPTO)
    }
    shared := xpriv.ecdh(&px) or (err) {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }
    k_i2r := p2p_derive_dir_key("i2r", sess + "", cfg.agent_id + "", peer_id + "", xpub_b64 + "", peer_xpub_b64 + "", &shared)
    k_r2i := p2p_derive_dir_key("r2i", sess + "", cfg.agent_id + "", peer_id + "", xpub_b64 + "", peer_xpub_b64 + "", &shared)
    $ciph := make_p2p_ciphers(&k_i2r, &k_r2i) or (err) {
        pconn_close_q($&pconn)
        << emit_err(opts, "ERR_CRYPTO", 0, err.msg(), 0, EXIT_CRYPTO)
    }

    if bus_mode {
        rc := p2p_bus_client_session(opts, $&pconn, $&ciph, sess + "", peer_id + "", cfg.agent_id + "", &peer_cands)
        pconn_close_q($&pconn)
        << rc
    }

    $lfd := -1
    if forward_mode {
        lfd = net.listen("127.0.0.1:" + strconv.itoa(lport_fwd)) or (err) {
            pconn_close_q($&pconn)
            << emit_err(opts, "ERR_P2P", 0, err.msg(), 0, EXIT_P2P)
        }
    }
    rc := p2p_punch_and_session(opts, $&pconn, $&ciph, sess + "", peer_id + "", &peer_cands, true, !forward_mode, -1, lfd, 0)
    net_close_q(lfd)
    pconn_close_q($&pconn)
    << rc
}
